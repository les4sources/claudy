section.rounded-xl.border.border-stone-200.bg-white.shadow-sm.overflow-hidden
  .px-5.py-4.border-b.border-stone-100.bg-stone-50
    h2.text-lg.font-semibold.text-stone-900 = title
    .mt-0.5.text-sm.text-stone-500
      = "Revenus des réservations confirmées de #{year}, par mois et par hébergement."

  - if empty?
    .px-5.py-10.text-center.text-sm.text-stone-500
      | Aucun revenu d'hébergement enregistré pour cette année.

  - else
    .px-5.py-5
      .overflow-x-auto
        svg role="img" aria-label=description viewBox="0 0 #{width} #{height}" preserveAspectRatio="xMinYMin meet" style="min-width: #{width}px; width: 100%; height: auto;"
          title = title
          desc = description
          - grid_lines.each do |graduation|
            line x1=axis_width y1=graduation[:y] x2=width y2=graduation[:y] stroke="#e7e5e4" stroke-width="1"
            text x=(axis_width - 8) y=(graduation[:y] + 4) text-anchor="end" font-size="11" fill="#78716c"
              = graduation[:label]
          - columns.each do |column|
            - column[:segments].each do |segment|
              rect x=segment[:x] y=segment[:y] width=segment[:width] height=segment[:height] fill=segment[:color]
                title = segment[:label]
            text x=(column[:x] + (column_width / 2)) y=(baseline + 16) text-anchor="middle" font-size="11" fill="#57534e"
              = column[:letter]

      ul.mt-5.grid.max-w-4xl.grid-cols-1.gap-x-8.gap-y-2.text-sm.sm:grid-cols-2
        - legend_rows.each do |row|
          li.flex.items-center.gap-2
            span.inline-block.h-3.w-3.shrink-0.rounded-sm style="background-color: #{row[:color]};"
            span.font-medium.text-stone-800 = row[:label]
            span.ml-auto.tabular-nums.text-stone-600 = row[:amount]
            span.w-14.text-right.tabular-nums.text-stone-400 = row[:share]
