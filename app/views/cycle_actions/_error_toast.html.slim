div[class="archive-toast pointer-events-auto inline-flex items-center gap-3 rounded-full bg-rose-700 text-white pl-4 pr-2 py-2 shadow-xl ring-1 ring-white/10"
    data-controller="undo-toast"
    data-undo-toast-duration-value="7000"]
  span.text-sm = message
  - if message.include?("cycle suivant")
    = link_to "Créer un cycle", new_cycle_path, class: "inline-flex items-center rounded-full bg-white/15 hover:bg-white/25 px-3 py-1 text-xs font-medium text-white transition-colors"
  button[type="button" data-action="click->undo-toast#dismiss" class="text-white/60 hover:text-white px-1" aria-label="Fermer"]
    svg.w-3.h-3 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
      line x1="18" y1="6" x2="6" y2="18"
      line x1="6" y1="6" x2="18" y2="18"
