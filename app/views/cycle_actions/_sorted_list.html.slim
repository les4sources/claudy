- readonly = local_assigns[:readonly]
- next_cycle = local_assigns.key?(:next_cycle) ? local_assigns[:next_cycle] : nil
div[id="category_#{category}_list"
    class="cycle-action-list divide-y divide-gray-50 bg-white min-h-[3rem]"
    data-controller=(readonly ? nil : "cycle-action-sortable")
    data-cycle-action-sortable-url-value=reorder_cycle_actions_path
    data-cycle-action-sortable-category-value=category.to_s
    data-cycle-action-sortable-human-id-value=local_assigns[:human]&.id]
  - actions.each do |action|
    - opts = { cycle_action: action, readonly: readonly }
    - opts[:next_cycle] = next_cycle if local_assigns.key?(:next_cycle)
    = render "cycle_actions/cycle_action", **opts
  - if actions.empty?
    .py-6.px-4.text-center.pointer-events-none
      span.text-xs.text-gray-300 = readonly ? "Rien dans cette catégorie" : "Glisser une action ici"
