- readonly = local_assigns[:readonly]
- decorated = cycle_action.decorate
- next_cycle = local_assigns.key?(:next_cycle) ? local_assigns[:next_cycle] : cycle_action.cycle.next_cycle

/ ACTIVITÉ ÉCONOMIQUE (epic #330, phase 1) : bordure or nettement visible, pour
  qu'on repère d'un coup d'œil, dans une liste dense, ce qui rapporte au lieu de
  consommer le budget d'heures du cycle.
- economic_ring = cycle_action.economic? ? "ring-1 ring-amber-400 bg-amber-50/50 rounded-lg" : ""

div[id="cycle_action_#{cycle_action.id}"
    class="cycle-action-row relative flex items-end gap-2 py-2.5 pl-2 pr-4 group hover:bg-gray-50/80 transition-colors duration-150 #{economic_ring} #{local_assigns[:highlight] ? 'animate-flash-highlight' : ''}"
    data-cycle-action-sortable-target=(readonly ? nil : "item")
    data-id=cycle_action.id
    data-hours=(cycle_action.hours.to_f)
    data-actual-hours=(cycle_action.actual_hours.to_f)
    data-economic=cycle_action.economic.to_s
    data-completed=cycle_action.completed.to_s
    data-category=cycle_action.category]

  / Drag handle
  - if readonly
    .flex-shrink-0.w-5.-ml-1.mr-1
  - else
    button[type="button"
           tabindex="-1"
           data-drag-handle=""
           aria-label="Réorganiser"
           class="flex-shrink-0 self-stretch flex items-center justify-center w-5 -ml-1 mr-1 text-gray-300 hover:text-gray-500 opacity-0 group-hover:opacity-100 transition-opacity cursor-grab active:cursor-grabbing"]
      svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"
        circle cx="5" cy="3" r="1.25"
        circle cx="5" cy="8" r="1.25"
        circle cx="5" cy="13" r="1.25"
        circle cx="11" cy="3" r="1.25"
        circle cx="11" cy="8" r="1.25"
        circle cx="11" cy="13" r="1.25"

  / Completed checkbox — remplacée par les pastilles quand l'action se répète
    dans le cycle (issue #338).
  - if cycle_action.multiple?
    = render "cycle_actions/occurrence_marks", cycle_action: cycle_action, readonly: readonly
  - elsif readonly
    - if cycle_action.completed?
      .w-5.h-5.rounded.bg-teal-500.flex.items-center.justify-center.flex-shrink-0
        svg.w-3.h-3.text-white xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
          polyline points="20 6 9 17 4 12"
    - else
      .w-5.h-5.rounded.border-2.border-gray-200.flex-shrink-0
  - else
    = button_to toggle_completed_cycle_action_path(cycle_action),
                method: :patch,
                data: { turbo_stream: true },
                class: "flex-shrink-0" do
      - if cycle_action.completed?
        .w-5.h-5.rounded.bg-teal-500.flex.items-center.justify-center.transition-all.duration-200
          svg.w-3.h-3.text-white xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
            polyline points="20 6 9 17 4 12"
      - else
        .w-5.h-5.rounded.border-2.border-gray-300.hover:border-teal-400.transition-colors.duration-200.cursor-pointer

  / Label
  .flex-1.min-w-0.flex.items-baseline.gap-2
    span.text-sm class=(cycle_action.completed? ? "line-through text-gray-400" : "text-gray-800")
      = cycle_action.label
    - if cycle_action.deferred_before?
      span.deferral-badge title="Reportée #{cycle_action.deferral_count} fois"
        | ⟳ ×#{cycle_action.deferral_count}
    /  PÔLE (epic #330, phase 5) : discret, pour situer l'action sans voler la
       vedette au libellé. Aucun pôle lié (le cas courant) : rien du tout.
    - if cycle_action.team
      span.team-badge title="Pôle : #{cycle_action.team.name}"
        = cycle_action.team.name

  /  HEURES RÉELLES (epic #330, phase 2) : le réel se compte au clic, à gauche
     de l'estimé. Une pastille teal le distingue de l'estimé, resté gris. Tant
     qu'aucune heure réelle n'est notée, la ligne est exactement celle d'avant.
  - unless readonly
    .flex.items-center.gap-0.5.flex-shrink-0
      - if cycle_action.actual_hours_recorded?
        = button_to remove_actual_hour_cycle_action_path(cycle_action),
                    method: :patch,
                    data: { turbo_stream: true },
                    class: "flex-shrink-0",
                    title: "Retirer une heure réelle" do
          span class="block rounded-md px-1.5 py-1 text-xs font-medium leading-none text-gray-400 hover:text-teal-700 hover:bg-teal-50 cursor-pointer"
            | − h
      = button_to add_actual_hour_cycle_action_path(cycle_action),
                  method: :patch,
                  data: { turbo_stream: true },
                  class: "flex-shrink-0",
                  title: "Ajouter une heure réelle" do
        span class="block rounded-md px-1.5 py-1 text-xs font-medium leading-none text-gray-400 hover:text-teal-700 hover:bg-teal-50 cursor-pointer"
          | + h

  / Hours — le réel (pastille teal) devant l'estimé, qui garde son détail
    « 3 × 11h » quand l'action se répète. Sans heure réelle notée, la ligne est
    exactement celle d'avant.
  - if cycle_action.actual_hours_recorded? || decorated.hours_total
    div class="flex items-baseline gap-1.5 flex-shrink-0"
      - if cycle_action.actual_hours_recorded?
        span class="inline-flex items-center gap-1 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-semibold text-teal-700 tabular-nums" title="Heures réellement passées"
          = "#{format('%g', cycle_action.actual_hours.to_f)}h réel"
      - if decorated.hours_detail
        span.text-xs.text-gray-400.tabular-nums = decorated.hours_detail
      - if decorated.hours_total
        span.text-sm.font-medium.text-gray-400.tabular-nums title="Heures estimées"
          = cycle_action.actual_hours_recorded? ? "#{decorated.hours_total} estimé" : decorated.hours_total

  / Action icons
  - unless readonly
    .flex.items-center.gap-0.5.flex-shrink-0
      /  Bascule ACTIVITÉ ÉCONOMIQUE, en première position du groupe (epic #330,
         phase 1). Visible sur toute action non archivée : une prestation peut
         se révéler économique après coup, y compris une fois faite.
      = button_to toggle_economic_cycle_action_path(cycle_action),
                  method: :patch,
                  data: { turbo_stream: true },
                  class: "p-1.5 rounded-md transition-colors #{cycle_action.economic? ? 'text-amber-600 bg-amber-100 hover:bg-amber-200' : 'text-gray-400 hover:text-amber-600 hover:bg-amber-50'}",
                  title: (cycle_action.economic? ? "Retirer le mode activité économique" : "Marquer comme activité économique (hors budget d'heures)") do
        svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
          path d="M12 2v20"

      /  COPIER AU CYCLE SUIVANT (epic #330, phase 4), juste avant la flèche :
         la flèche DÉPLACE, cette icône DUPLIQUE — l'action reste ici. Proposée
         aussi sur une action faite (une action qui revient, justement). Tant
         qu'une copie vivante existe, l'icône est pleine et teintée, et un second
         clic retire la copie (décision 6).
      - copy = cycle_action.copy_in_next_cycle
      - if copy
        = button_to copy_next_cycle_action_path(cycle_action),
                    method: :patch,
                    data: { turbo_stream: true },
                    class: "p-1.5 rounded-md text-sky-700 bg-sky-100 hover:bg-sky-200 transition-colors",
                    title: "Retirer la copie du cycle suivant (#{copy.cycle.name})" do
          svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            rect x="9" y="9" width="12" height="12" rx="2" ry="2"
            path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" fill="none"
      - elsif next_cycle
        = button_to copy_next_cycle_action_path(cycle_action),
                    method: :patch,
                    data: { turbo_stream: true },
                    class: "p-1.5 rounded-md text-gray-400 hover:text-sky-700 hover:bg-sky-50 transition-colors",
                    title: "Copier au cycle suivant (#{next_cycle.name})" do
          svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            rect x="9" y="9" width="12" height="12" rx="2" ry="2"
            path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
      - else
        = link_to new_cycle_path,
                  class: "p-1.5 rounded-md text-gray-300 hover:text-amber-600 hover:bg-amber-50 transition-colors",
                  title: "Aucun cycle suivant configuré — créer un cycle" do
          svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2 2"
            rect x="9" y="9" width="12" height="12" rx="2" ry="2"
            path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"

      - unless cycle_action.completed?
        - if next_cycle
          = button_to defer_next_cycle_action_path(cycle_action),
                      method: :patch,
                      data: { turbo_stream: true },
                      class: "p-1.5 rounded-md text-gray-400 hover:text-sky-700 hover:bg-sky-50 transition-colors",
                      title: "Passer au cycle suivant (#{next_cycle.name})" do
            svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              path d="M5 12h14"
              path d="m12 5 7 7-7 7"
              path d="M3 5v14"
        - else
          = link_to new_cycle_path,
                    class: "p-1.5 rounded-md text-gray-300 hover:text-amber-600 hover:bg-amber-50 transition-colors",
                    title: "Aucun cycle suivant configuré — créer un cycle" do
            svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2 2"
              path d="M5 12h14"
              path d="m12 5 7 7-7 7"
              path d="M3 5v14"

        - unless cycle_action.reportee?
          = button_to defer_cycle_action_path(cycle_action),
                      method: :patch,
                      data: { turbo_stream: true },
                      class: "p-1.5 rounded-md text-gray-400 hover:text-amber-600 hover:bg-amber-50 transition-colors",
                      title: "Mettre en attente (catégorie reportée)" do
            svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              polyline points="13 17 18 12 13 7"
              polyline points="6 17 11 12 6 7"

      = link_to edit_cycle_action_path(cycle_action),
                data: { turbo_stream: true },
                class: "p-1.5 rounded-md text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-colors",
                title: "Modifier" do
        svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"
          path d="m15 5 4 4"

      = button_to archive_cycle_action_path(cycle_action),
                  method: :patch,
                  data: { turbo_stream: true },
                  class: "p-1.5 rounded-md text-gray-400 hover:text-teal-700 hover:bg-teal-50 transition-colors",
                  title: (cycle_action.completed? ? "Archiver (faite)" : "Archiver sans la faire") do
        svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          path d="M21 8v13H3V8"
          path d="M1 3h22v5H1z"
          line x1="10" y1="12" x2="14" y2="12"

      = button_to cycle_action_path(cycle_action),
                  method: :delete,
                  data: { turbo_stream: true, turbo_confirm: "Supprimer cette action ?" },
                  class: "p-1.5 rounded-md text-gray-400 hover:text-red-600 hover:bg-red-50 transition-colors",
                  title: "Supprimer" do
        svg.w-3.5.h-3.5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          path d="M3 6h18"
          path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"
          path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"
