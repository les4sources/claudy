- content_for :title do
  | Relevé d'activités #{@human.name} — #{@statement.period_label}

.mb-6.flex.items-start.justify-between
  div
    h1.text-2xl.font-semibold.text-gray-900
      | Relevé d'activités — #{@statement.period_label}
    p.text-sm.text-gray-500
      = @human.name
      span.mx-1 ·
      = "référence #{@statement.reference}"
  button.text-sm.text-gray-500.underline(class="print:hidden" type="button" onclick="window.print()")
    | Imprimer

.mb-6.p-4.rounded-lg.bg-gray-50
  table.w-full.text-sm
    tbody
      tr
        td.py-2.font-semibold.text-gray-900 Total à verser
        td.py-2.text-right.text-xl.font-semibold.text-gray-900= number_to_currency(@statement.total_fee_cents / 100.0)

- if @lines.any?
  h2.text-sm.uppercase.tracking-wide.text-gray-400.mb-2 Le détail
  table.w-full.text-sm.mb-6
    tbody
      - @lines.each do |line|
        tr.border-b.border-gray-100
          td.py-1.5.text-gray-500.whitespace-nowrap
            - if line.occurred_on
              = l(line.occurred_on, format: :short)
          td.py-1.5.text-gray-800= line.display_label
          td.py-1.5.text-right.whitespace-nowrap.text-gray-900= number_to_currency(line.fee_cents / 100.0)

p.text-sm.text-gray-500
  - if @statement.paid?
    | Ce relevé a été payé#{@statement.paid_on ? " le #{l(@statement.paid_on, format: :long)}" : ""}.
  - else
    | Le virement partira avec la prochaine série de paiements, avec la communication
    strong = " #{@statement.reference}"
    | .
