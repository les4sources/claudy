/ Récapitulatif lecture seule — étape Coordonnées, la DERNIÈRE chose que le
/ client relit avant d'envoyer sa demande.
/
/ Refait le 2026-10-03 (Michael : « le devis est mieux fait que le détail de
/ l'étape 3 », surtout pour la location d'espace en forfait week-end) :
/   1. une ligne du temps (FunnelTimelineHelper) montre la réservation d'un
/      coup d'œil — le gîte du soir d'arrivée au matin du départ, chaque salle
/      sur sa journée ou sa soirée, le camping nuit par nuit ;
/   2. le détail reprend MOT POUR MOT les lignes du devis (`quote.lines`) : un
/      seul libellé par prestation dans tout le funnel, forfaits compris ;
/   3. ce qui n'a pas de prix (bûches, activités souhaitées, nom du groupe)
/      vient ensuite, en clair.
- timeline = reservation_timeline(draft)
- eur = ->(cents) { number_to_currency(cents / 100.0, unit: "€", format: "%n %u", precision: 2) }
- adults = draft.adults.to_i
- children = draft.children.to_i
- occupants = [("#{adults} adulte#{"s" if adults > 1}" if adults.positive?), ("#{children} enfant#{"s" if children > 1}" if children.positive?)].compact.join(" · ")

- lodging_names = Lodging.where(id: Array(draft.lodging_night_ids).compact_blank.uniq).pluck(:name)
- lodging_names << draft.lodging.name if lodging_names.empty? && draft.lodging
- firewood_lodgings = lodging_names.uniq.select { |name| Pricing::Catalog.firewood_included?(name) }
- extras = []
- extras << ["Inclus", "#{Pricing::Catalog::FIREWOOD_NOTICE} (#{firewood_lodgings.to_sentence})"] if firewood_lodgings.any?
- extras << ["Activités souhaitées", draft.activities_note] if draft.activities_note.present?
- extras << ["Nom du groupe", draft.group_name] if draft.group_name.present?

.funnel-recap.rounded-xl.border.border-bark.bg-forest-tint.p-4.sm:p-5
  .flex.items-center.justify-between.gap-4
    h3.text-lg.font-semibold.text-forest Votre réservation
    = link_to "Modifier", public_reservation_compose_path, class: "text-sm text-forest hover:underline"
  - if draft.arrival_date && draft.departure_date
    p.mt-1.text-base.text-ink
      = stay_dates_label(draft.arrival_date, draft.departure_date)
      span.text-moss = " · #{draft.nights} nuit#{"s" if draft.nights.to_i > 1}"
      - if occupants.present?
        span.text-moss = " · #{occupants}"

  / ── Ligne du temps ────────────────────────────────────────
  - if timeline
    - days_count = timeline.days.size
    .stay-timeline.mt-4(style="--tl-days: #{days_count}" aria-label="Ligne du temps de la réservation")
      .stay-timeline__scroll
        .stay-timeline__row.stay-timeline__row--head(aria-hidden="true")
          .stay-timeline__label
          .stay-timeline__track
            - timeline.days.each_with_index do |day, i|
              .stay-timeline__day(style="grid-column: #{2 * i + 1} / span 2")
                span.stay-timeline__day-name = l(day, format: "%a %-d %b").capitalize
                - if i.zero?
                  span.stay-timeline__day-tag Arrivée
                - elsif i == days_count - 1
                  span.stay-timeline__day-tag Départ
        - timeline.rows.each do |row|
          .stay-timeline__row
            .stay-timeline__label = row.label
            ul.stay-timeline__track
              - row.segments.each do |segment|
                li.stay-timeline__bar(class="stay-timeline__bar--#{row.kind}" style="grid-column: #{segment.from} / #{segment.to}" title=segment.text)
                  - if segment.icons.empty?
                    span = segment.text
                  - else
                    span.stay-timeline__text--long = segment.text
                    span.stay-timeline__text--short(aria-hidden="true")
                      - segment.icons.each do |icon|
                        = funnel_icon icon, css_class: "w-4 h-4"
      - if timeline.rows.any? { |row| row.kind == "space" }
        p.stay-timeline__legend.mt-2.text-sm.text-moss(aria-hidden="true")
          = funnel_icon :sun, css_class: "w-4 h-4"
          span journée
          = funnel_icon :moon, css_class: "w-4 h-4 ml-3"
          span soirée

  / ── Détail : les lignes du devis, telles quelles ─────────────
  - if quote && quote.lines.any?
    ul.funnel-recap__lines.mt-5.divide-y.divide-bark.border-t.border-bark
      - quote.lines.each do |line|
        li.flex.items-baseline.justify-between.gap-4.py-2.5
          span.text-base.text-ink = line.label
          span.text-base.font-semibold.text-ink.flex-shrink-0.tabular-nums.whitespace-nowrap = eur.(line.amount_cents)
    .mt-1.pt-3.border-t-2.border-forest.flex.items-baseline.justify-between.gap-4
      span.text-base.font-semibold.text-forest Total TVAC
      span.text-xl.font-bold.text-forest.tabular-nums.whitespace-nowrap = eur.(quote.total_cents)
    .flex.items-baseline.justify-between.gap-4.mt-1
      span.text-sm.text-moss = "Acompte #{(quote.deposit_rate * 100).to_i} % à la confirmation"
      span.text-sm.font-semibold.text-moss.tabular-nums.whitespace-nowrap = eur.(quote.deposit_cents)

  - if extras.any?
    dl.mt-4.pt-4.border-t.border-bark.space-y-2
      - extras.each do |label, value|
        .flex.flex-col.sm:flex-row.sm:items-start.sm:gap-3
          dt.text-sm.text-forest.sm:w-40.shrink-0.sm:pt-0.5 = label
          dd.text-base.text-ink = value
