/ Cartes des gîtes — étape 2 du funnel, au-dessus de la grille nuit par nuit.
/
/ On choisissait jusqu'ici entre trois NOMS dans une colonne de tableau. Le
/ client ne savait ni à quoi ressemblait un gîte, ni combien de personnes il
/ loge — alors que c'est la décision la plus engageante du parcours. Ces cartes
/ mettent la photo, la capacité et le prix devant lui AVANT qu'il choisisse ses
/ nuits ; la grille en dessous reste l'outil de sélection.
/
/ Dépend de : @lodgings (instance var du controller).
- cards = @lodgings.select { |l| lodging_has_photos?(l.name) }

- if cards.any?
  section.mb-6(data-controller="public--gallery")
    h2.funnel-section-title.mb-3 Nos gîtes

    .grid.grid-cols-1.sm:grid-cols-3.gap-4
      - cards.each do |lodging|
        / « dès X €/nuit » = la nuit en SEMAINE du site (epic #260, décision 4).
        - from_night = Pricing::Catalog.lodging_from_night_cents(lodging.name)
        - rooms = lodging.bedrooms_count
        - shots = lodging_gallery(lodging.name).size
        / Disponibilité aux dates choisies, lue dans @lodging_availability (déjà
        / calculé pour la grille). Dit d'emblée qu'un gîte est pris, au lieu de
        / le laisser découvrir case par case.
        - nights_avail = Array(@lodging_availability&.dig(lodging.id))
        - free_nights = nights_avail.count { |v| v != false }
        button(
          type="button"
          data-action="public--gallery#open"
          data-gallery-lodging=lodging.name
          data-gallery-url=public_reservation_lodging_photos_path(slug: LodgingPhotosHelper::COVER_SLUGS[lodging.name])
          data-gallery-count="#{shots} photo#{'s' if shots > 1}"
          aria-haspopup="dialog"
          class="funnel-lodging-card group text-left")

          .funnel-lodging-card__media
            = vite_image_tag lodging_cover_path(lodging.name),
                alt: "",
                loading: "lazy",
                decoding: "async",
                class: "funnel-lodging-card__img"
            span.funnel-lodging-card__count
              = funnel_icon :sparkles, css_class: "w-4 h-4"
              = "#{shots} photos"

          .funnel-lodging-card__body
            h3.funnel-section-title = lodging.name
            - if lodging.summary.present? || rooms.positive?
              p.funnel-hint.mt-1
                = [lodging.summary.presence, ("#{rooms} chambre#{'s' if rooms > 1}" if rooms.positive?)].compact.join(" · ")
            - if from_night
              p.text-base.font-semibold.text-forest.mt-2
                = "dès #{number_to_currency(from_night / 100.0, unit: '€', format: '%n %u', precision: 0)}/nuit"
            / Brouette de bûches (epic #260, décision 6) : incluse d'office à La
            / Chevêche et au Grand-Duc. La Hulotte n'a pas de poêle — rien à dire.
            / Information, jamais une ligne de prix.
            - if Pricing::Catalog.firewood_included?(lodging.name)
              p.funnel-hint.mt-1.flex.items-center.gap-1.5
                = funnel_icon :flame, css_class: "w-4 h-4 text-ember flex-shrink-0"
                span = Pricing::Catalog::FIREWOOD_NOTICE
            - unless nights_avail.empty?
              - if free_nights.zero?
                p.funnel-avail-badge.funnel-avail-badge--off Complet à vos dates
              - elsif free_nights < nights_avail.size
                p.funnel-avail-badge.funnel-avail-badge--partial = "Libre #{free_nights} nuit#{'s' if free_nights > 1} sur #{nights_avail.size}"
              - else
                p.funnel-avail-badge Libre à vos dates

    / Modale galerie — un seul turbo-frame, rempli à la demande.
    = render "public/reservations/gallery_modal"
