/ Étape 3/4 — Activités
- content_for :meta_title, "Vos activités"
.min-h-screen.funnel-page
  .max-w-3xl.mx-auto.px-4.pt-10.pb-28

    / ── Step indicator ───────────────────────────────────────
    = render "public/reservations/step_indicator", current: 3

    / ── Titre ────────────────────────────────────────────────
    .mb-8
      h1.text-2xl.font-bold.text-ink Des activités pendant votre séjour ?
      p.text-sm.text-moss.mt-1
        | Choisissez un créneau dans les dates de votre séjour. Notre équipe confirmera
        | les disponibilités avec les animateurs·ices — les activités ne sont pas comprises
        | dans l'acompte.

    / ── Résumé dates ─────────────────────────────────────────
    - if @draft.arrival_date && @draft.departure_date
      .flex.items-center.gap-2.mb-6.text-sm.text-moss.bg-white.rounded-xl.px-4.py-3.border.border-bark.shadow-sm.w-fit
        = funnel_icon :calendar, css_class: "w-4 h-4 text-ember flex-shrink-0"
        strong = l(@draft.arrival_date, format: :long)
        span.text-moss →
        strong = l(@draft.departure_date, format: :long)
        = link_to "Modifier", public_reservation_compose_path, class: "ml-2 text-xs text-moss hover:text-moss underline"

    - if @availabilities.empty?
      / ── Aucun créneau dans la fenêtre — étape franchissable ──
      .rounded-2xl.border.border-bark.bg-white.p-8.text-center
        p.text-moss Aucune activité n'est programmée sur vos dates pour le moment.
        p.text-sm.text-moss.mt-2
          | Pas d'inquiétude : nous vous enverrons un lien pour choisir vos activités
          | avant votre arrivée.
      .mt-6.flex.justify-end
        = link_to "Continuer vers mes coordonnées →", public_reservation_contact_path,
            class: "rounded-lg bg-forest text-white px-6 py-3 text-sm font-medium hover:bg-forest-soft"

    - else
      = form_with url: public_reservation_advance_activities_path, method: :post do |f|
        - idx = 0
        - @availabilities.group_by(&:experience).each do |experience, slots|
          .rounded-2xl.border.border-bark.bg-white.shadow-sm.p-5.mb-4
            .mb-3
              h2.text-base.font-semibold.text-ink = experience.name
              - if experience.summary.present?
                p.text-sm.text-moss = experience.summary
              .text-sm.text-forest.mt-1 = Pricing::ExperienceLine.rate_label(experience)

            .space-y-2
              - slots.each do |av|
                - selected_entry = @draft.experiences.find { |e| e[:availability_id].to_s == av.id.to_s }
                - selected_participants = selected_entry&.dig(:participants).to_i
                label.flex.items-center.gap-3.rounded-lg.border.border-bark.p-3
                  input(
                    type="number"
                    name="reservation[experiences][#{idx}][participants]"
                    value="#{selected_participants > 0 ? selected_participants : ''}"
                    min="#{experience.min_participants.presence || 1}"
                    max="#{av.effective_max_participants || ''}"
                    placeholder="0"
                    class="w-20 rounded border-bark text-center shrink-0"
                  )
                  = hidden_field_tag "reservation[experiences][#{idx}][id]", av.experience_id
                  = hidden_field_tag "reservation[experiences][#{idx}][availability_id]", av.id
                  div.flex-1
                    .text-sm.font-medium.text-ink
                      = l(av.available_on, format: :long).capitalize
                    .text-sm.text-moss
                      span.font-medium = av.starts_at
                      - if av.ends_at
                        | → #{av.ends_at}
                      - if av.effective_max_participants
                        span.text-moss.ml-2 = "(max #{av.effective_max_participants} pers.)"
                - idx += 1

        .mt-6.flex.justify-between.items-center
          = link_to "Passer cette étape", public_reservation_contact_path, class: "text-sm text-moss hover:text-moss"
          = f.submit "Continuer vers mes coordonnées →", class: "rounded-lg bg-forest text-white px-6 py-3 text-sm font-medium hover:bg-forest-soft cursor-pointer"

  / ── Barre récap sticky + drawer devis ────────────────────────
  = render "public/reservations/quote_drawer", quote: @quote, draft: @draft
