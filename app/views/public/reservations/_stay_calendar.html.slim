/ Calendrier de séjour interactif — grille nuits × ressources.
/ Dépend de: @draft, @lodgings, @stay_nights, @lodging_availability (instance vars du controller).
- fr_short_days = %w[Dim Lun Mar Mer Jeu Ven Sam]
- short_names   = { "La Hulotte" => "Hulotte", "La Chevêche" => "Chevêche", "Le Grand-Duc" => "Grand-Duc" }
- nights_count  = @draft.nights.to_i
- selected_ids  = @draft.lodging_night_ids.presence || []
- pnr           = @draft.per_night_resources || {}
- show_hamacs   = (5..10).cover?(Date.today.month)
- hamac_s_rate  = Pricing::Catalog.hamac_rate("simple")
- hamac_d_rate  = Pricing::Catalog.hamac_rate("double")
- tente_rate    = Pricing::Catalog.camping_per_person_night_cents("tente")
- total_cols    = nights_count + 1
- avail_json    = @lodging_availability.to_json

.bg-white.rounded-2xl.shadow-sm.border.border-bark.p-5(
  data-controller="public--stay-calendar public--unavail"
  data-needs-block="gite camping van"
  data-public--stay-calendar-nights-value=nights_count.to_s
  data-public--stay-calendar-avail-value=avail_json)

  .flex.items-start.justify-between.mb-4
    h2.funnel-section-title.flex.items-center.gap-2
      = funnel_icon :tent, css_class: "w-5 h-5 text-ember flex-shrink-0"
      | Composition nuit par nuit
    - if @stay_nights.present?
      .flex.items-center.gap-2.flex-shrink-0.ml-4.mt-0.5
        .text-xs.text-moss
          = "#{nights_count} nuit#{nights_count > 1 ? 's' : ''}"
        - if nights_count > 4
          button(
            type="button"
            data-action="click->public--stay-calendar#prevNights"
            class="relative before:content-[''] before:absolute before:-inset-2 w-7 h-7 rounded-lg border border-bark bg-white text-moss hover:border-forest hover:text-forest flex items-center justify-center text-sm transition-colors"
            aria-label="Nuits précédentes")
            | ←
          button(
            type="button"
            data-action="click->public--stay-calendar#nextNights"
            class="relative before:content-[''] before:absolute before:-inset-2 w-7 h-7 rounded-lg border border-bark bg-white text-moss hover:border-forest hover:text-forest flex items-center justify-center text-sm transition-colors"
            aria-label="Nuits suivantes")
            | →

  - if @stay_nights.empty?
    p.text-xs.text-moss Choisissez vos dates à l'étape précédente.
  - else
    / Scroll horizontal — libellés gauche collants (left-5 aligne avec le padding px-5)
    .overflow-x-auto.-mx-5.px-5(data-public--stay-calendar-target="scrollArea")
      table.border-collapse style="min-width: #{150 + nights_count * 104}px"

        thead
          tr
            th.text-left.py-2.pr-4.text-xs.font-normal.text-moss.whitespace-nowrap.sticky.left-5.z-10.bg-white style="width:150px"
            - @stay_nights.each_with_index do |night, i|
              th.text-center.py-2.px-1(data-wday=night.wday.to_s style="width:104px")
                p.text-xs.font-bold.text-moss = "Nuit #{i + 1}"
                p.text-xs.text-moss.font-normal = "#{fr_short_days[night.wday]} #{night.strftime("%-d/%-m")}"

        tbody

          / ══ Hébergements ══════════════════════════════════════════════
          tr data-needs-block="gite"
            td(class="pt-3 pb-1 pr-4" colspan=total_cols.to_s)
              span.inline-flex.items-center.gap-1.5.text-xs.font-semibold.text-moss.uppercase.tracking-wide
                = funnel_icon :house, css_class: "w-3.5 h-3.5 flex-shrink-0"
                span Hébergement

          - @lodgings.each do |lodging|
            - lodging_rate = Pricing::Catalog.lodging_rate(lodging.name)
            tr(class="border-t border-bark/60" data-needs-block="gite")
              / Capacité et nombre de chambres — on choisissait entre trois NOMS,
              / sans savoir lequel loge huit personnes et lequel en vingt-cinq.
              / `Lodging#summary` porte déjà la fourchette (« 9 à 16 personnes »)
              / et les chambres se comptent : l'information existait, elle n'était
              / simplement jamais montrée au client.
              - rooms_count = lodging.rooms.size
              - capacity_bits = [lodging.summary.presence, ("#{rooms_count} chambre#{'s' if rooms_count > 1}" if rooms_count.positive?)].compact
              td.py-2.pr-4.sticky.left-5.z-10.bg-white(style="width:150px")
                span.text-sm.text-ink.font-medium.whitespace-nowrap = short_names[lodging.name] || lodging.name
                - if capacity_bits.any?
                  p.text-xs.text-moss.leading-tight.mt-0.5 = capacity_bits.join(" · ")
                - if lodging_rate
                  p.text-xs.font-semibold.text-forest.leading-tight.mt-0.5.whitespace-nowrap
                    = "dès #{number_to_currency(lodging_rate.extra_night_cents / 100.0, unit: '€', format: '%n %u', precision: 0)}/nuit"
              - @stay_nights.each_with_index do |night, i|
                - avail = (@lodging_availability.dig(lodging.id, i) != false)
                - sel   = selected_ids.at(i).to_s == lodging.id.to_s
                / Autres gîtes libres CETTE nuit-là. Lu dans @lodging_availability, déjà
                / calculé pour la grille : pas de requête de plus. Sert la mini-modale
                / d'indisponibilité, qui se contentait jusqu'ici de constater le refus.
                - alts = @lodgings.reject { |o| o.id == lodging.id }.select { |o| @lodging_availability.dig(o.id, i) != false }.map { |o| short_names[o.name] || o.name }
                td.py-2.px-1.text-center
                  - if avail
                    / Cellule disponible — la cible de clic principale de l'étape 2.
                    / `aria-label` OBLIGATOIRE : ces boutons n'ont aucun contenu
                    / textuel, ils étaient donc annoncés « bouton » tout court —
                    / une grille de 3 gîtes × N nuits devenait un mur de boutons
                    / anonymes à la voix. La coche est un SVG permanent révélé par
                    / CSS sur `aria-pressed="true"` (cf. funnel.css) : le contrôleur
                    / Stimulus n'a ainsi plus à réécrire le contenu de la cellule.
                    button(
                      type="button"
                      aria-pressed=sel.to_s
                      aria-label="#{short_names[lodging.name] || lodging.name} — nuit du #{l(night, format: :long)}"
                      data-action="click->public--stay-calendar#toggleLodging"
                      data-type="lodging"
                      data-lodging-id=lodging.id.to_s
                      data-night-index=i.to_s
                      class="funnel-night-cell")
                      = funnel_icon :check, css_class: "w-5 h-5 funnel-night-cell__check", stroke_width: 3
                  - else
                    / Indisponible — cliquable : ouvre une mini-modale explicative
                    / (feature 1) avec un lien vers le calendrier de disponibilités.
                    button(
                      type="button"
                      data-type="lodging"
                      data-lodging-id=lodging.id.to_s
                      data-night-index=i.to_s
                      data-action="click->public--unavail#show"
                      data-unavail-name=lodging.name
                      data-unavail-date=l(night, format: :long)
                      data-unavail-alternatives=alts.to_json
                      aria-label="#{lodging.name} n'est pas libre le #{l(night, format: :long)} — voir les disponibilités"
                      class="funnel-night-cell funnel-night-cell--off")
                      span(aria-hidden="true") —

          / ══ Camping ════════════════════════════════════════════════════
          tr data-needs-block="camping van"
            td(class="pt-4 pb-1 pr-4" colspan=total_cols.to_s)
              span.inline-flex.items-center.gap-1.5.text-xs.font-semibold.text-moss.uppercase.tracking-wide
                = funnel_icon :tent, css_class: "w-3.5 h-3.5 flex-shrink-0"
                span Camping

          / Campeurs (tentes) — la saisie est un nombre de PERSONNES, pas de
          / tentes (source de confusion levée, feature 2).
          tr(class="border-t border-bark/60" data-needs-block="camping")
            td.py-2.pr-4.whitespace-nowrap.sticky.left-5.z-10.bg-white
              .flex.items-center.gap-1.5
                svg.w-4.h-4.text-moss.flex-shrink-0(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
                  path(fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd")
                .text-sm.text-ink.font-medium Campeurs (tentes)
              p.text-xs.text-moss.leading-tight.mt-0.5
                | nombre de
                strong.text-moss  personnes
                |  sous tente
                - if tente_rate
                  = " — #{number_to_currency(tente_rate / 100.0, unit: '€', format: '%n %u', precision: 2)}/pers/nuit"
            - @stay_nights.each_with_index do |night, i|
              - val = (pnr["tente"] || [])[i].to_i
              td.py-2.px-1.text-center
                = render "public/reservations/stepper_cell", name: "reservation[per_night_resources][tente][]", val: val, max: 50

          tr(class="border-t border-bark/60" data-needs-block="van")
            td.py-2.pr-4.whitespace-nowrap.sticky.left-5.z-10.bg-white
              .flex.items-center.gap-1.5
                svg.w-4.h-4.text-moss.flex-shrink-0(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true")
                  path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
                .text-sm.text-ink.font-medium Vans / camping-cars
              p.text-xs.text-moss.leading-tight.mt-0.5
                | nombre de
                strong.text-moss  véhicules
            - @stay_nights.each_with_index do |night, i|
              - val = (pnr["van"] || [])[i].to_i
              td.py-2.px-1.text-center
                = render "public/reservations/stepper_cell", name: "reservation[per_night_resources][van][]", val: val, max: 20

          / ══ Location de hamacs (mai-octobre) ════════════════════════════
          / On LOUE les hamacs — fournis et posés sur place (feature 3).
          - if show_hamacs
            tr data-needs-block="camping"
              td(class="pt-4 pb-1 pr-4" colspan=total_cols.to_s)
                span.inline-flex.items-center.gap-1.5.text-xs.font-semibold.text-moss.uppercase.tracking-wide
                = funnel_icon :hammock, css_class: "w-3.5 h-3.5 flex-shrink-0"
                span Location de hamacs
                p.text-xs.text-moss.font-normal.normal-case.tracking-normal.mt-0.5 Hamac fourni et posé dans les arbres du domaine — rien à apporter.

            tr(class="border-t border-bark/60" data-needs-block="camping")
              td.py-2.pr-4.whitespace-nowrap.sticky.left-5.z-10.bg-white
                .flex.items-center.gap-1.5
                  svg.w-4.h-4.text-moss.flex-shrink-0(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true")
                    line x1="4" y1="4" x2="4" y2="20"
                    line x1="20" y1="4" x2="20" y2="20"
                    line x1="4" y1="8" x2="20" y2="8"
                    path d="M4 15 Q12 21 20 15"
                  .text-sm.text-ink.font-medium Hamac simple
                - if hamac_s_rate
                  p.text-xs.text-moss.leading-tight.mt-0.5 = "location #{number_to_currency(hamac_s_rate / 100.0, unit: '€', format: '%n %u', precision: 2)}/nuit"
              - @stay_nights.each_with_index do |night, i|
                - val = (pnr["hamac_simple"] || [])[i].to_i
                td.py-2.px-1.text-center
                  = render "public/reservations/stepper_cell", name: "reservation[per_night_resources][hamac_simple][]", val: val, max: 10

            tr(class="border-t border-bark/60" data-needs-block="camping")
              td.py-2.pr-4.whitespace-nowrap.sticky.left-5.z-10.bg-white
                .flex.items-center.gap-1.5
                  svg.w-4.h-4.text-moss.flex-shrink-0(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true")
                    line x1="4" y1="4" x2="4" y2="20"
                    line x1="20" y1="4" x2="20" y2="20"
                    line x1="4" y1="8" x2="20" y2="8"
                    path d="M4 15 Q12 21 20 15"
                  .text-sm.text-ink.font-medium Hamac double
                - if hamac_d_rate
                  p.text-xs.text-moss.leading-tight.mt-0.5 = "location #{number_to_currency(hamac_d_rate / 100.0, unit: '€', format: '%n %u', precision: 2)}/nuit"
              - @stay_nights.each_with_index do |night, i|
                - val = (pnr["hamac_double"] || [])[i].to_i
                td.py-2.px-1.text-center
                  = render "public/reservations/stepper_cell", name: "reservation[per_night_resources][hamac_double][]", val: val, max: 10

    / Légende
    - if @stay_nights.present?
      .flex.flex-wrap.items-center.gap-x-4.gap-y-1.mt-4.pt-3.border-t.border-bark
        .flex.items-center.gap-1.5
          .w-5.h-5.rounded-lg.bg-forest.text-sand.flex.items-center.justify-center.flex-shrink-0
            = funnel_icon :check, css_class: "w-3.5 h-3.5", stroke_width: 3
          span.text-xs.text-moss Sélectionné
        .flex.items-center.gap-1.5
          .w-5.h-5.rounded-lg.border-2.border-bark.bg-white.flex-shrink-0
          span.text-xs.text-moss Disponible
        .flex.items-center.gap-1.5
          .w-5.h-5.rounded-lg.bg-sand-deep.border-2.border-bark.flex-shrink-0
          span.text-xs.text-moss Indisponible
      / Règle week-end
      .mt-2.text-xs.text-ember.bg-ember-tint.border.border-ember/30.rounded-lg.px-3.py-2.flex.items-start.gap-2
        = funnel_icon :calendar, css_class: "w-4 h-4 flex-shrink-0 mt-px"
        span Les hébergements se louent pour 2 nuits minimum le week-end (vendredi + samedi).

  / Champs cachés hébergements — un par nuit, gérés par Stimulus
  div data-public--stay-calendar-target="hiddenFields"

  / Mini-modale « hébergement indisponible » (feature 1) — <dialog> natif, sans
  / dépendance. Le bouton « Voir les disponibilités » ouvre la modale existante
  / du funnel (public--avail-modal) via un évènement window ; il se masque de
  / lui-même là où cette modale n'existe pas (form de modif client).
  dialog(data-public--unavail-target="dialog" class="rounded-2xl p-0 border-0 shadow-2xl backdrop:bg-black/40" style="width:min(92vw,22rem)")
    .p-5
      .flex.items-start.gap-3
        span.w-9.h-9.rounded-full.bg-ember-tint.text-ember.flex.items-center.justify-center.flex-shrink-0
          = funnel_icon :ban, css_class: "w-5 h-5"
        .flex-1.min-w-0
          h3.funnel-section-title.text-base Hébergement indisponible
          p.text-sm.text-moss.mt-1(data-public--unavail-target="message")
          / Issue de secours : les autres gîtes libres CETTE nuit-là. Sans ça, la
          / modale ne faisait que constater le refus et laissait le client sans
          / piste — alors que le gîte voisin est souvent libre aux mêmes dates.
          p.hidden.mt-2.rounded-lg.bg-forest-tint.text-forest.text-sm.font-medium.px-3.py-2(
            data-public--unavail-target="alternatives")
      .mt-4.flex.items-center.justify-end.gap-2
        button(type="button" data-action="click->public--unavail#close" class="rounded-lg px-3 py-2 text-sm text-moss hover:text-ink")
          | Fermer
        button(type="button" data-action="click->public--unavail#openAvailability" data-public--unavail-target="availLink" class="inline-flex items-center gap-2 rounded-lg bg-forest text-sand px-3 py-2 text-sm font-medium hover:bg-forest-soft")
          | Voir les disponibilités
          = funnel_icon :arrow_right, css_class: "w-4 h-4"
