/ Calendrier de séjour interactif — grille nuits × ressources.
/ Dépend de: @draft, @lodgings, @stay_nights, @lodging_availability (instance vars du controller).
- fr_short_days = %w[Dim Lun Mar Mer Jeu Ven Sam]
- short_names   = { "La Hulotte" => "Hulotte", "La Chevêche" => "Chevêche", "Le Grand-Duc" => "Grand-Duc" }
- nights_count  = @draft.nights.to_i
- selected_ids  = @draft.lodging_night_ids.presence || []
- pnr           = @draft.per_night_resources || {}
- show_hamacs   = (5..10).cover?(Date.today.month)
- hamac_s_rate  = Pricing::Catalog.hamac_rate("simple")
- hamac_d_rate  = Pricing::Catalog.hamac_rate("double")
- tente_rate    = Pricing::Catalog.camping_per_person_night_cents("tente")
- total_cols    = nights_count + 1
- van_rate      = Pricing::Catalog.van_per_night_cents
- eur           = ->(cents, precision = 0) { number_to_currency(cents / 100.0, unit: "€", format: "%n %u", precision: precision) }
- avail_json    = @lodging_availability.to_json

/ Mise en page (Michael, 2026-10-03) : la plupart des séjours font 1 à 4 nuits.
/ La colonne des libellés était bridée à 150 px pour laisser la place à vingt
/ colonnes qui n'existent presque jamais : sur une nuit, le texte s'empilait sur
/ cinq lignes à côté d'un grand vide. Elle est maintenant large (`.stay-grid`,
/ funnel.css) et ne porte que le nom et la capacité ; prix et bûches restent sur
/ les cartes du haut. Chaque case dit son état EN TOUTES LETTRES (« Libre »,
/ « Choisi », « Complet ») : il fallait jusqu'ici cliquer un tiret pour
/ apprendre qu'un gîte était pris.
.bg-white.rounded-2xl.shadow-sm.border.border-bark.p-5.sm:p-6(
  data-controller="public--stay-calendar public--unavail"
  data-needs-block="gite camping van"
  data-public--stay-calendar-nights-value=nights_count.to_s
  data-public--stay-calendar-avail-value=avail_json)

  .flex.items-start.justify-between.gap-4.mb-1
    h2.funnel-section-title.flex.items-center.gap-2
      = funnel_icon :bed, css_class: "w-5 h-5 text-ember flex-shrink-0"
      | Composition nuit par nuit
    - if @stay_nights.present? && nights_count > 4
      .flex.items-center.gap-2.flex-shrink-0
        button(
          type="button"
          data-action="click->public--stay-calendar#prevNights"
          class="relative before:content-[''] before:absolute before:-inset-2 w-9 h-9 rounded-lg border border-bark bg-white text-moss hover:border-forest hover:text-forest flex items-center justify-center transition-colors"
          aria-label="Nuits précédentes")
          = funnel_icon :arrow_left, css_class: "w-4 h-4"
        button(
          type="button"
          data-action="click->public--stay-calendar#nextNights"
          class="relative before:content-[''] before:absolute before:-inset-2 w-9 h-9 rounded-lg border border-bark bg-white text-moss hover:border-forest hover:text-forest flex items-center justify-center transition-colors"
          aria-label="Nuits suivantes")
          = funnel_icon :arrow_right, css_class: "w-4 h-4"

  - if @stay_nights.empty?
    p.funnel-hint.mt-2 Choisissez vos dates à l'étape précédente.
  - else
    p.funnel-hint.mb-5 Choisissez un gîte pour chaque nuit, puis ajoutez campeurs ou véhicules si besoin.

    .overflow-x-auto(data-public--stay-calendar-target="scrollArea")
      table.stay-grid

        thead
          tr
            th.stay-grid__label
            - @stay_nights.each_with_index do |night, i|
              th.stay-grid__night(data-wday=night.wday.to_s)
                span.block.text-base.font-semibold.text-ink = "#{fr_short_days[night.wday]} #{night.day} #{I18n.t("date.abbr_month_names")[night.month]}"
                span.block.funnel-hint = "nuit #{i + 1}"

        tbody

          / ══ Hébergements ══════════════════════════════════════════════
          tr data-needs-block="gite"
            td.stay-grid__section(colspan=total_cols.to_s)
              span Hébergement
          - @lodgings.each do |lodging|
            / Capacité et chambres : on choisissait entre trois NOMS sans savoir
            / lequel loge huit personnes et lequel vingt-cinq. Les chambres se
            / comptent hors mezzanine (`Lodging#bedrooms_count`).
            - rooms_count = lodging.bedrooms_count
            - capacity_bits = [lodging.summary.presence, ("#{rooms_count} chambre#{'s' if rooms_count > 1}" if rooms_count.positive?)].compact
            tr.stay-grid__row(data-needs-block="gite")
              td.stay-grid__label
                .flex.items-center.gap-3
                  / Vignette : relie la ligne à la carte photo du haut de page.
                  - if lodging_thumb_path(lodging.name)
                    = vite_image_tag lodging_thumb_path(lodging.name), alt: "", loading: "lazy", decoding: "async", class: "funnel-lodging-thumb"
                  div.min-w-0
                    p.text-base.font-semibold.text-ink.leading-tight = short_names[lodging.name] || lodging.name
                    - if capacity_bits.any?
                      p.funnel-hint.leading-snug.mt-0.5 = capacity_bits.join(" · ")
              - @stay_nights.each_with_index do |night, i|
                - avail = (@lodging_availability.dig(lodging.id, i) != false)
                - sel   = selected_ids.at(i).to_s == lodging.id.to_s
                / Autres gîtes libres CETTE nuit-là, lus dans @lodging_availability
                / (pas de requête de plus) : la mini-modale propose une issue.
                - alts = @lodgings.reject { |o| o.id == lodging.id }.select { |o| @lodging_availability.dig(o.id, i) != false }.map { |o| short_names[o.name] || o.name }
                td.stay-grid__cell
                  - if avail
                    / `aria-label` OBLIGATOIRE ; l'état visuel suit `aria-pressed`
                    / (night_cells.css + funnel.css), le contrôleur ne réécrit rien.
                    button(
                      type="button"
                      aria-pressed=sel.to_s
                      aria-label="#{short_names[lodging.name] || lodging.name} — nuit du #{l(night, format: :long)}"
                      data-action="click->public--stay-calendar#toggleLodging"
                      data-type="lodging"
                      data-lodging-id=lodging.id.to_s
                      data-night-index=i.to_s
                      class="funnel-night-cell stay-cell")
                      = funnel_icon :check, css_class: "w-4 h-4 funnel-night-cell__check", stroke_width: 3
                      span.stay-cell__free(aria-hidden="true") Libre
                      span.stay-cell__on(aria-hidden="true") Choisi
                  - else
                    / Indisponible — reste cliquable : la mini-modale explique et
                    / propose les autres gîtes libres.
                    button(
                      type="button"
                      data-type="lodging"
                      data-lodging-id=lodging.id.to_s
                      data-night-index=i.to_s
                      data-action="click->public--unavail#show"
                      data-unavail-name=lodging.name
                      data-unavail-date=l(night, format: :long)
                      data-unavail-alternatives=alts.to_json
                      aria-label="#{lodging.name} n'est pas libre le #{l(night, format: :long)} — voir les disponibilités"
                      class="funnel-night-cell funnel-night-cell--off stay-cell")
                      span(aria-hidden="true") Complet

          / ══ Camping ════════════════════════════════════════════════════
          tr data-needs-block="camping van"
            td.stay-grid__section(colspan=total_cols.to_s)
              span Camping et vans
          / Campeurs : la saisie est un nombre de PERSONNES, pas de tentes.
          tr.stay-grid__row(data-needs-block="camping")
            td.stay-grid__label
              .flex.items-center.gap-3
                span.stay-grid__icon
                  = funnel_icon :tent, css_class: "w-5 h-5"
                div.min-w-0
                  p.text-base.font-semibold.text-ink.leading-tight Campeurs sous tente
                  p.funnel-hint.leading-snug.mt-0.5
                    | Nombre de personnes
                    - if tente_rate
                      = " · #{eur.(tente_rate, 2)} par nuit"
            - @stay_nights.each_with_index do |night, i|
              - val = (pnr["tente"] || [])[i].to_i
              td.stay-grid__cell
                = render "public/reservations/stepper_cell", name: "reservation[per_night_resources][tente][]", val: val, max: 50

          tr.stay-grid__row(data-needs-block="van")
            td.stay-grid__label
              .flex.items-center.gap-3
                span.stay-grid__icon
                  = funnel_icon :van, css_class: "w-5 h-5"
                div.min-w-0
                  p.text-base.font-semibold.text-ink.leading-tight Vans et camping-cars
                  p.funnel-hint.leading-snug.mt-0.5
                    | Nombre de véhicules
                    - if van_rate
                      = " · #{eur.(van_rate, 2)} par nuit"
            - @stay_nights.each_with_index do |night, i|
              - val = (pnr["van"] || [])[i].to_i
              td.stay-grid__cell
                = render "public/reservations/stepper_cell", name: "reservation[per_night_resources][van][]", val: val, max: 20

          / ══ Location de hamacs (mai-octobre) ════════════════════════════
          / On LOUE les hamacs — fournis et posés sur place (feature 3).
          - if show_hamacs
            tr data-needs-block="camping"
              td.stay-grid__section(colspan=total_cols.to_s)
                span Hamacs à louer
                p.funnel-hint.font-normal.mt-0.5 Fournis et posés dans les arbres du domaine, rien à apporter.

            - [["hamac_simple", "Hamac simple", hamac_s_rate], ["hamac_double", "Hamac double", hamac_d_rate]].each do |key, label_text, rate|
              tr.stay-grid__row(data-needs-block="camping")
                td.stay-grid__label
                  .flex.items-center.gap-3
                    span.stay-grid__icon
                      = funnel_icon :hammock, css_class: "w-5 h-5"
                    div.min-w-0
                      p.text-base.font-semibold.text-ink.leading-tight = label_text
                      - if rate
                        p.funnel-hint.leading-snug.mt-0.5 = "#{eur.(rate, 2)} par nuit"
                - @stay_nights.each_with_index do |night, i|
                  - val = (pnr[key] || [])[i].to_i
                  td.stay-grid__cell
                    = render "public/reservations/stepper_cell", name: "reservation[per_night_resources][#{key}][]", val: val, max: 10

    / Règle week-end — les cases parlent d'elles-mêmes, plus besoin de légende.
    .mt-5.text-sm.text-ink.bg-ember-tint.border.border-ember/30.rounded-xl.px-4.py-3.flex.items-start.gap-2
      = funnel_icon :calendar, css_class: "w-5 h-5 text-ember flex-shrink-0"
      span Le week-end, les gîtes se louent pour 2 nuits minimum (vendredi et samedi).

  / Champs cachés hébergements — un par nuit, gérés par Stimulus
  div data-public--stay-calendar-target="hiddenFields"

  / Mini-modale « hébergement indisponible » (feature 1) — <dialog> natif, sans
  / dépendance. Le bouton « Voir les disponibilités » ouvre la modale existante
  / du funnel (public--avail-modal) via un évènement window ; il se masque de
  / lui-même là où cette modale n'existe pas (form de modif client).
  dialog(data-public--unavail-target="dialog" class="rounded-2xl p-0 border-0 shadow-2xl backdrop:bg-black/40" style="width:min(92vw,22rem)")
    .p-5
      .flex.items-start.gap-3
        span.w-9.h-9.rounded-full.bg-ember-tint.text-ember.flex.items-center.justify-center.flex-shrink-0
          = funnel_icon :ban, css_class: "w-5 h-5"
        .flex-1.min-w-0
          h3.funnel-section-title.text-base Hébergement indisponible
          p.text-sm.text-moss.mt-1(data-public--unavail-target="message")
          / Issue de secours : les autres gîtes libres CETTE nuit-là. Sans ça, la
          / modale ne faisait que constater le refus et laissait le client sans
          / piste — alors que le gîte voisin est souvent libre aux mêmes dates.
          p.hidden.mt-2.rounded-lg.bg-forest-tint.text-forest.text-sm.font-medium.px-3.py-2(
            data-public--unavail-target="alternatives")
      .mt-4.flex.items-center.justify-end.gap-2
        button(type="button" data-action="click->public--unavail#close" class="rounded-lg px-3 py-2 text-sm text-moss hover:text-ink")
          | Fermer
        button(type="button" data-action="click->public--unavail#openAvailability" data-public--unavail-target="availLink" class="inline-flex items-center gap-2 rounded-lg bg-forest text-sand px-3 py-2 text-sm font-medium hover:bg-forest-soft")
          | Voir les disponibilités
          = funnel_icon :arrow_right, css_class: "w-4 h-4"
