/ Étape 2/4 — Composition du séjour
- content_for :meta_title, "Composez votre séjour"
div(data-controller="public--avail-modal")
  .max-w-5xl.mx-auto.px-4.sm:px-6.pt-8.md:pt-10.pb-28(data-controller="public--reservation-quote"
    data-public--reservation-quote-url-value=public_reservation_quote_path
    data-public--reservation-quote-next-url-value=public_reservation_activities_path)

    / ── Step indicator ───────────────────────────────────────
    = render "public/reservations/step_indicator", current: 2

    / ── Résumé dates ─────────────────────────────────────────
    - if @draft.arrival_date && @draft.departure_date
      .flex.items-center.gap-2.mb-6.text-sm.text-moss.bg-white.rounded-xl.px-4.py-3.border.border-bark.shadow-sm.w-fit
        = funnel_icon :calendar, css_class: "w-4 h-4 text-ember flex-shrink-0"
        strong = l(@draft.arrival_date, format: :long)
        span.text-moss →
        strong = l(@draft.departure_date, format: :long)
        .ml-1.px-2.py-0.5.bg-forest-tint.text-forest.rounded-full.text-xs.font-semibold
          = "#{@draft.nights} nuit#{"s" if @draft.nights.to_i > 1}"
        = link_to "Modifier", public_reservation_dates_path, class: "ml-2 text-xs text-moss hover:text-moss underline relative before:content-[''] before:absolute before:-inset-y-3.5 before:inset-x-0"

    / ── Les gîtes en photos ─────────────────────────────────
    / Placé AVANT la grille : on regarde, puis on choisit ses nuits.
    = render "public/reservations/lodging_cards"

    .space-y-6

      / ── Calendrier des disponibilités ───────────────────────
      .bg-white.rounded-2xl.shadow-sm.border.border-bark.p-4
        .flex.items-center.gap-3
          span.w-9.h-9.rounded-full.bg-forest-tint.text-forest.flex.items-center.justify-center.flex-shrink-0
            = funnel_icon :calendar, css_class: "w-5 h-5"
          div.flex-1.min-w-0
            h3.funnel-section-title.text-base Calendrier des disponibilités
            p.text-xs.text-moss.mt-0.5 Hébergements & espaces, mois par mois
          button type="button" data-action="public--avail-modal#open" class="flex-shrink-0 rounded-xl bg-forest text-white px-4 py-2 text-sm font-medium hover:bg-forest-soft transition-colors"
            | Ouvrir →

      / ── Formulaire ──────────────────────────────────────────
      = form_with url: public_reservation_quote_path, method: :post,
          class: "space-y-6",
          data: { controller: "public--needs",
                  "public--needs-selected-value": @draft.needs.to_json,
                  "public--reservation-quote-target": "form",
                  action: "change->public--reservation-quote#refresh" } do |f|

        / Champs cachés `reservation[needs][]` — la sélection survit aux POST devis.
        div data-public--needs-target="fields"

        / ── Zone « Ajouter un bloc » (feature 5) ─────────────
        / Masquée quand tout est déjà visible ; sinon un bouton par bloc replié.
        .rounded-2xl.border.border-dashed.border-bark.bg-sand-deep.p-4(data-public--needs-target="addZone")
          p.text-xs.font-medium.text-moss.mb-2 Ajouter à votre séjour
          .flex.flex-wrap.gap-2
            - [["gite", :house, "Gîte"], ["salles", :hall, "Salles & cuisine"], ["camping", :tent, "Camping"], ["van", :van, "Van"], ["repas", :utensils, "Repas"], ["activites", :leaf, "Activités"]].each do |token, icon, label_text|
              button(type="button" data-needs-add-token=token data-action="click->public--needs#add" class="inline-flex items-center gap-1.5 rounded-lg border border-bark bg-white px-3 py-1.5 text-sm text-moss hover:border-forest hover:text-forest transition-colors")
                = funnel_icon icon, css_class: "w-4 h-4 flex-shrink-0"
                span
                  | + #{label_text}

        / ── Hébergement — calendrier interactif ─────────────
        = render "public/reservations/stay_calendar"

        / ── Espaces ──────────────────────────────────────────
        = render "public/reservations/spaces_calendar"

        / ── Repas (feature 5 : bloc du besoin « repas ») ─────
        .bg-white.rounded-2xl.shadow-sm.border.border-bark.p-6(data-needs-block="repas")
          .flex.items-start.gap-3
            span.text-ember.flex-shrink-0.mt-0.5
              = funnel_icon :utensils, css_class: "w-6 h-6"
            div
              h2.funnel-section-title.mb-1 Repas & pain
              p.text-sm.text-moss.mb-1 Pain au levain et épicerie à pré-commander pour votre arrivée ; repas de groupe sur demande.
              p.text-sm.text-moss
                = link_to "Commander sur Tranches de Vie →", "https://tranchesdevie.les4sources.be", target: "_blank", rel: "noopener", class: "text-forest underline"
                |  ou écrivez-nous à
                = link_to " sejours@les4sources.be", "mailto:sejours@les4sources.be", class: "underline"

        / ── Activités ───────────────────────────────────────
        .bg-forest-tint.rounded-2xl.border.border-bark.p-6(data-needs-block="activites")
          .flex.items-start.gap-3
            span.text-forest.flex-shrink-0.mt-0.5
              = funnel_icon :leaf, css_class: "w-6 h-6"
            div
              h2.funnel-section-title.mb-1 Activités aux 4 Sources
              p.text-sm.text-ink.mb-1 Balades avec les ânes, ateliers créatifs, forge, golf et bien d'autres…
              p.text-sm.text-moss
                | Les activités se réservent
                strong  1 mois avant votre arrivée.
                |  Vous recevrez un email avec un calendrier pour sélectionner ce qui vous tente.

        noscript
          = f.submit "Mettre à jour le devis", class: "rounded-lg bg-forest text-sand px-4 py-2 text-sm font-semibold"

        / CTA — partial remplaçable par le Turbo Stream du devis.
        = render "public/reservations/compose_cta", quote: @quote
        noscript
          = f.submit "Continuer (sans JS)", formaction: public_reservation_advance_compose_path, formmethod: :post, class: "rounded-xl bg-forest text-white px-8 py-3 text-sm font-semibold"

    / ── Infos complémentaires ────────────────────────────────
    .mt-8.grid.grid-cols-1.sm:grid-cols-2.lg:grid-cols-3.gap-4

      .funnel-card.p-4
        h3.text-sm.font-semibold.text-ink.mb-1.flex.items-center.gap-2
          = funnel_icon :bed, css_class: "w-4 h-4 text-ember flex-shrink-0"
          span Nuitée individuelle (semaine)
        p.text-xs.text-moss
          | En semaine uniquement :
          strong  35 €/adulte · 15 €/enfant (3–12 ans).
          |  Contactez-nous à
          = link_to " sejours@les4sources.be", "mailto:sejours@les4sources.be", class: "underline"

      .bg-white.rounded-xl.border.border-bark.p-4
        h3.text-sm.font-semibold.text-ink.mb-1.flex.items-center.gap-2
          = funnel_icon :bread, css_class: "w-4 h-4 text-ember flex-shrink-0"
          span Pré-commande pain & épicerie
        p.text-xs.text-moss.mb-2 Pain au levain et épicerie disponibles pour votre arrivée.
        = link_to "Commander sur Tranches de Vie →", "https://tranchesdevie.les4sources.be", target: "_blank", rel: "noopener", class: "text-forest underline text-xs"

      .bg-white.rounded-xl.border.border-bark.p-4
        h3.text-sm.font-semibold.text-ink.mb-1.flex.items-center.gap-2
          = funnel_icon :chat, css_class: "w-4 h-4 text-ember flex-shrink-0"
          span Une question ?
        p.text-xs.text-moss
          | Malau :
          strong  +32 (0)490 46.77.10
          |  ou
          = link_to " sejours@les4sources.be", "mailto:sejours@les4sources.be", class: "underline"

  / ── Modale calendrier disponibilités ────────────────────────
  = render "public/reservations/avail_modal"

  / ── Barre récap sticky + drawer devis ────────────────────────
  = render "public/reservations/quote_drawer", quote: @quote, draft: @draft
