/ Étape 2/3 — Composition du séjour
- content_for :meta_title, "Composez votre séjour"
/ Catalogue des activités sur le site public. Pas de page dédiée connue à ce
/ jour : la page d'accueil, à remplacer par l'URL exacte du catalogue.
- activities_catalog_url = "https://www.les4sources.be"
div(data-controller="public--avail-modal")
  .max-w-5xl.mx-auto.px-4.sm:px-6.pt-8.md:pt-10.pb-28(data-controller="public--reservation-quote"
    data-public--reservation-quote-url-value=public_reservation_quote_path
    data-public--reservation-quote-next-url-value=public_reservation_contact_path)

    / ── Step indicator ───────────────────────────────────────
    = render "public/reservations/step_indicator", current: 2

    / ── Résumé dates ─────────────────────────────────────────
    - if @draft.arrival_date && @draft.departure_date
      .flex.flex-wrap.items-center.gap-x-3.gap-y-1.mb-6.text-base.text-ink.bg-white.rounded-xl.px-4.py-3.border.border-bark.shadow-sm.w-fit
        = funnel_icon :calendar, css_class: "w-5 h-5 text-ember flex-shrink-0"
        strong.font-semibold = stay_dates_label(@draft.arrival_date, @draft.departure_date)
        span.px-2.5.py-0.5.bg-forest-tint.text-forest.rounded-full.text-sm.font-semibold
          = "#{@draft.nights} nuit#{"s" if @draft.nights.to_i > 1}"
        = link_to "Modifier", public_reservation_dates_path, class: "text-sm text-moss hover:text-forest underline underline-offset-2 relative before:content-[''] before:absolute before:-inset-y-3 before:inset-x-0"

    / ── Les gîtes en photos ─────────────────────────────────
    / Placé AVANT la grille : on regarde, puis on choisit ses nuits.
    = render "public/reservations/lodging_cards"

    .space-y-6

      / ── Calendrier des disponibilités ───────────────────────
      .bg-white.rounded-2xl.shadow-sm.border.border-bark.p-4.sm:p-5
        .flex.items-center.gap-3
          span.w-10.h-10.rounded-full.bg-forest-tint.text-forest.flex.items-center.justify-center.flex-shrink-0
            = funnel_icon :calendar, css_class: "w-5 h-5"
          div.flex-1.min-w-0
            h3.funnel-section-title Calendrier des disponibilités
            p.funnel-hint.mt-0.5 Gîtes et salles, mois par mois
          button type="button" data-action="public--avail-modal#open" class="flex-shrink-0 inline-flex items-center gap-2 rounded-xl bg-forest text-sand px-4 py-2.5 text-sm font-semibold hover:bg-forest-soft transition-colors"
            | Ouvrir
            = funnel_icon :arrow_right, css_class: "w-4 h-4"

      / ── Formulaire ──────────────────────────────────────────
      = form_with url: public_reservation_quote_path, method: :post,
          class: "space-y-6",
          data: { controller: "public--needs",
                  "public--needs-selected-value": @draft.needs.to_json,
                  "public--reservation-quote-target": "form",
                  action: "change->public--reservation-quote#refresh" } do |f|

        / Champs cachés `reservation[needs][]` — la sélection survit aux POST devis.
        div data-public--needs-target="fields"

        / ── Ce que contient le séjour (feature 5) ─────────────
        / Une puce par bloc. Celles déjà actives (cochées à l'étape 1 ou ajoutées
        / ici) sont pleines, avec une coche : « Gîte » restait affiché en « + Gîte »
        / alors qu'il était déjà là, et le clic ne faisait rien (Michael,
        / 2026-10-03). Un clic sur une puce active mène au bloc ; sur une puce
        / inactive, il ajoute le bloc et y mène.
        .rounded-2xl.border.border-bark.bg-white.p-4.sm:p-5(data-public--needs-target="addZone")
          p.text-base.font-semibold.text-ink.mb-3 Votre séjour comprend
          .flex.flex-wrap.gap-2
            - [["gite", :house, "Gîte"], ["salles", :hall, "Salles & cuisine"], ["camping", :tent, "Camping"], ["van", :van, "Van"], ["repas", :utensils, "Repas"], ["activites", :leaf, "Activités"]].each do |token, icon, label_text|
              button(type="button" data-needs-add-token=token aria-pressed="false" data-action="click->public--needs#add" class="funnel-need-chip")
                span.funnel-need-chip__icon
                  = funnel_icon icon, css_class: "w-5 h-5"
                span.funnel-need-chip__check
                  = funnel_icon :check, css_class: "w-5 h-5", stroke_width: 2.5
                span.funnel-need-chip__plus(aria-hidden="true") +
                span = label_text
          p.funnel-hint.mt-3 Un clic sur un élément l'ajoute à votre séjour.

        / ── Hébergement — calendrier interactif ─────────────
        = render "public/reservations/stay_calendar"

        / ── Options (draps) ─────────────────────────────────
        = render "public/reservations/linen_options", draft: @draft

        / ── Espaces ──────────────────────────────────────────
        = render "public/reservations/spaces_calendar"

        / ── Repas & pain (feature 5 : bloc du besoin « repas ») ─
        / Trois offres distinctes (Michael, 2026-10-03) : repas sur demande,
        / pain de Tranches de Vie commandé en ligne, épicerie sur place.
        .bg-white.rounded-2xl.shadow-sm.border.border-bark.p-5.sm:p-6(data-needs-block="repas")
          h2.funnel-section-title.flex.items-center.gap-2.mb-4
            = funnel_icon :utensils, css_class: "w-5 h-5 text-ember flex-shrink-0"
            | Repas & pain
          .grid.grid-cols-1.md:grid-cols-3.gap-3
            .funnel-offer
              span.funnel-offer__icon
                = funnel_icon :utensils, css_class: "w-5 h-5"
              h3.text-base.font-semibold.text-ink Repas sur demande
              p.text-base.text-moss.mt-1 15 € par personne, selon disponibilité.
              p.text-sm.text-moss.mt-2
                | Écrivez-nous à
                =< link_to "sejours@les4sources.be", "mailto:sejours@les4sources.be", class: "text-forest underline underline-offset-2"
            .funnel-offer
              span.funnel-offer__icon
                = funnel_icon :bread, css_class: "w-5 h-5"
              h3.text-base.font-semibold.text-ink Pain au levain
              p.text-base.text-moss.mt-1 Cuit au feu de bois, à commander en ligne chez Tranches de Vie.
              = link_to "https://tranchesdevie.les4sources.be", target: "_blank", rel: "noopener", class: "mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-forest underline underline-offset-2" do
                | Commander mon pain
                = funnel_icon :arrow_right, css_class: "w-4 h-4"
            .funnel-offer
              span.funnel-offer__icon
                = funnel_icon :basket, css_class: "w-5 h-5"
              h3.text-base.font-semibold.text-ink Épicerie sur place
              p.text-base.text-moss.mt-1 Produits en vrac, jus de pomme et tout le nécessaire pour le petit déjeuner.

        / ── Activités ───────────────────────────────────────
        / Le module Activités de Claudy n'est pas encore ouvert au public
        / (Michael, 2026-10-03) : on renvoie au catalogue du site et on recueille
        / les envies du groupe en texte libre. Ce texte part avec la demande, dans
        / la note interne du séjour (Reservations::Builder#internal_notes).
        .bg-forest-tint.rounded-2xl.border.border-bark.p-5.sm:p-6(data-needs-block="activites")
          h2.funnel-section-title.flex.items-center.gap-2.mb-2
            = funnel_icon :leaf, css_class: "w-5 h-5 text-forest flex-shrink-0"
            | Activités aux 4 Sources
          p.text-base.text-ink
            | Balades avec les ânes, ateliers créatifs, forge, golf et bien d'autres…
            =< link_to "Voir le catalogue des activités", activities_catalog_url, target: "_blank", rel: "noopener", class: "font-semibold text-forest underline underline-offset-2"
          label.block.mt-4(for="reservation_activities_note")
            span.funnel-label Des activités vous intéressent ?
            span.funnel-hint.block.mt-0.5 Facultatif. Dites-nous lesquelles et pour combien de personnes. Notre équipe planifie les activités un mois avant votre séjour.
          textarea#reservation_activities_note(name="reservation[activities_note]" rows="3" class="mt-2 w-full rounded-xl border-bark bg-white text-base text-ink shadow-sm focus:border-forest focus:ring-forest" placeholder="Ex. : une balade avec les ânes pour 6 enfants, un atelier forge pour les adultes…")
            = @draft.activities_note

        noscript
          = f.submit "Mettre à jour le devis", class: "rounded-lg bg-forest text-sand px-4 py-2 text-sm font-semibold"

        / CTA — partial remplaçable par le Turbo Stream du devis.
        = render "public/reservations/compose_cta", quote: @quote, draft: @draft
        noscript
          = f.submit "Continuer (sans JS)", formaction: public_reservation_advance_compose_path, formmethod: :post, class: "rounded-xl bg-forest text-white px-8 py-3 text-sm font-semibold"

    / ── Infos complémentaires ────────────────────────────────
    / « Nuitée individuelle » retirée (Michael, 2026-10-03), comme à l'étape 1.
    .mt-8.grid.grid-cols-1.sm:grid-cols-2.gap-4

      .funnel-card.p-5
        h3.text-base.font-semibold.text-ink.mb-1.flex.items-center.gap-2
          = funnel_icon :bread, css_class: "w-5 h-5 text-ember flex-shrink-0"
          span Pré-commande pain
        p.text-base.text-moss.mb-2 Pains au levain disponibles pour votre arrivée.
        = link_to "Commander sur Tranches de Vie", "https://tranchesdevie.les4sources.be", target: "_blank", rel: "noopener", class: "text-forest font-semibold underline underline-offset-2 text-sm"

      .funnel-card.p-5
        h3.text-base.font-semibold.text-ink.mb-1.flex.items-center.gap-2
          = funnel_icon :chat, css_class: "w-5 h-5 text-ember flex-shrink-0"
          span Une question ?
        p.text-base.text-moss
          | Malau :
          =< link_to "+32 (0)490 46 77 10", "tel:+32490467710", class: "font-semibold text-ink underline underline-offset-2"
          |  ou
          =< link_to "sejours@les4sources.be", "mailto:sejours@les4sources.be", class: "underline underline-offset-2"

  / ── Modale calendrier disponibilités ────────────────────────
  = render "public/reservations/avail_modal"

  / ── Barre récap sticky + drawer devis ────────────────────────
  = render "public/reservations/quote_drawer", quote: @quote, draft: @draft
