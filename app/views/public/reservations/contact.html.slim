/ Étape 4/4 — Coordonnées et envoi
- content_for :meta_title, "Vos coordonnées"
div
  .max-w-3xl.mx-auto.px-4.pt-10.pb-28

    / ── Step indicator ───────────────────────────────────────
    = render "public/reservations/step_indicator", current: 4

    / ── Titre ────────────────────────────────────────────────
    .mb-8
      h1.funnel-title Vos coordonnées
      p.mt-3.text-base.leading-relaxed.text-moss Plus qu'une étape — ensuite, on s'occupe de tout.

    / ── Formulaire ─────────────────────────────────────────
    .funnel-card.p-5.sm:p-8
      / turbo: false OBLIGATOIRE : la réponse est un redirect vers Stripe
        Checkout (hôte externe). Un POST Turbo suit ce redirect en fetch,
        que CORS bloque → aucune navigation, le clic semble mort. En POST
        natif, le navigateur suit le redirect en top-level sans restriction.
      = form_with url: public_reservation_create_path, method: :post, data: { turbo: false } do |f|
        / Champs cachés composition
        = hidden_field_tag "reservation[lodging_id]", @draft.lodging_id
        = hidden_field_tag "reservation[arrival_date]", @draft.arrival_date&.iso8601
        = hidden_field_tag "reservation[departure_date]", @draft.departure_date&.iso8601
        = hidden_field_tag "reservation[adults]", @draft.adults
        = hidden_field_tag "reservation[children]", @draft.children
        = hidden_field_tag "reservation[dogs_count]", @draft.dogs_count

        / Récap du séjour
        = render "public/reservations/stay_summary", draft: @draft

        .mt-6.pt-6.border-t.border-bark

        / Nom
        .grid.grid-cols-1.sm:grid-cols-2.gap-4.mb-5
          label.block
            span.funnel-label Prénom *
            = text_field_tag "reservation[first_name]", @draft.first_name,
                required: true,
                autocomplete: "given-name",
                autocapitalize: "words",
                class: "mt-1.5 w-full rounded-xl border-bark bg-white text-base text-ink shadow-sm focus:border-forest focus:ring-forest"
          label.block
            span.funnel-label Nom
            = text_field_tag "reservation[last_name]", @draft.last_name,
                autocomplete: "family-name",
                autocapitalize: "words",
                class: "mt-1.5 w-full rounded-xl border-bark bg-white text-base text-ink shadow-sm focus:border-forest focus:ring-forest"

        / Email
        label.block.mb-5
          span.funnel-label Email *
          = email_field_tag "reservation[email]", @draft.email,
              required: true,
              placeholder: "vous@exemple.com",
              autocomplete: "email",
              inputmode: "email",
              autocapitalize: "off",
              spellcheck: "false",
              class: "mt-1.5 w-full rounded-xl border-bark bg-white text-base text-ink shadow-sm focus:border-forest focus:ring-forest"

        / Téléphone + Groupe
        .grid.grid-cols-1.sm:grid-cols-2.gap-4.mb-5
          label.block
            span.funnel-label Téléphone
            = telephone_field_tag "reservation[phone]", @draft.phone,
                autocomplete: "tel",
                inputmode: "tel",
                placeholder: "+32 ...",
                class: "mt-1.5 w-full rounded-xl border-bark bg-white text-base text-ink shadow-sm focus:border-forest focus:ring-forest"
          label.block
            span.funnel-label Nom du groupe
            = text_field_tag "reservation[group_name]", @draft.group_name,
                autocomplete: "organization",
                class: "mt-1.5 w-full rounded-xl border-bark bg-white text-base text-ink shadow-sm focus:border-forest focus:ring-forest"

        / Type de séjour (Michael 2026-07-21) — optionnel, SANS la catégorie
        / interne « Les 4 Sources » (Stay.public_categories). La valeur circule
        / par le Draft jusqu'au Stay créé.
        label.block.mb-5
          span.funnel-label Type de séjour (optionnel)
          = select_tag "reservation[category]", options_for_select(Stay.public_categories.map(&:reverse), @draft.category), include_blank: "— Non précisé —", class: "mt-1.5 w-full rounded-xl border-bark bg-white text-base text-ink shadow-sm focus:border-forest focus:ring-forest"

        / Animal read-only
        .mb-6.p-4.bg-sand-deep.rounded-xl.flex.items-center.justify-between
          div
            span.funnel-label.mb-1 Animal de compagnie
            - dog_label = { 0 => "Pas d'animal", 1 => "Un chien (+50 €)", 2 => "Plusieurs chiens (sur demande)" }[@draft.dogs_count.to_i] || "Pas d'animal"
            span.text-sm.font-medium.text-ink = dog_label
            - if @draft.dogs_count.to_i > 1
              p.text-xs.text-amber-600.mt-1 Notre équipe vous recontacte pour les chiens supplémentaires.
          = link_to "Modifier", public_reservation_compose_path, class: "text-xs text-forest hover:underline flex-shrink-0 ml-4 relative before:content-[''] before:absolute before:-inset-y-3.5 before:inset-x-0"

        / CTA
        button(type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-forest text-sand py-4 text-base font-semibold hover:bg-forest-soft shadow-sm cursor-pointer transition-colors")
          | Envoyer ma demande et payer l'acompte
          = funnel_icon :arrow_right, css_class: "w-4 h-4"
        .mt-4.flex.items-start.justify-center.gap-2.text-center
          span.text-forest.flex-shrink-0.mt-0.5
            = funnel_icon :shield, css_class: "w-4 h-4"
          p.funnel-hint.max-w-sm.text-left
            | Paiement sécurisé par Stripe — seul l'acompte est prélevé aujourd'hui, le solde à l'arrivée. Votre demande est ensuite validée par notre équipe avant confirmation définitive.

  / ── Barre récap sticky + drawer devis ────────────────────────
  = render "public/reservations/quote_drawer", quote: @quote, draft: @draft
