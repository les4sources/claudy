/ Paiements du séjour — même mécanisme que la page booking : chaque paiement
/ `pending` expose le CTA Stripe via `pay_public_payment_path` (epic #26, Phase 1).
- pending_payments = @payments.select(&:pending?)
- paid_payments = @payments.select(&:paid?)

- if pending_payments.any?
  .mt-6.space-y-4(data-stay-payments="pending")
    - pending_payments.each do |payment|
      .rounded-xl.border.p-4.md:p-5(class="bg-forest-tint border-bark")
        .sm:flex.sm:items-start.sm:justify-between.gap-4
          div
            h3.text-base.font-semibold.text-ink
              = t("public.stays.payments.pay_online")
            .mt-1.max-w-xl.text-sm.text-ink
              p
                span.font-semibold
                  = t("public.stays.payments.invitation", amount: payment.amount)
                = " "
                = t("public.stays.payments.stripe_notice")
              .mt-3
                = render "payments/icons"

          .mt-4.sm:mt-0.sm:flex-shrink-0.sm:flex.sm:items-center
            = link_to t("public.stays.payments.pay_cta"),
                      pay_public_payment_path(payment),
                      target: "_blank",
                      class: "inline-flex items-center rounded-xl bg-forest px-5 py-2.5 text-sm font-semibold text-sand shadow-sm hover:bg-forest-soft"

- if paid_payments.any?
  .mt-6(data-stay-payments="paid")
    h3.text-sm.font-semibold.text-ink.mb-2 = t("public.stays.payments.received_heading")
    ul.divide-y(class="divide-bark" role="list")
      - paid_payments.each do |payment|
        li.flex.items-center.justify-between.gap-4.py-3
          .flex.items-center.gap-3
            span.text-2xl = payment.payment_method_emoji
            / `line` ne couvre pas tous les moyens de paiement — on retombe sur le montant.
            span.text-sm.text-ink = payment.line.presence || payment.amount
          span.text-sm(class="text-moss") = payment.updated_at

/ « Aucun paiement n'est attendu » ne doit PAS s'afficher sous un bouton
/ « Payer le solde » : la page se contredisait. Le message ne vaut que quand il
/ n'y a ni paiement enregistré, ni solde à réclamer.
- if pending_payments.empty? && paid_payments.empty? && !@stay.show_balance_cta?
  p.mt-4.text-sm(class="text-moss") = t("public.stays.show.no_payment")
