/ Fin de page : comment nous joindre, et comment faire changer quelque chose.
section.mt-6.rounded-2xl.border.p-5.md:p-6(class="bg-sand-deep border-bark")
  .flex.items-start.gap-3
    span.text-forest.flex-shrink-0.mt-0.5
      = funnel_icon :chat, css_class: "w-6 h-6"
    div.min-w-0
      h2.funnel-section-title.mb-1 = t("public.stays.show.contact_us_heading")
      p.text-base.text-ink
        == t("public.stays.show.questions_html",
             email: link_to("sejours@les4sources.be", "mailto:sejours@les4sources.be", class: "underline"),
             phone: link_to("+32 455 13 61 42", "tel:+32455136142", class: "underline"))

      /  Demande de modification (issue #133). Un séjour déjà parti ne se modifie
         plus : pas de bouton quand le départ est passé.
      - if @stay.departure_date.present? && @stay.departure_date >= Date.current
        .mt-4
          = link_to t("public.stay_change_requests.cta"),
                    new_public_stay_change_request_path(@stay.token),
                    class: "inline-flex items-center rounded-xl border bg-white px-5 py-2.5 text-sm font-semibold text-ink shadow-sm hover:bg-sand #{'border-bark'}"
