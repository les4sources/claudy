/ Un groupe présent dans un gîte au jour choisi. Le séjour (`Stay`) porte le
  client, la composition, les activités et la Pizza Party ; un booking legacy
  sans séjour n'a que son nom et ses dates.
- booking = group.booking
- stay = group.stay&.decorate
li.rounded-xl.border.border-stone-200.bg-white.p-3.shadow-sm
  .flex.flex-wrap.items-center.gap-1.5
    - if group.departing
      span class="rounded-full bg-stone-100 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-stone-600" Part aujourd'hui
    - if group.arriving
      span class="rounded-full bg-ember-tint px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-ember" Arrive aujourd'hui
  p.mt-1.text-base.font-semibold.text-stone-900 = stay ? stay.display_name : booking.name

  dl.mt-2.space-y-1.text-sm.text-stone-600
    .flex.gap-2
      dt.w-20.shrink-0.text-stone-400 Dates
      dd
        = stay ? stay.date_range : "#{l(booking.from_date, format: :short)} → #{l(booking.to_date, format: :short)}"
        - if stay&.stay_span_label
          span.block.text-xs.text-stone-400 = stay.stay_span_label
    - if booking.lodging && booking.lodging != venue
      .flex.gap-2
        dt.w-20.shrink-0.text-stone-400 Gîte
        dd = booking.lodging.name
    - people = { "adulte" => booking.adults, "enfant" => booking.children, "bébé" => booking.babies }.select { |_, n| n.to_i.positive? }
    .flex.gap-2
      dt.w-20.shrink-0.text-stone-400 Personnes
      dd = people.any? ? people.map { |word, n| "#{n} #{word}#{'s' if n > 1}" }.join(" · ") : "—"
    - if stay
      .flex.gap-2
        dt.w-20.shrink-0.text-stone-400 Séjour
        dd = stay.composition_summary

  - if stay
    - activities = stay.activity_lines
    - if activities.any?
      .mt-3
        p class="text-[0.65rem] font-semibold uppercase tracking-wide text-stone-400" Activités
        ul.mt-1.space-y-0.5.text-sm.text-stone-600
          - activities.each do |activity|
            li
              span.font-medium.text-stone-800 = activity[:name]
              = " · #{activity[:date_range]}" if activity[:date_range].present?
              = " · #{activity[:participants]} pers." if activity[:participants].positive?

    - parties = stay.object.party_reservations.active.ordered
    - if parties.any?
      .mt-3
        p class="text-[0.65rem] font-semibold uppercase tracking-wide text-stone-400" Pizza Party
        ul.mt-1.space-y-0.5.text-sm.text-stone-600
          - parties.each do |party|
            li = party.summary.presence || "Pizza Party"

    - notes = stay.internal_notes_entries
    - if notes.any?
      .mt-3
        p class="text-[0.65rem] font-semibold uppercase tracking-wide text-stone-400" Notes internes
        - notes.each do |entry|
          .mt-1.rounded-lg.bg-sand.px-2.py-1.5.text-xs.leading-relaxed.text-stone-700
            = simple_format(entry[:text], {}, wrapper_tag: "div")

    .mt-3
      = link_to "Ouvrir le séjour", stay_path(stay.object), data: { turbo_frame: "_top" },
                class: "inline-flex h-11 items-center rounded-lg bg-forest px-4 text-sm font-semibold text-white hover:bg-forest-soft"
  - else
    .mt-3
      = link_to "Ouvrir la réservation", booking_path(booking), data: { turbo_frame: "_top" },
                class: "inline-flex h-11 items-center rounded-lg border border-stone-300 px-4 text-sm font-semibold text-stone-700 hover:bg-stone-50"
