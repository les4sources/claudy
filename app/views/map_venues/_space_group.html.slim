/ Une réservation de salle au jour choisi : le client, le créneau, l'événement.
- space_booking = group.space_booking
- stay = group.stay&.decorate
- slots = group.reservations.map { |reservation| reservation.decorate.duration }.compact.uniq
li.rounded-xl.border.border-stone-200.bg-white.p-3.shadow-sm
  p.text-base.font-semibold.text-stone-900 = stay ? stay.display_name : space_booking.name
  dl.mt-2.space-y-1.text-sm.text-stone-600
    .flex.gap-2
      dt.w-20.shrink-0.text-stone-400 Créneau
      dd = slots.any? ? slots.join(", ").upcase_first : "—"
    - if space_booking.persons.present?
      .flex.gap-2
        dt.w-20.shrink-0.text-stone-400 Personnes
        dd = space_booking.persons
    - if space_booking.event
      .flex.gap-2
        dt.w-20.shrink-0.text-stone-400 Événement
        dd = link_to space_booking.event.name, event_path(space_booking.event), data: { turbo_frame: "_top" },
                     class: "font-medium text-forest hover:underline"
  .mt-3
    - if stay
      = link_to "Ouvrir le séjour", stay_path(stay.object), data: { turbo_frame: "_top" },
                class: "inline-flex h-11 items-center rounded-lg bg-forest px-4 text-sm font-semibold text-white hover:bg-forest-soft"
    - else
      = link_to "Ouvrir la réservation", space_booking_path(space_booking), data: { turbo_frame: "_top" },
                class: "inline-flex h-11 items-center rounded-lg border border-stone-300 px-4 text-sm font-semibold text-stone-700 hover:bg-stone-50"
