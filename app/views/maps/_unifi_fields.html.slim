/ L'équipement UniFi d'un nœud Ethernet (epic #348, phase 10). La liste vient
  de l'API Site Manager par `Unifi::Client` (en cache 60 s) ; sans clé ou
  quand l'API ne répond pas, la fiche le dit et reste utilisable — le lien
  déjà enregistré n'est pas envoyé, donc pas effacé.
- client = Unifi::Client.new
- dot = "inline-block h-2.5 w-2.5 shrink-0 rounded-full"
div.rounded-lg.border.border-stone-200.bg-stone-50.px-3.py-3 data-unifi-fields="true"
  - if !client.configured?
    p.flex.items-center.gap-2.text-sm.text-stone-500 data-unifi-unavailable="not_configured"
      span class="#{dot} bg-stone-400"
      | Statut UniFi indisponible (clé API non configurée)
  - elsif !client.available?
    p.flex.items-center.gap-2.text-sm.text-stone-500 data-unifi-unavailable="api_down"
      span class="#{dot} bg-stone-400"
      | Statut UniFi indisponible (l'API UniFi ne répond pas)
  - else
    - device = client.device(feature.unifi_device_id)
    - options = client.devices.map { |d| [d.label, d.id] }
    - options.unshift(["Équipement introuvable (#{feature.unifi_device_id})", feature.unifi_device_id]) if feature.unifi_device_id && !device
    = f.label :unifi_device_id, "Équipement UniFi", class: "block text-xs font-semibold text-stone-600"
    = f.select :unifi_device_id, options, { include_blank: "— Choisir —", selected: feature.unifi_device_id },
               class: "mt-1 h-11 w-full rounded-lg border-stone-300 text-sm shadow-sm focus:border-forest focus:ring-forest"
    - if device
      - status = device.status.presence_in(%w[online offline]) || "unknown"
      - status_label = { "online" => "En ligne", "offline" => "Hors ligne", "unknown" => "Inconnu" }[status]
      - status_color = { "online" => "bg-emerald-500", "offline" => "bg-red-500", "unknown" => "bg-stone-400" }[status]
      dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm" data-unifi-device-status=status
        dt.text-xs.font-semibold.text-stone-600 Statut
        dd.flex.items-center.gap-1.5.font-semibold.text-stone-800
          span class="#{dot} #{status_color}"
          = status_label
        dt.text-xs.font-semibold.text-stone-600 Modèle
        dd.text-stone-800 = device.model || "—"
        dt.text-xs.font-semibold.text-stone-600 IP
        dd.font-mono.text-stone-800 = device.ip || "—"
        dt.text-xs.font-semibold.text-stone-600 Dernière remontée
        dd.tabular-nums.text-stone-800 = device.last_seen_at ? device.last_seen_at.in_time_zone.strftime("%d/%m/%Y à %H:%M") : "—"
