/ Un message du fil (phase 11) : initiales, auteur, date relative (date exacte
  en infobulle), corps avec ses retours à la ligne. On ne supprime que les
  siens ; supprimer le premier message supprime le fil et le point.
li.flex.gap-3 id=dom_id(comment) data-comment-id=comment.id
  span[class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-forest-tint text-xs font-semibold text-forest"
       aria-hidden="true"]
    = map_comment_initials(comment.author)
  .min-w-0.flex-1
    .flex.items-baseline.gap-2
      span.truncate.text-sm.font-semibold.text-stone-800 = comment.author.display_name
      time.shrink-0.text-xs.text-stone-500 datetime=comment.created_at.iso8601 title=map_comment_exact_time(comment.created_at)
        = map_comment_relative_time(comment.created_at)
    p.mt-0.5.whitespace-pre-line.break-words.text-sm.text-stone-700 data-comment-body="true" = comment.body
    - if comment.removable_by?(current_user)
      = button_to "Supprimer", map_comment_path(comment), method: :delete,
                  class: "mt-1 text-xs font-medium text-stone-400 underline-offset-2 hover:text-red-700 hover:underline",
                  form: { data: { turbo_confirm: (comment.root? ? "Supprimer ce commentaire, tout son fil et son point ?" : "Supprimer ce message ?") } },
                  data: { comment_action: "delete" }
