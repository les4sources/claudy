.border-l-8.border-indigo-700.-ml-4.pl-4.md:p-0.md:m-0.md:border-0.grid.grid-cols-1.md:grid-cols-3.md:gap-4
  .md:border-r-8.md:border-indigo-700.md:pr-4.md:text-right
    = section_heading_tw heading: "Informations"

  .col-span-2.mb-4.space-y-6.sm:space-y-5
    = f.text_field :name,
                   label: "Nom *",
                   required: true,
                   class: "md:w-1/2 lg:w-2/3"

    = f.number_field :price,
                     label: "Prix",
                     required: true,
                     value: ((f.object.price_cents / 100.0) rescue nil),
                     class: "w-1/2 md:w-1/2 lg:w-1/4",
                     step: "0.01"

    / Compte de recette (Michael, 2026-10-23) : une ligne de séjour reprise
      de ce service y est ventilée (700006 pour le disc-golf). Vide : les
      services annexes du plan comptable par défaut.
    div(class="relative md:w-1/2 lg:w-2/3" data-controller="searchable-select" data-searchable-select-placeholder-value="Chercher un compte…" data-searchable-select-clearable-value="true")
      = f.label :general_account_id, "Compte de recette", class: "block text-sm font-medium text-gray-700"
      = f.select :general_account_id,
                 options_for_select(GeneralAccount.in_class(7).actives.ordered.map { |compte| ["#{compte.code} #{compte.name}", compte.id] }, f.object.general_account_id),
                 { include_blank: "— Services annexes (par défaut) —" },
                 class: "mt-1 w-full rounded-md border-gray-300 shadow-sm sm:text-sm",
                 data: { "searchable-select-target": "select" }
      = render "shared/searchable_select_search", label: "Compte de recette"
      p.mt-1.text-xs.text-gray-500 Le compte sur lequel la compta range ce service quand il est ajouté à un séjour.

    .flex.space-x-4
      - if f.object.photo?
        = image_tag f.object.photo_url(:thumb),
                    class: "inline-block rounded-md"
      div
        = f.file_field :photo,
                       label: "Photo",
                       hint: "Un fichier au format JPG, PNG ou GIF"
        = f.hidden_field :photo_cache

    = f.text_field :summary,
                   label: "Résumé",
                   class: "md:w-1/2 lg:w-2/3"

    = f.label :description, 
              "Présentation du service"
    = f.rich_text_area :description

    = f.label :human_id, "Fournisseur·euse de ce service"
    = f.collection_radio_buttons :human_id, Human.all.order(:name), :id, :name, required: true do |radio_button|
      .flex.items-center
        = radio_button.radio_button
        = radio_button.label(class: "ml-3 block text-sm font-medium text-gray-700")

hr
