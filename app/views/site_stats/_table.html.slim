/ Un tableau de classement du tableau de bord « Site web ».
  title, rows (hashes), columns : [[clé, libellé, :text|:number|:percent], …],
  empty : la phrase affichée sans ligne, note (facultative) sous le titre.
section.rounded-xl.border.border-stone-200.bg-white.shadow-sm.overflow-hidden
  .px-5.py-3.border-b.border-stone-100.bg-stone-50
    h2.text-base.font-semibold.text-stone-900 = title
    - if local_assigns[:note]
      p.mt-0.5.text-xs.text-stone-500 = note
  - if rows.empty?
    p.px-5.py-6.text-sm.text-stone-500 = local_assigns.fetch(:empty, "Rien sur cette période.")
  - else
    .overflow-x-auto
      table.min-w-full.text-sm
        thead
          tr.text-xs.uppercase.tracking-wide.text-stone-500
            - columns.each_with_index do |(_, label, type), index|
              th.px-5.py-2.font-medium(class="#{type == :text ? 'text-left' : 'text-right'}" scope="col") = label
        tbody.divide-y.divide-stone-100
          - rows.each do |row|
            tr
              - columns.each do |key, _, type|
                - value = row[key]
                - case type
                - when :number
                  td.px-5.py-2.text-right.tabular-nums.text-stone-700 = number_with_delimiter(value)
                - when :percent
                  td.px-5.py-2.text-right.tabular-nums.text-stone-500 = value.nil? ? "—" : "#{number_with_precision(value, precision: 1, strip_insignificant_zeros: true)} %"
                - else
                  td.px-5.py-2.text-stone-800.break-all = value
