/ L'éditeur visuel du Guide (Tiptap, cf. `guide_editor_controller.js`). La
  source de vérité est le <textarea> : il porte le Markdown soumis, et c'est
  lui qu'on édite en mode « Markdown ». Sans JavaScript, il reste utilisable.
- tb = "inline-flex h-8 min-w-[2rem] items-center justify-center rounded px-1.5 text-sm text-stone-600 hover:bg-stone-200/70 hover:text-stone-900 aria-pressed:bg-emerald-100 aria-pressed:text-emerald-800"
- sep = "mx-1 h-5 w-px bg-stone-300"

label.mb-1.block.text-sm.font-medium.text-gray-700(for="guide_page_body") Contenu
.guide-editor.rounded-lg.border.border-stone-300.bg-white.shadow-sm.focus-within:border-emerald-500(data-controller="guide-editor"
                                                                                                  data-guide-editor-upload-url-value=rails_direct_uploads_path
                                                                                                  data-action="dragover->guide-editor#dragOver dragleave->guide-editor#dragLeave drop->guide-editor#drop")
  .sticky.top-0.z-10.flex.flex-wrap.items-center.gap-0.5.rounded-t-lg.border-b.border-stone-200.bg-stone-50.px-2.py-1.5(data-guide-editor-target="toolbar")
    .flex.flex-wrap.items-center.gap-0.5(data-guide-editor-target="visualTools")
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="paragraph" title="Texte normal") ¶
      button(type="button" class="#{tb} font-semibold" data-action="guide-editor#run" data-guide-editor-command-param="h2" title="Titre de section") T1
      button(type="button" class="#{tb} font-semibold text-xs" data-action="guide-editor#run" data-guide-editor-command-param="h3" title="Sous-titre") T2
      span(class=sep)
      button(type="button" class="#{tb} font-bold" data-action="guide-editor#run" data-guide-editor-command-param="bold" title="Gras (Ctrl+B)") B
      button(type="button" class="#{tb} italic" data-action="guide-editor#run" data-guide-editor-command-param="italic" title="Italique (Ctrl+I)") I
      button(type="button" class="#{tb} line-through" data-action="guide-editor#run" data-guide-editor-command-param="strike" title="Barré") S
      button(type="button" class="#{tb} font-mono text-xs" data-action="guide-editor#run" data-guide-editor-command-param="code" title="Code") &lt;/&gt;
      span(class=sep)
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="bulletList" title="Liste à puces")
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
          path(d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01")
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="orderedList" title="Liste numérotée")
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
          path(d="M10 6h10M10 12h10M10 18h10M4 4v4M3 8h2M3 14h2l-2 3h2")
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="taskList" title="Liste de cases à cocher")
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
          rect(x="3" y="4" width="6" height="6" rx="1")
          path(d="m4.5 7 1 1 2-2M13 7h8M13 17h8")
          rect(x="3" y="14" width="6" height="6" rx="1")
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="blockquote" title="Encadré / citation")
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor")
          path(d="M7 7h4v4H8.5c0 1.7.8 2.6 2.5 3v2c-3-.4-4-2.4-4-5V7Zm7 0h4v4h-2.5c0 1.7.8 2.6 2.5 3v2c-3-.4-4-2.4-4-5V7Z")
      span(class=sep)
      button(type="button" class=tb data-action="guide-editor#link" title="Lien")
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
          path(d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7")
          path(d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7")
      button(type="button" class=tb data-action="guide-editor#pickImage" title="Image (ou glisse-la, ou colle-la)")
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
          rect(x="3" y="3" width="18" height="18" rx="2")
          circle(cx="9" cy="9" r="2")
          path(d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21")
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="table" title="Tableau")
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
          rect(x="3" y="4" width="18" height="16" rx="1")
          path(d="M3 10h18M3 15h18M10 4v16")
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="horizontalRule" title="Séparateur") ―
      span(class=sep)
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="undo" title="Annuler (Ctrl+Z)") ↶
      button(type="button" class=tb data-action="guide-editor#run" data-guide-editor-command-param="redo" title="Rétablir (Ctrl+Maj+Z)") ↷

      / Gestes du tableau, visibles seulement quand le curseur est dedans.
      .hidden.items-center.gap-0.5(data-guide-editor-target="tableTools")
        span(class=sep)
        button(type="button" class="#{tb} text-xs" data-action="guide-editor#run" data-guide-editor-command-param="addRowAfter" title="Ajouter une ligne") + ligne
        button(type="button" class="#{tb} text-xs" data-action="guide-editor#run" data-guide-editor-command-param="addColumnAfter" title="Ajouter une colonne") + colonne
        button(type="button" class="#{tb} text-xs" data-action="guide-editor#run" data-guide-editor-command-param="deleteRow" title="Supprimer la ligne") − ligne
        button(type="button" class="#{tb} text-xs" data-action="guide-editor#run" data-guide-editor-command-param="deleteColumn" title="Supprimer la colonne") − colonne
        button(type="button" class="#{tb} text-xs text-red-600" data-action="guide-editor#run" data-guide-editor-command-param="deleteTable" title="Supprimer le tableau") Supprimer

    .ml-auto
      button(type="button" class="#{tb} gap-1 text-xs font-medium" data-action="guide-editor#toggleSource" data-guide-editor-target="sourceToggle" aria-pressed="false" title="Voir et modifier le Markdown")
        | Markdown

  .px-6.py-5(data-guide-editor-target="editor")
  = text_area_tag "guide_page[body]", f.object.body,
                  id: "guide_page_body",
                  rows: 24,
                  spellcheck: "true",
                  class: "w-full align-top rounded-b-lg border-0 px-6 py-5 font-mono text-sm leading-relaxed text-stone-800 focus:ring-0",
                  data: { guide_editor_target: "source" }
  input.hidden(type="file" accept="image/*" multiple=true data-guide-editor-target="file" data-action="change->guide-editor#upload")

  .flex.items-center.justify-between.gap-4.rounded-b-lg.border-t.border-stone-100.bg-stone-50.px-4.py-2.text-xs.text-stone-500
    span(data-guide-editor-target="status") Glisse ou colle une image directement dans le texte.
    span.hidden.sm:inline Mise en forme Markdown : **gras**, # titre, - liste…
