- chapters = GuideChapter.ordered.map { |chapter| [chapter.title, chapter.id] }

= form_with model: page, url: (page.persisted? ? guide_page_path(page) : guide_pages_path), class: "max-w-5xl" do |f|
  - if page.errors.any?
    .mb-6.rounded-lg.border.border-red-200.bg-red-50.px-4.py-3.text-sm.text-red-800
      = page.errors.full_messages.to_sentence

  .grid.gap-4.md:grid-cols-3
    .md:col-span-2
      = f.text_field :title, label: "Titre", required: true, autofocus: page.new_record?,
                     placeholder: "Ex. Soumettre une note de frais"
    div(data-controller="searchable-select" data-searchable-select-placeholder-value="Chercher un chapitre…" class="relative")
      = f.select :guide_chapter_id, chapters, { label: "Chapitre" }, { data: { searchable_select_target: "select" } }
      = render "shared/searchable_select_search", label: "Chercher un chapitre"

  .mt-6
    = render "guide/pages/editor", f: f

  .mt-6.max-w-2xl
    = f.text_field :summary, label: "Ce qui change (facultatif)",
                   placeholder: "Ex. ajout du bac « Admin » pour les tickets",
                   hint: "Inscrit dans l'historique de la page, à côté de ton nom."

  .mt-8.flex.flex-wrap.items-center.justify-between.gap-4.border-t.border-stone-200.pt-6
    .flex.items-center.gap-3
      button.inline-flex.items-center.rounded-lg.bg-emerald-600.px-4.py-2.text-sm.font-medium.text-white.shadow-sm.hover:bg-emerald-700(type="submit")
        = page.persisted? ? "Enregistrer" : "Publier la page"
      = link_to "Annuler", (page.persisted? ? guide_page_path(page) : guide_root_path), class: "text-sm font-medium text-stone-600 hover:underline"
    - if page.persisted?
      = link_to "Retirer la page du Guide", guide_page_path(page),
                class: "text-sm font-medium text-red-600 hover:underline",
                data: { turbo_method: :delete, turbo_confirm: "Retirer « #{page.title} » du Guide ? Son historique est conservé." }
