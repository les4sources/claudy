- headings = @markdown.headings
- last_revision = @page.revisions.first

- content_for :page_header do
  = render "layouts/components/page_header", title: "Le Guide des 4 Sources"

.grid.gap-8(class="lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem]")
  / Sommaire du Guide, la page ouverte en surbrillance.
  nav.hidden.lg:block(aria-label="Sommaire du Guide")
    .sticky.top-4.max-h-screen.overflow-y-auto.pb-8.text-sm
      = link_to "Sommaire", guide_root_path, class: "mb-3 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-stone-500 hover:text-emerald-700"
      - @chapters.each do |chapter|
        .mb-4
          .mb-1.font-semibold.text-stone-800 = chapter.title
          ul.space-y-0.5.border-l.border-stone-200
            - chapter.pages.each do |page|
              li
                - current = page.id == @page.id
                = link_to page.title, guide_page_path(page),
                          class: "-ml-px block border-l-2 py-1 pl-3 #{current ? 'border-emerald-600 font-medium text-emerald-800' : 'border-transparent text-stone-600 hover:border-stone-300 hover:text-stone-900'}",
                          aria: { current: (current ? "page" : nil) }

  = render "article", last_revision: last_revision

  / Table des matières de la page, dès deux intertitres.
  - if headings.size >= 2
    aside.hidden.xl:block
      .sticky.top-4.text-sm
        .mb-2.text-xs.font-semibold.uppercase.tracking-wider.text-stone-500 Sur cette page
        ul.space-y-1
          - headings.each do |heading|
            li(class=(heading.level == 3 ? "pl-3" : nil))
              = link_to heading.text, "##{heading.anchor}", class: "block text-stone-600 hover:text-emerald-700", data: { turbo: false }
