/ Un chapitre du Guide (`GuidePage`) : titre, qui l'a écrit, contenu, ce qui
  y mène, chapitres voisins. Partagé par les deux interfaces.
article.min-w-0
  = link_to @page.chapter.title, guide_chapter_path(@page.chapter), class: "text-xs font-semibold uppercase tracking-wider text-emerald-700 hover:underline"
  .mt-1.flex.flex-wrap.items-start.justify-between.gap-4
    h1.font-averia.text-3xl.font-bold.text-stone-900 = @page.title
    - if guide_writer?
      = link_to edit_guide_page_path(@page), class: "inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-700" do
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
          path(d="M12 20h9")
          path(d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z")
        | Modifier

  / Qui a écrit la page : le dernier éditeur (visage, nom, date) et, à
    côté, tous ceux qui y ont contribué.
  .mt-4.flex.flex-wrap.items-center.justify-between.gap-4.rounded-xl.border.border-stone-200.bg-stone-50.px-4.py-3
    - if @page.last_editor
      .flex.items-center.gap-3
        = guide_avatar(@page.last_editor, size: :lg)
        .text-sm
          .text-stone-500 Dernière modification
          .text-stone-800
            span.font-semibold = @page.last_editor.display_name
            span.text-stone-500 =< "le #{guide_date(@page.last_edited_at)}"
            - if last_revision&.via_claude?
              span.ml-2.inline-flex.items-center.rounded-full.bg-amber-100.px-2.py-0.5.text-xs.font-medium.text-amber-800(title="Écrite par Claude, au nom de #{@page.last_editor.display_name}")
                | via Claude
    .flex.items-center.gap-4
      - if @contributors.size > 1
        .flex.items-center.gap-2
          .flex.-space-x-2
            - @contributors.first(6).each do |user|
              = guide_avatar(user, size: :md, extra: "ring-2 ring-stone-50")
          span.text-xs.text-stone-500 = "#{@contributors.size} contributeur·rices"
      = link_to guide_page_revisions_path(@page), class: "inline-flex items-center gap-1 text-sm font-medium text-stone-600 hover:text-emerald-700" do
        svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
          path(d="M3 12a9 9 0 1 0 3-6.7L3 8")
          path(d="M3 3v5h5")
          path(d="M12 7v5l4 2")
        = "Historique (#{pluralize(@page.revisions.size, "version", plural: "versions")})"

  - if @page.body.blank?
    .mt-8.rounded-xl.border.border-dashed.border-stone-300.p-8.text-center.text-sm.text-stone-500
      | Ce chapitre n'a pas encore de contenu.
  - else
    .guide-content.prose.prose-stone.mt-8.max-w-3xl.prose-headings:font-semibold.prose-a:text-emerald-700.prose-img:rounded-lg.prose-img:shadow-sm
      = @markdown.to_html

  / Ce qui mène à cette page : les écrans de Claudy (« Voir la procédure »)
    et les autres pages du Guide (`[[Titre]]`).
  - if @screen_links.any? || @backlinks.any?
    .mt-12.grid.max-w-3xl.gap-4.sm:grid-cols-2
      - if @screen_links.any?
        .rounded-xl.border.border-stone-200.px-4.py-3
          .text-xs.font-semibold.uppercase.tracking-wider.text-stone-500 S'ouvre depuis les écrans
          ul.mt-2.space-y-1.text-sm
            - @screen_links.each do |link|
              li.flex.items-center.gap-2.text-stone-700
                = render "guide/screen_links/book_icon"
                - name = link.label.presence || link.screen
                / Une adresse avec un identifiant (`/…/12/edit`) mènerait à
                  un seul dossier : l'écran est alors seulement nommé.
                - if link.path.present? && !link.path.match?(%r{/\d+(?:/|\?|\z)})
                  = link_to name, link.path, class: "font-medium text-emerald-700 hover:underline"
                - else
                  span = name
      - if @backlinks.any?
        .rounded-xl.border.border-stone-200.px-4.py-3
          .text-xs.font-semibold.uppercase.tracking-wider.text-stone-500 Chapitres qui renvoient ici
          ul.mt-2.space-y-1.text-sm
            - @backlinks.each do |other|
              li
                = link_to guide_page_path(other), class: "text-stone-700 hover:text-emerald-700 hover:underline" do
                  span.text-stone-400 = "#{other.chapter.title} › "
                  = other.title

  / Chapitre précédent et suivant, dans l'ordre du sommaire.
  - if @previous_page || @next_page
    nav.mt-12.grid.max-w-3xl.gap-4.border-t.border-stone-200.pt-6.sm:grid-cols-2(aria-label="Chapitres voisins")
      div
        - if @previous_page
          = link_to guide_page_path(@previous_page), class: "block rounded-lg border border-stone-200 px-4 py-3 hover:border-emerald-300 hover:bg-emerald-50/40" do
            .text-xs.text-stone-500 ← Précédent
            .font-medium.text-stone-800 = @previous_page.title
      div
        - if @next_page
          = link_to guide_page_path(@next_page), class: "block rounded-lg border border-stone-200 px-4 py-3 text-right hover:border-emerald-300 hover:bg-emerald-50/40" do
            .text-xs.text-stone-500 Suivant →
            .font-medium.text-stone-800 = @next_page.title

