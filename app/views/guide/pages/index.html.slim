- primary_button = "inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white shadow-sm hover:bg-emerald-700"
- secondary_button = "inline-flex items-center gap-1.5 rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm font-medium text-stone-700 shadow-sm hover:bg-stone-50"

- content_for :page_header do
  = render "layouts/components/page_header",
           title: "Le Guide des 4 Sources",
           links: (guide_writer? ? [link_to("Nouveau chapitre", new_guide_chapter_path, class: secondary_button),
                                    link_to("Nouvelle page", new_guide_page_path, class: primary_button)] : [])

p.-mt-4.mb-6.max-w-3xl.text-sm.text-stone-600
  | Le manuel du collectif : les procédures, l'arrivée et le départ, les coordonnées administratives, et tout ce qu'on se transmet pour faire vivre le lieu.

= form_with url: guide_root_path, method: :get, class: "mb-8", data: { turbo_frame: "_top" } do |f|
  .relative.max-w-xl
    .pointer-events-none.absolute.inset-y-0.left-0.flex.items-center.pl-3
      svg.h-4.w-4.text-stone-400(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
        path(stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
    = f.search_field :q,
                     value: @query,
                     placeholder: "Chercher dans le Guide…",
                     autocomplete: "off",
                     class: "w-full rounded-lg border border-stone-200 bg-white py-2.5 pl-10 pr-4 text-sm placeholder:text-stone-400 focus:border-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-100",
                     aria: { label: "Chercher dans le Guide" }

- if @query.present?
  section
    h2.mb-3.text-sm.font-semibold.text-stone-700
      = pluralize(@results.size, "page trouvée", plural: "pages trouvées")
      span.font-normal.text-stone-500 =< "pour « #{@query} »"
    - if @results.empty?
      .rounded-xl.border.border-dashed.border-stone-300.bg-white.p-8.text-center.text-sm.text-stone-600
        | Rien ne correspond.
        = link_to "Revenir au sommaire", guide_root_path, class: "ml-1 text-emerald-700 underline hover:text-emerald-900"
    - else
      ul.max-w-3xl.divide-y.divide-stone-100.rounded-xl.border.border-stone-200.bg-white.shadow-sm
        - @results.each do |page|
          li
            = link_to guide_page_path(page), class: "block px-5 py-4 hover:bg-stone-50" do
              .text-xs.font-semibold.uppercase.tracking-wider.text-emerald-700 = page.chapter.title
              .mt-0.5.font-semibold.text-stone-900 = page.title
              p.mt-1.text-sm.text-stone-600 = page.excerpt

- elsif @chapters.empty?
  .rounded-xl.border.border-dashed.border-stone-300.bg-white.p-10.text-center
    .mb-2.text-4xl 📖
    .text-sm.font-medium.text-stone-700 Le Guide est encore vide.
    - if guide_writer?
      .mt-1.text-xs.text-stone-500 Commence par un chapitre, par exemple « Procédures » ou « Arriver aux 4 Sources ».
      = link_to "Créer le premier chapitre", new_guide_chapter_path, class: "mt-4 #{primary_button}"
    - else
      .mt-1.text-xs.text-stone-500 Les Sourciers y rangeront bientôt les procédures et les infos utiles.

- else
  .grid.gap-8.lg:grid-cols-3
    / Le sommaire. Les rédacteurs y rangent chapitres et pages au
      glisser-déposer (poignée à gauche) ; les autres le lisent.
    .space-y-6.lg:col-span-2(data-controller=(guide_writer? ? "guide-sortable" : nil)
                             data-guide-sortable-url-value=reorder_guide_chapters_path)
      - @chapters.each do |chapter|
        section.rounded-xl.border.border-stone-200.bg-white.shadow-sm(id="chapitre-#{chapter.id}" data-id=chapter.id data-guide-sortable-target="chapter")
          header.flex.items-start.gap-3.border-b.border-stone-100.px-5.py-4
            - if guide_writer?
              button.mt-1.cursor-grab.text-stone-300.hover:text-stone-500(type="button" data-guide-sortable-handle="chapter" title="Glisser pour déplacer le chapitre" aria-label="Déplacer le chapitre")
                svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor")
                  circle(cx="9" cy="6" r="1.5")
                  circle(cx="15" cy="6" r="1.5")
                  circle(cx="9" cy="12" r="1.5")
                  circle(cx="15" cy="12" r="1.5")
                  circle(cx="9" cy="18" r="1.5")
                  circle(cx="15" cy="18" r="1.5")
            .min-w-0.flex-1
              h2.text-lg.font-semibold.text-stone-900 = chapter.title
              - if chapter.description.present?
                p.mt-0.5.text-sm.text-stone-600 = chapter.description
            - if guide_writer?
              .flex.shrink-0.items-center.gap-3.text-xs
                = link_to "Ajouter une page", new_guide_page_path(chapter_id: chapter.id), class: "font-medium text-emerald-700 hover:underline"
                = link_to "Modifier", edit_guide_chapter_path(chapter), class: "font-medium text-stone-500 hover:underline"

          ul.divide-y.divide-stone-100(data-guide-sortable-target="pages" data-url=reorder_pages_guide_chapter_path(chapter))
            - chapter.pages.each do |page|
              li.flex.items-center.gap-3.px-5.py-3.hover:bg-stone-50(data-id=page.id)
                - if guide_writer?
                  button.cursor-grab.text-stone-300.hover:text-stone-500(type="button" data-guide-sortable-handle="page" title="Glisser pour déplacer la page" aria-label="Déplacer la page")
                    svg.h-4.w-4(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor")
                      circle(cx="9" cy="8" r="1.5")
                      circle(cx="15" cy="8" r="1.5")
                      circle(cx="9" cy="16" r="1.5")
                      circle(cx="15" cy="16" r="1.5")
                = link_to guide_page_path(page), class: "min-w-0 flex-1 truncate text-sm font-medium text-stone-800 hover:text-emerald-700" do
                  = page.title
                - if page.last_editor
                  span.hidden.shrink-0.items-center.gap-2.text-xs.text-stone-400.sm:inline-flex(title="Modifiée par #{page.last_editor.display_name} le #{guide_date(page.last_edited_at)}")
                    = guide_avatar(page.last_editor, size: :sm)
                    = l(page.last_edited_at.to_date, format: :short)
            - if chapter.pages.empty?
              li.px-5.py-3.text-sm.italic.text-stone-400(data-guide-sortable-empty)
                | Aucune page dans ce chapitre.

    aside
      .rounded-xl.border.border-stone-200.bg-white.shadow-sm
        h2.border-b.border-stone-100.px-5.py-3.text-sm.font-semibold.text-stone-700 Modifié récemment
        - if @recent_pages.empty?
          p.px-5.py-4.text-sm.text-stone-500 Rien pour l'instant.
        - else
          ul.divide-y.divide-stone-100
            - @recent_pages.each do |page|
              li
                = link_to guide_page_path(page), class: "flex items-start gap-3 px-5 py-3 hover:bg-stone-50" do
                  = guide_avatar(page.last_editor, size: :md)
                  .min-w-0
                    .truncate.text-sm.font-medium.text-stone-800 = page.title
                    .text-xs.text-stone-500
                      = page.last_editor&.display_name
                      | ,
                      =< "il y a #{time_ago_in_words(page.last_edited_at)}"
