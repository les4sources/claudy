- if !@organisation_view.nil?
  nav.border-b.lg:px-6(class="bg-teal-50/70 border-teal-100")
    .max-w-screen-xl.px-4.mx-auto(class="py-2.5")
      .flex.items-center
        ul.flex.flex-row.flex-wrap.font-medium.mt-0.gap-1.text-sm
          li
            = link_to "Vue d'ensemble",
                      organisation_path,
                      class: "px-3 py-1.5 rounded-md transition-colors #{controller_name == 'organisation' && action_name == 'index' ? 'text-4s-main bg-teal-50 font-medium' : 'text-gray-500 hover:text-4s-main hover:bg-teal-50/60'}"
          li
            = link_to "Cycles",
                      cycles_path,
                      class: "px-3 py-1.5 rounded-md transition-colors #{controller_name == 'cycles' ? 'text-4s-main bg-teal-50 font-medium' : 'text-gray-500 hover:text-4s-main hover:bg-teal-50/60'}"
          - Human.cycle_active.roles_enabled.each do |human|
            li
              = link_to human.name,
                        organisation_member_path(human.id),
                        class: "px-3 py-1.5 rounded-md transition-colors #{controller_name == 'organisation' && action_name == 'member' && params[:human_id] == human.id.to_s ? 'text-4s-main bg-teal-50 font-medium' : 'text-gray-500 hover:text-4s-main hover:bg-teal-50/60'}"
