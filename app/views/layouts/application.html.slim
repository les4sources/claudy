doctype html
html(lang="fr")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Claudy
    = csrf_meta_tags
    = csp_meta_tag
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin")
    link(href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet")
    = vite_client_tag
    = vite_javascript_tag "application", "data-turbo-track": "reload"
  / La carte du domaine (epic #348) occupe toute la fenêtre sous la navbar :
    colonne flex sur la hauteur de l'écran, sans padding ni pied de page.
  / `map-read-only` : la carte et ses pages ouvertes en lecture seule (rôle
    Kid), cf. `AccessControl#map_read_only_page?` et `map.css`.
  / `ui-v2` : la nouvelle interface (redesign, Michael 2026-10-24), choisie par
    chacun (`users.new_interface`). Toute la mise en forme vit dans
    `stylesheets/ui_v2.css`, scopée sous `.ui-v2` : l'ancienne interface ne
    bouge pas d'un pixel.
  body.bg-white.overflow-x-clip(id="body-#{controller_name}_#{action_name}" class=[("ui-v2" if new_interface?), ("ui-side-collapsed" if new_interface? && ui_side_collapsed?), ("flex h-[100dvh] flex-col overflow-hidden" if @map_view && !new_interface?), ("ui-v2-map" if @map_view && new_interface?), ("map-read-only" if respond_to?(:map_read_only_page?) && map_read_only_page?)].compact.join(" ").presence)
    = render "layouts/components/tooltips"
    = render "humans/tooltips"

    / = turbo_frame_tag "modal", target: "_top"
    = turbo_frame_tag "modal"

    - if new_interface?
      .ui-app
        = render "layouts/v2/sidebar"
        .ui-main
          = render "layouts/v2/mobile_top"
          .ui-subnavs(data-controller="ui-subnav")
            = render "layouts/components/subnavs"
          - if @map_view
            main.ui-map-main
              = render 'layouts/components/messages'
              = yield
          - else
            main.ui-page
              - if content_for?(:page_header)
                .ui-page-header
                  = yield :page_header

              - if @accounting_view && !@page_guide_inline
                = render "finance/shared/page_guide"

              = render 'layouts/components/messages'
              = yield

              = render 'layouts/components/footer'
        = render "layouts/v2/tabbar"
    - else
      = render "layouts/components/navbar"

      - if @map_view
        main.relative.min-h-0.flex-1
          = render 'layouts/components/messages'
          = yield
      - else
        .p-8
          / sticky page header
          - if content_for?(:page_header)
            .mb-8
              = yield :page_header

          / L'aide de l'écran, sur toute la Comptabilité (2026-10-17) : sous le
            titre, avant le contenu, pour que la personne qui démarre sache à quoi
            sert la page avant d'y agir.
          - if @accounting_view
            = render "finance/shared/page_guide"

          / main content
          = render 'layouts/components/messages'
          = yield

          = render 'layouts/components/footer'
