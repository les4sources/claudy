/ Triage d'un membre à la clôture. locals: report, next_cycle
- human = report.human
- pending = report.pending_actions
- done = report.done_actions
- settled = report.deferred_actions + report.dropped_actions

div.bg-white.rounded-xl.border.border-stone-100 id="closing_member_#{human.id}"
  .px-4.py-3.flex.items-center.gap-3.border-b.border-stone-100
    = render "humans/avatar", human: human, size: "w-8 h-8"
    .font-semibold.text-stone-800 = human.name
    .flex.items-center.gap-3.ml-auto.text-xs.tabular-nums
      span.text-teal-700 = "#{done.size} faite#{'s' if done.size != 1}"
      span.text-stone-300 ·
      span class=(pending.any? ? "text-amber-700 font-semibold" : "text-stone-400") = "#{pending.size} à trancher"
      - if settled.any?
        span.text-stone-300 ·
        span.text-stone-500 = "#{settled.size} tranchée#{'s' if settled.size != 1}"

  - if pending.empty?
    .px-4.py-4.text-sm.text-stone-400.italic Rien à trancher pour #{human.name}.
  - else
    ul.divide-y.divide-stone-50
      - pending.each do |action|
        - style = CycleActionDecorator::CATEGORY_STYLES[action.category] || {}
        - auto = action.rituelle? ? "recréée dans le suivant" : (action.reportee? ? "passera au suivant" : "sera archivée")
        li.flex.items-center.gap-3.px-4.py-2.5 id="closing_action_#{action.id}"
          span class="inline-flex items-center gap-1 text-[0.7rem] px-2 py-0.5 rounded-full #{style[:bg]} #{style[:text]} whitespace-nowrap shrink-0"
            span = style[:icon]
            span = style[:label]
          .flex-1.min-w-0
            .text-sm.text-stone-800.leading-snug = action.label
            div class="text-[0.65rem] text-stone-400"
              = "Par défaut : #{auto}"
              - if action.deferred_before?
                span.deferral-badge.ml-1 = "⟳ ×#{action.deferral_count}"
          - if action.hours.present? && action.hours > 0
            span.text-sm.tabular-nums.text-stone-400.shrink-0 = "#{format('%g', action.hours.to_f)}h"
          .flex.items-center.gap-1.shrink-0
            = button_to settle_cycle_action_path(action, as: "done"), method: :patch, data: { turbo_stream: true }, class: "px-2.5 py-1 rounded-md text-xs font-medium text-teal-700 bg-teal-50 hover:bg-teal-100 transition-colors", title: "Marquer comme faite"
              | ✓ Fait
            - if next_cycle
              = button_to settle_cycle_action_path(action, as: "next"), method: :patch, data: { turbo_stream: true }, class: "px-2.5 py-1 rounded-md text-xs font-medium text-sky-700 bg-sky-50 hover:bg-sky-100 transition-colors", title: "Passer au cycle suivant"
                | → Suivant
            = button_to settle_cycle_action_path(action, as: "drop"), method: :patch, data: { turbo_stream: true }, class: "px-2.5 py-1 rounded-md text-xs font-medium text-stone-600 bg-stone-100 hover:bg-stone-200 transition-colors", title: "Archiver sans la faire"
              | Archiver
