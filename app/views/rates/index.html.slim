- content_for :page_header do
  = render "layouts/components/page_header",
           title: "Tarifs"

- if @grouped_rates.blank?
  .p-6.text-sm.text-gray-500.bg-white.rounded-lg.border.border-gray-100
    p.font-medium.text-gray-700 Aucun tarif paramétré.
    p.mt-1
      | Les prix appliqués sont ceux codés dans le catalogue. Lance
      code.mx-1.px-1.py-0.5.bg-gray-100.rounded rake rates:seed_from_catalog
      | pour les rendre éditables ici.
- else
  .space-y-8
    - @grouped_rates.each do |group_name, rates|
      section
        h2.text-sm.font-semibold.text-gray-700.uppercase.tracking-wide.mb-2
          = group_name
        .overflow-x-auto.relative
          table.w-full.text-sm.text-left.text-gray-500
            thead.text-xs.text-gray-700.uppercase.bg-gray-50
              tr
                th.py-3.px-6[scope="col"]
                  | Tarif
                th.py-3.px-6[scope="col"]
                  | Clé
                th.w-80.py-3.px-6[scope="col"]
                  | Montant
            tbody
              - rates.each do |rate|
                tr.border-b.bg-white
                  td.py-3.px-6.font-medium.text-gray-900[scope="row"]
                    = rate.label.presence || rate.key
                  td.py-3.px-6.text-xs.text-gray-400.font-mono
                    = rate.key
                  td.py-3.px-6
                    = form_with model: rate, url: rate_path(rate), method: :patch, class: "space-y-1.5" do |f|
                      .flex.items-center.gap-2
                        = number_field_tag "rate[amount]",
                                           rate.amount,
                                           step: (rate.percent? ? 1 : 0.01),
                                           min: 0,
                                           class: "w-28 rounded-md border-gray-300 text-sm",
                                           "aria-label" => "Montant pour #{rate.key}"
                        span.text-gray-500
                          = rate.percent? ? "%" : "€"
                        / `f.submit` rend un Button::Component déjà stylé. Lui passer
                        / `bg-white text-gray-700` gagnait sur ses propres classes
                        / (ordre des règles Tailwind) et rendait le bouton blanc sur
                        / blanc, donc invisible — défaut d'affichage hérité de #124.
                        = f.submit "Enregistrer"
                      / Vide = aujourd'hui. Une date future programme le prix sans
                      / toucher à la valeur appliquée aujourd'hui (issue #156).
                      .flex.items-center.gap-2
                        label.text-xs.text-gray-500[for="rate_active_from_#{rate.id}"]
                          | à partir du
                        = date_field_tag "rate[active_from]",
                                         nil,
                                         id: "rate_active_from_#{rate.id}",
                                         class: "w-36 rounded-md border-gray-300 text-xs",
                                         "aria-label" => "Date d'entrée en vigueur pour #{rate.key}"
                    - versions = rate.versions_history
                    - if versions.any?
                      details.mt-2
                        summary.text-xs.text-gray-500.cursor-pointer
                          = "Historique (#{versions.size} version#{'s' if versions.size > 1})"
                        ul.mt-1.space-y-1
                          - versions.each do |version|
                            - decorated = version.decorate
                            li.text-xs.text-gray-500
                              span.font-medium.text-gray-700
                                = decorated.amount
                              span.mx-1 —
                              = decorated.period
                              - if version.note.present?
                                span.ml-1.text-gray-400
                                  = "(#{version.note})"
