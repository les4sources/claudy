/ Une note datée de la fiche plante (phase 7) : la date en clair, l'auteur,
  le corps, et la suppression (soft-delete, confirmée).
- date = plant_note_date(note.noted_on)
li.py-2.5 data-note-id=note.id
  .flex.items-center.gap-2
    time.text-xs.font-semibold.text-stone-700 datetime=note.noted_on.iso8601 = date
    - if note.author
      span.min-w-0.truncate.text-xs.text-stone-400 = note.author.display_name
    = button_to plant_map_note_path(plant, note), method: :delete,
                form: { class: "ml-auto", data: { turbo_confirm: "Supprimer la note du #{date} ?" } },
                class: "flex h-8 w-8 items-center justify-center rounded-full text-lg leading-none text-stone-300 hover:bg-red-50 hover:text-red-600",
                "aria-label": "Supprimer la note du #{date}"
      | ×
  p.mt-0.5.whitespace-pre-line.text-sm.text-stone-800 = note.body
