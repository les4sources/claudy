/ Fiche latérale d'une plante nourricière (epic #348, phase 7).
  Même cadre que la fiche d'un objet (`maps/_feature_panel`) : à droite sur un
  écran large, plein écran sous 768 px — au verger, c'est un téléphone qu'on
  tient. L'en-tête dit l'essentiel d'un coup d'œil (photo, nom, espèce, état) ;
  le dossier se replie en sections, ouvertes seulement quand elles ont une
  erreur, pour que les champs vides n'écrasent pas l'écran.
- saved = local_assigns[:saved]
- unplaced_layer_id = local_assigns[:unplaced_layer_id]
- typed = local_assigns[:typed_names] || {}
- species = plant.plant_species
- variety = plant.plant_variety
- health = plant_health_style(plant)
- photos = plant.photos.select(&:persisted?)
- header_photo = photos.first
- form_id = dom_id(plant, :form)
- errors = plant.errors
- label_css = "block text-xs font-semibold text-stone-600"
- input_css = "mt-1 h-11 w-full rounded-lg border-stone-300 text-sm shadow-sm focus:border-forest focus:ring-forest"
- section_errors = ->(*attrs) { attrs.any? { |a| errors[a].any? } }
- species_value = typed.key?(:species_name) ? typed[:species_name] : species&.name
- variety_value = typed.key?(:variety_name) ? typed[:variety_name] : variety&.name
- price = plant_price_in_euros(plant)
- planted = plant.planted_on ? l(plant.planted_on, format: :long) : plant.planted_year&.to_s
div[class="pointer-events-auto flex h-full flex-col overflow-hidden bg-white shadow-2xl md:rounded-xl md:border md:border-stone-200"
    data-feature-panel="true"
    data-plant-panel=plant.id
    data-feature-id=plant.map_feature_id
    data-layer-id=plant.map_feature&.map_layer_id
    data-feature-saved=(saved && plant.placed? ? "true" : nil)
    data-layer-reload=unplaced_layer_id]
  .relative.flex-1.overflow-y-auto
    / ── En-tête ────────────────────────────────────────────────────────────
    header.relative
      - if header_photo
        = link_to url_for(Plant.photo_source(header_photo, :preview)), target: "_blank", rel: "noopener", class: "block" do
          = image_tag url_for(Plant.photo_source(header_photo, :preview)), alt: plant.display_name,
                      class: "h-44 w-full object-cover"
        .pointer-events-none.absolute.inset-x-0.top-0.h-16.bg-gradient-to-b.from-black/30.to-transparent
      - else
        div[class="flex h-28 items-end justify-between bg-gradient-to-br from-forest-tint via-white to-ember-tint px-4 pb-3"
            style="color: #{health[:dot]}"]
          = plant_stratum_glyph(plant.stratum, css: "h-14 w-14 opacity-80")
      span class="absolute left-3 top-3 rounded-full bg-white/90 px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-forest shadow-sm"
        | Plante
      button[type="button" class="absolute right-2 top-2 flex h-11 w-11 items-center justify-center rounded-full bg-white/90 text-stone-500 shadow-sm hover:bg-white hover:text-stone-800"
             data-action="click->map#closePanel" aria-label="Fermer la fiche"]
        svg.h-5.w-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          line x1="18" y1="6" x2="6" y2="18"
          line x1="6" y1="6" x2="18" y2="18"

    .px-4.pt-3
      .flex.items-start.gap-2
        h2.flex-1.text-lg.font-semibold.leading-snug.text-stone-900 class=(plant.dead? ? "line-through decoration-stone-400" : nil)
          = plant.display_name
        - if plant.number_label
          span class="mt-1 shrink-0 rounded-md bg-stone-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-stone-600" data-plant-number=true
            = "##{plant.number_label}"
      - if species || variety
        p.mt-0.5.text-sm.text-stone-600
          = [species&.name, variety&.name].compact.join(" · ")
          - if species&.latin_name.present?
            span.ml-1.italic.text-stone-400 = species.latin_name
      .mt-2.flex.flex-wrap.gap-1.5
        span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset #{plant.status == 'to_place' ? 'bg-ember-tint text-ember ring-ember/30' : 'bg-white text-stone-600 ring-stone-200'}"
          = plant.status_label
        span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset #{health[:pill]}"
          span.h-2.w-2.rounded-full style="background: #{health[:dot]}"
          = plant.dead? ? "Morte" : (plant.health_label || "Santé ?")
        - if plant.stratum
          span class="inline-flex items-center gap-1 rounded-full bg-white px-2 py-0.5 text-xs font-medium text-stone-600 ring-1 ring-inset ring-stone-200"
            = plant_stratum_glyph(plant.stratum, css: "h-3.5 w-3.5")
            = plant.stratum_label
        - if plant.zone
          span class="inline-flex items-center rounded-full bg-white px-2 py-0.5 text-xs font-medium text-stone-600 ring-1 ring-inset ring-stone-200"
            = plant.zone

    .px-4.pb-6.pt-4
      - if saved
        p.mb-3.rounded-lg.bg-forest-tint.px-3.py-2.text-xs.text-forest Enregistré.
      - if unplaced_layer_id
        p.mb-3.rounded-lg.bg-ember-tint.px-3.py-2.text-xs.text-stone-700
          | Retirée de la carte. Elle attend dans la liste « à placer ».
      - if errors.any?
        .mb-3.rounded-lg.border.border-red-200.bg-red-50.px-3.py-2.text-xs.text-red-800 role="alert"
          ul.list-disc.space-y-0.5.pl-4
            - errors.full_messages.each do |message|
              li = message

      / ── Dossier ────────────────────────────────────────────────────────
      = form_with model: plant, url: plant_path(plant), method: :patch,
                  builder: ActionView::Helpers::FormBuilder,
                  html: { id: form_id, multipart: true, class: "space-y-2", data: { plant_form: true } } do |f|

        details.group.rounded-xl.border.border-stone-200 open=true
          summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2.5"
            span.flex-1.text-sm.font-semibold.text-stone-800 Identité
            svg.h-4.w-4.text-stone-400.transition-transform.group-open:rotate-180 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              polyline points="6 9 12 15 18 9"
          .space-y-3.border-t.border-stone-100.px-3.py-3
            .grid.grid-cols-4.gap-2
              .col-span-3
                = f.label :name, "Nom", class: label_css
                = f.text_field :name, class: input_css, placeholder: "Pommier Reinette Hernaut cl"
              div
                = f.label :number, "N°", class: label_css
                = f.number_field :number, step: "any", min: 0, value: plant.number_label, inputmode: "decimal",
                                 class: input_css, placeholder: "42"
            div[class="relative"
                data-controller="plant-autocomplete"
                data-plant-autocomplete-kind-value="species"
                data-plant-autocomplete-url-value=map_species_path(format: :json)]
              = label_tag "plant_species_name", "Espèce", class: label_css
              = text_field_tag "plant[species_name]", species_value, id: "plant_species_name", class: input_css,
                               placeholder: "Pommier, Néflier…", autocomplete: "off", role: "combobox",
                               "aria-autocomplete": "list", "aria-expanded": "false", "aria-controls": "plant_species_options",
                               data: { plant_autocomplete_target: "input",
                                       action: "input->plant-autocomplete#search focus->plant-autocomplete#search keydown->plant-autocomplete#navigate blur->plant-autocomplete#close" }
              ul#plant_species_options[class="absolute z-30 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-lg border border-stone-200 bg-white py-1 shadow-lg"
                                       role="listbox" data-plant-autocomplete-target="list"]
              p.mt-1.min-h-4.text-xs.italic.text-stone-400 data-plant-autocomplete-target="hint" = species&.latin_name
            div[class="relative"
                data-controller="plant-autocomplete"
                data-plant-autocomplete-kind-value="variety"
                data-plant-autocomplete-url-value=map_species_varieties_path(id: "__ID__", format: :json)
                data-plant-autocomplete-scope-id-value=plant.plant_species_id
                data-action="plant-autocomplete:picked@window->plant-autocomplete#rescope"]
              = label_tag "plant_variety_name", "Variété", class: label_css
              = text_field_tag "plant[variety_name]", variety_value, id: "plant_variety_name", class: input_css,
                               placeholder: "Reinette Hernaut", autocomplete: "off", role: "combobox",
                               "aria-autocomplete": "list", "aria-expanded": "false", "aria-controls": "plant_variety_options",
                               data: { plant_autocomplete_target: "input",
                                       action: "input->plant-autocomplete#search focus->plant-autocomplete#search keydown->plant-autocomplete#navigate blur->plant-autocomplete#close" }
              ul#plant_variety_options[class="absolute z-30 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-lg border border-stone-200 bg-white py-1 shadow-lg"
                                       role="listbox" data-plant-autocomplete-target="list"]
              p.mt-1.min-h-4.text-xs.text-stone-400 data-plant-autocomplete-target="hint"
            div
              = f.label :zone, "Zone", class: label_css
              = f.text_field :zone, list: "plant_zones", class: input_css, placeholder: "Verger, Potager…", autocomplete: "off"
              datalist#plant_zones
                - Plant.zones.each do |zone|
                  option value=zone

        details.group.rounded-xl.border.border-stone-200 open=(section_errors.(:status, :health, :production, :stratum, :habit, :population) || nil)
          summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2.5"
            span.text-sm.font-semibold.text-stone-800 État
            span.flex-1.truncate.text-xs.text-stone-400 = plant_section_summary(plant.status_label, plant.health_label, plant.production_label && "production #{plant.production_label.downcase}")
            svg.h-4.w-4.text-stone-400.transition-transform.group-open:rotate-180 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              polyline points="6 9 12 15 18 9"
          .grid.grid-cols-2.gap-3.border-t.border-stone-100.px-3.py-3
            div
              = f.label :status, "Statut", class: label_css
              = f.select :status, Plant::STATUSES.map { |key, label| [label, key] }, {}, class: input_css
            div
              = f.label :health, "Santé", class: label_css
              = f.select :health, Plant::HEALTHS.map { |key, label| [label, key] }, { include_blank: "—" }, class: input_css
            div
              = f.label :production, "Production", class: label_css
              = f.select :production, Plant::PRODUCTIONS.map { |key, label| [label, key] }, { include_blank: "—" }, class: input_css
            div
              = f.label :stratum, "Strate", class: label_css
              = f.select :stratum, Plant::STRATA.map { |key, label| [label, key] }, { include_blank: "—" }, class: input_css
            div
              = f.label :habit, "Port", class: label_css
              = f.select :habit, Plant::HABITS.map { |key, label| [label, key] }, { include_blank: "—" }, class: input_css
            div
              = f.label :population, "Population", class: label_css
              = f.select :population, Plant::POPULATIONS.map { |key, label| [label, key] }, { include_blank: "—" }, class: input_css

        details.group.rounded-xl.border.border-stone-200 open=(section_errors.(:nursery, :stock_type, :plant_count, :purchase_price_cents, :notion_url) || nil)
          summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2.5"
            span.text-sm.font-semibold.text-stone-800 Origine
            span.flex-1.truncate.text-xs.text-stone-400 = plant_section_summary(plant.nursery, plant.stock_type_label, price && "#{price} €", plant.plant_count && plant.plant_count > 1 ? "× #{plant.plant_count}" : nil)
            svg.h-4.w-4.text-stone-400.transition-transform.group-open:rotate-180 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              polyline points="6 9 12 15 18 9"
          .grid.grid-cols-2.gap-3.border-t.border-stone-100.px-3.py-3
            .col-span-2
              = f.label :nursery, "Pépinière", class: label_css
              = f.text_field :nursery, list: "plant_nurseries", class: input_css, autocomplete: "off"
              datalist#plant_nurseries
                - Plant.where.not(nursery: nil).distinct.order(:nursery).pluck(:nursery).each do |nursery|
                  option value=nursery
            div
              = f.label :stock_type, "Type de plant", class: label_css
              = f.select :stock_type, Plant::STOCK_TYPES.map { |key, label| [label, key] }, { include_blank: "—" }, class: input_css
            div
              = f.label :plant_count, "Nombre de plants", class: label_css
              = f.number_field :plant_count, min: 1, step: 1, inputmode: "numeric", class: input_css
            .col-span-2
              = label_tag "plant_purchase_price", "Prix d'achat", class: label_css
              .relative
                = text_field_tag "plant[purchase_price]", price, id: "plant_purchase_price", inputmode: "decimal",
                                 placeholder: "24,50", class: "#{input_css} pr-8"
                span.pointer-events-none.absolute.right-3.top-1/2.mt-0.5.-translate-y-1/2.text-sm.text-stone-400 €
            .col-span-2
              = f.label :notion_url, "Lien Notion", class: label_css
              = f.url_field :notion_url, class: input_css, placeholder: "https://www.notion.so/…"

        details.group.rounded-xl.border.border-stone-200 open=(section_errors.(:planted_on, :planted_year, :altitude) || nil)
          summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2.5"
            span.text-sm.font-semibold.text-stone-800 Plantation
            span.flex-1.truncate.text-xs.text-stone-400 = plant_section_summary(planted && "plantée #{plant.planted_on ? 'le' : 'en'} #{planted}", plant.altitude && "#{plant.altitude} m")
            svg.h-4.w-4.text-stone-400.transition-transform.group-open:rotate-180 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              polyline points="6 9 12 15 18 9"
          .grid.grid-cols-2.gap-3.border-t.border-stone-100.px-3.py-3
            .col-span-2
              = f.label :planted_on, "Date de plantation", class: label_css
              = f.date_field :planted_on, class: input_css
            div
              = f.label :planted_year, "ou l'année seule", class: label_css
              = f.number_field :planted_year, min: 1801, step: 1, inputmode: "numeric", class: input_css, placeholder: Date.current.year
            div
              = f.label :altitude, "Altitude (m)", class: label_css
              = f.number_field :altitude, step: 1, inputmode: "numeric", class: input_css

        details.group.rounded-xl.border.border-stone-200 open=(plant[:notes].present? || nil)
          summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2.5"
            span.flex-1.text-sm.font-semibold.text-stone-800 Notes
            svg.h-4.w-4.text-stone-400.transition-transform.group-open:rotate-180 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              polyline points="6 9 12 15 18 9"
          .border-t.border-stone-100.px-3.py-3
            / `plant[:notes]` : `Plant#notes` est l’association des notes datées.
            = f.text_area :notes, value: plant[:notes], rows: 4, placeholder: "Porte-greffe, pollinisateurs, historique…",
                          class: "w-full rounded-lg border-stone-300 text-sm shadow-sm focus:border-forest focus:ring-forest"

        / Toujours à portée de pouce pendant la saisie.
        .sticky.bottom-0.z-10.-mx-4.border-t.border-stone-100.bg-white/95.px-4.py-3.backdrop-blur
          button[type="submit" class="h-11 w-full rounded-lg bg-forest text-sm font-semibold text-white hover:bg-forest-soft"] Enregistrer

      / ── Photos ─────────────────────────────────────────────────────────
        Le champ appartient au formulaire du dossier (attribut `form`) : choisir
        des photos les envoie aussitôt, avec la saisie en cours.
      section.mt-6 data-plant-section="photos"
        p class="mb-2 text-[0.65rem] font-semibold uppercase tracking-wide text-stone-400" = "Photos (#{photos.size})"
        ul.grid.grid-cols-3.gap-2
          - photos.each do |photo|
            li.group.relative
              = link_to url_for(Plant.photo_source(photo, :preview)), target: "_blank", rel: "noopener" do
                = image_tag url_for(Plant.photo_source(photo, :thumb)), alt: photo.filename.to_s, loading: "lazy",
                            class: "aspect-square w-full rounded-lg object-cover ring-1 ring-stone-200"
              = button_to photo_plant_path(plant, photo_id: photo.id), method: :delete,
                          form: { data: { turbo_confirm: "Retirer cette photo ?" } },
                          class: "absolute right-1 top-1 flex h-7 w-7 items-center justify-center rounded-full bg-white/90 text-stone-500 shadow hover:text-red-600",
                          "aria-label": "Retirer la photo" do
                | ×
          li
            label class="flex aspect-square w-full cursor-pointer flex-col items-center justify-center gap-1 rounded-lg border-2 border-dashed border-stone-300 text-stone-500 hover:border-forest hover:text-forest"
              svg.h-6.w-6 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"
                circle cx="12" cy="13" r="3"
              span.text-xs.font-medium Ajouter
              = file_field_tag "plant[photos][]", multiple: true, form: form_id, class: "sr-only",
                               accept: Plant.accepted_photo_types.join(","),
                               onchange: "this.form && this.form.requestSubmit()"

      / TODO phase 7 B2 — Récolte : grille parties × mois, « hérité de l'espèce »
        tant que la plante n'a pas de fenêtre propre, bouton pour surcharger.
      section.mt-6 id=dom_id(plant, :harvest) data-plant-section="harvest"

      / TODO phase 7 B2 — Notes datées : liste antéchronologique, ajout inline
        avec la date (`MapNote`, sujet = la plante).
      section.mt-6 id=dom_id(plant, :notes) data-plant-section="notes"

      / TODO phase 7 B2 — Tâches : `MapTask` de filière `nourricier` par défaut,
        même composant qu'en phase 6 (`maps/_feature_tasks`).
      section.mt-6 id=dom_id(plant, :tasks) data-plant-section="tasks"

      / ── Actions ────────────────────────────────────────────────────────
      .mt-8.space-y-2.border-t.border-stone-100.pt-4
        - if plant.notion_url.present?
          = link_to plant.notion_url, target: "_blank", rel: "noopener",
                    class: "flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-stone-200 text-sm font-medium text-stone-700 hover:bg-stone-50" do
            | Ouvrir la fiche Notion
            svg.h-4.w-4 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              path d="M7 17 17 7M8 7h9v9"
        - if plant.placed?
          = button_to unplace_plant_path(plant), method: :post,
                      form: { data: { turbo_confirm: "Retirer « #{plant.display_name} » de la carte ? Elle retournera dans la liste « à placer »." } },
                      class: "flex h-11 w-full items-center justify-center rounded-lg border border-stone-200 text-sm font-medium text-stone-700 hover:bg-stone-50"
            | Retirer de la carte
        = button_to plant_path(plant), method: :delete,
                    form: { data: { turbo_confirm: "Supprimer « #{plant.display_name} » ? Sa fiche, ses photos et son point disparaissent de la carte." } },
                    class: "flex h-11 w-full items-center justify-center rounded-lg text-sm font-medium text-red-600 hover:bg-red-50"
          | Supprimer la plante

      .mt-4.text-xs.text-stone-400
        p = "Ajoutée #{plant.created_by ? "par #{plant.created_by.display_name} " : ''}le #{l(plant.created_at.to_date, format: :long)}"
        - if plant.updated_at > plant.created_at + 1.second
          p = "Modifiée le #{l(plant.updated_at.to_date, format: :long)}"
