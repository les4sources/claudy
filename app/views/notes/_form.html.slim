= f.text_area :body,
              rows: 3

/ Les types vivent dans Note::TYPES — ajouter une couleur là-bas suffit.
- type_choices = Note::TYPES.map { |color, label| [raw(%(<span class="px-2 py-1 bg-#{color}-200 rounded-md border border-white hover:border hover:border-#{color}-500">#{ERB::Util.html_escape(label)}</span>)), color] }

.space-y-2
  = f.label :color,
            "Type de note"
  .space-y-4
    = f.collection_radio_buttons :color,
                                 type_choices,
                                 :last, :first,
                                 required: true do |radio_button|
      .flex.items-center
        = radio_button.radio_button
        = radio_button.label(class: "ml-2 block text-sm font-medium text-gray-700")

.hidden
  = f.text_field :date
