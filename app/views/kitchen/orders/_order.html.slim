/ Une demande. Lue au téléphone depuis la cuisine autant qu'au bureau : tout
  s'empile en colonne sur petit écran, les actions passent dessous.
li.border-t.border-gray-100(class="first:border-t-0")
  .flex.flex-wrap.items-start.justify-between.gap-3.px-4.py-3
    .min-w-0.flex-1
      .flex.flex-wrap.items-center.gap-2
        span.text-sm.font-semibold.text-gray-900 = order.date_label
        = order.status_badge
        = order.validation_badge
      .mt-1.flex.flex-wrap.items-center.gap-x-2.text-sm.text-gray-700
        span = order.label
        span.text-gray-300 ·
        span = order.people_label
        span.text-gray-300 ·
        span.font-medium = order.price
      .mt-0.5.text-xs
        - if order.responsible_missing?
          span.text-amber-700 Personne ne s'en charge
        - else
          span.text-gray-500 = "#{order.responsible_label} s'en charge"
      - if order.notes_short.present?
        p.mt-1.text-sm.text-gray-500(title=order.notes) = order.notes_short
      - if order.reason.present?
        p.mt-1.text-sm.text-red-700 = order.reason

    .flex.flex-wrap.items-center.gap-1.5.shrink-0
      - unless order.cancelled?
        - if order.responsible_missing? && current_user&.human
          = button_to "Je m'en charge", assign_kitchen_order_path(order), method: :patch, params: { human_id: current_user.human_id }, class: "rounded-md bg-4s-main px-2.5 py-1 text-xs font-medium text-white hover:opacity-90"
        - if order.inquiry?
          = button_to "Ferme", status_kitchen_order_path(order), method: :patch, params: { status: "requested" }, class: "rounded-md bg-white px-2.5 py-1 text-xs font-medium text-gray-700 ring-1 ring-gray-300 hover:bg-gray-50"
        - unless order.confirmed?
          = button_to "Confirmer", status_kitchen_order_path(order), method: :patch, params: { status: "confirmed" }, class: "rounded-md bg-white px-2.5 py-1 text-xs font-medium text-gray-700 ring-1 ring-gray-300 hover:bg-gray-50"
      = link_to "Modifier", edit_kitchen_order_path(order), class: "rounded-md bg-white px-2.5 py-1 text-xs font-medium text-gray-700 ring-1 ring-gray-300 hover:bg-gray-50"

  / Les deux gestes qui demandent une précision — qui s'en charge, et pourquoi
    on annule — sont repliés : rarement utilisés, jamais cachés. Les comptes sont
    partagés (décision Michael) : on nomme donc toujours la personne, on ne
    déduit pas du compte connecté.
  - unless order.cancelled?
    .flex.flex-wrap.gap-x-6.gap-y-1.px-4.pb-3
      details
        summary.cursor-pointer.text-xs.text-gray-400(class="hover:text-gray-700")
          = order.responsible_missing? ? "Qui s'en charge ?" : "Confier à quelqu'un d'autre"
        = form_with url: assign_kitchen_order_path(order), method: :patch, class: "mt-2 flex flex-wrap items-center gap-2" do
          = select_tag :human_id, options_from_collection_for_select(@humans, :id, :name, order.responsible_human_id), include_blank: "— Choisir —", class: "rounded-md border-gray-300 text-sm"
          = submit_tag "Confier", class: "rounded-md bg-4s-main px-3 py-1.5 text-xs font-medium text-white hover:opacity-90"

      details
        summary.cursor-pointer.text-xs.text-gray-400(class="hover:text-red-600") Annuler cette demande
        = form_with url: status_kitchen_order_path(order), method: :patch, class: "mt-2 flex flex-wrap items-center gap-2" do
          = hidden_field_tag :status, "cancelled"
          = text_field_tag :cancellation_reason, nil, required: true, placeholder: "Motif de l'annulation", class: "min-w-0 flex-1 rounded-md border-gray-300 text-sm"
          = submit_tag "Annuler", class: "rounded-md bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-700"
