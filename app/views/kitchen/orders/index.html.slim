- content_for :page_header do
  = render "layouts/components/page_header",
           title: "Cuisine",
           links: [link_to("Reporting", kitchen_reporting_path, class: "btn-page-header-with-icon"),
                   link_to("Nouvelle demande", new_kitchen_order_path, class: "inline-flex items-center rounded-md bg-4s-main px-4 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90")]

/ DEUX VUES, Cuisine et Accueil (2026-10-19), au lieu de sept onglets qui se
  recoupaient. Chaque vue montre toutes les demandes à venir, UNE fois, rangées
  par statut (`MealOrder#board_status`) ; l'ordre des sections et les gestes
  changent selon qui regarde. Le passé et les annulés sont en pied de page.
- chip_on  = "rounded-full bg-4s-main px-3 py-1.5 text-sm font-medium text-white"
- chip_off = "rounded-full border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:border-gray-400"
.space-y-8
  .flex.flex-wrap.items-center.gap-4
    nav.inline-flex.gap-1.rounded-xl.bg-gray-200.p-1(aria-label="Vue")
      - Kitchen::OrdersController::VIEWS.each do |view|
        - active = view[:key] == @view
        - todo = @counts[view[:key]]
        = link_to kitchen_orders_path(view: view[:key]),
                  "aria-current": (active ? "page" : nil),
                  class: "inline-flex min-h-[40px] items-center gap-2 rounded-lg px-4 text-[15px] #{active ? 'bg-white font-semibold text-gray-900 shadow-sm' : 'font-medium text-gray-600 hover:text-gray-900'}" do
          = view[:title]
          - if todo.positive?
            - if view[:key] == :kitchen
              = board_status_badge("to_validate", "#{todo} à valider")
            - else
              = board_status_badge("to_cover", "#{todo} à traiter")

    - if @view.in?(%i[kitchen reception])
      .flex.flex-wrap.items-center.gap-2.text-sm.text-gray-600
        span = "À partir d'aujourd'hui, #{l(Date.current, format: '%A %-d %B')}"
        span.text-gray-300 ·
        - if @view == :kitchen
          /  La famille dans la vue Cuisine : qui cuisine quoi.
          - [[nil, "Tout"], ["repas", "Repas"], ["buffet", "Buffets"], ["apero", "Apéros"]].each do |value, label|
            = link_to label, kitchen_orders_path(view: @view, family: value, responsible_human_id: @responsible), class: (@family == value ? chip_on : chip_off)
        - else
          /  L'origine dans la vue Accueil (epic #321, phase 2) : qui relancer.
          - [[nil, "Toutes origines"]].concat(MealOrder::ORIGINS.map { |o| [o, MealOrder::ORIGIN_LABELS[o]] }).each do |value, label|
            = link_to label, kitchen_orders_path(view: @view, origin: value, responsible_human_id: @responsible), class: (@origin == value ? chip_on : chip_off)
    - else
      = link_to "← Retour aux demandes à venir", kitchen_orders_path, class: "text-sm font-medium text-4s-main hover:underline"

  - if @sections
    - @sections.each do |status, orders|
      section.space-y-3(id="section-#{status}")
        .flex.flex-wrap.items-baseline.gap-3
          h2 = board_status_badge(status, "#{MealOrder::BOARD_STATUS_LABELS[status]} · #{orders.size}")
          p(class="text-[15px] text-gray-700") = board_section_hint(@view, status)
        - if orders.any?
          = render "kitchen/orders/board_table", orders: orders, status: status, columns: board_columns(@view, status),
                   by_day: (@view == :kitchen && status == "planned")
          - if @show_money && status == "planned"
            p.text-right.text-sm.text-gray-600
              | Total facturable :
              strong.ml-1.text-gray-900 = humanized_money_with_symbol(Money.new(@total_cents))
  - else
    section.space-y-3
      h2.text-lg.font-semibold.text-gray-900 = Kitchen::OrdersController::ARCHIVE_VIEWS.find { |v| v[:key] == @view }[:title]
      - if @rows.empty?
        p.text-sm.text-gray-500 Rien ici.
      - else
        = render "kitchen/orders/board_table", orders: @rows, status: nil, columns: board_columns(@view, nil), by_day: false
      - if @view == :past && !@old_archives
        = link_to "Voir les archives de plus de 12 mois", kitchen_orders_path(view: :past, old_archives: 1), class: "text-xs text-gray-500 hover:underline"

  .flex.flex-wrap.gap-3.border-t.border-gray-200.pt-5
    - Kitchen::OrdersController::ARCHIVE_VIEWS.each do |view|
      - active = view[:key] == @view
      = link_to kitchen_orders_path(view: view[:key]),
                class: "inline-flex min-h-[40px] items-center gap-2 rounded-lg border px-3.5 text-sm #{active ? 'border-4s-main text-4s-main' : 'border-gray-300 bg-white text-gray-700 hover:border-gray-400'}" do
        = view[:title]
        span.text-gray-500 = @counts[view[:key]]
