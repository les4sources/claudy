- content_for :page_header do
  = render "layouts/components/page_header",
           title: "Cuisine",
           links: [link_to("Reporting", kitchen_reporting_path, class: "btn-page-header-with-icon"),
                   link_to("Nouvelle demande", new_kitchen_order_path, class: "inline-flex items-center rounded-md bg-4s-main px-4 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90")]

.space-y-6
  = render "kitchen/orders/filters"

  - @sections.each do |section|
    section
      .flex.items-baseline.justify-between.gap-3
        h2.text-sm.font-semibold.uppercase.tracking-wide.text-gray-700 = section[:title]
        span.text-xs.text-gray-400 = section[:blurb]

      - if section[:groups].empty?
        p.mt-2.rounded-lg.border.border-dashed.border-gray-300.px-4.py-4.text-sm.text-gray-500
          | Rien ici.
      - else
        .mt-2.space-y-3
          - section[:groups].each do |group|
            = render "kitchen/orders/group", group: group
