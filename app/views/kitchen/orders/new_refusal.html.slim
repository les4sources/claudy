- content_for :page_header do
  = render "layouts/components/page_header", title: "Pas possible"

.max-w-2xl.space-y-4
  section.rounded-2xl.bg-white.ring-1.ring-gray-200.px-5.py-4
    .text-sm.font-semibold.text-gray-900 = @order.label
    .text-sm.text-gray-500
      = @order.decorate.date_label
      span.mx-1 ·
      = @order.decorate.people_label
      span.mx-1 ·
      = @order.stay&.customer&.name

  = form_with url: refuse_kitchen_order_path(@order), method: :patch, class: "space-y-4" do
    section.rounded-2xl.bg-white.ring-1.ring-gray-200.px-5.py-4
      = label_tag "meal_order[refusal_reason]", "Pourquoi ce n'est pas possible", class: "block text-sm font-medium text-gray-700"
      p.mt-0.5.text-sm.text-gray-500
        | Ce motif part à l'accueil, qui reviendra vers le client. Écrivez-le comme
          vous le diriez de vive voix.
      = text_area_tag "meal_order[refusal_reason]", nil, rows: 3, required: true, class: "mt-2 w-full rounded-md border-gray-300 shadow-sm sm:text-sm"

    .flex.items-center.justify-end.gap-3
      = link_to "Annuler", kitchen_orders_path, class: "text-sm text-gray-500 hover:underline"
      = submit_tag "Envoyer le refus", class: "inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-red-700"
