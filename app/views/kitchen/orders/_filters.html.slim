/ Filtres par paramètres d'URL : ils survivent au partage du lien et au retour
  arrière, ce qu'un filtre en JavaScript ne fait pas.
= form_with url: kitchen_orders_path, method: :get, data: { controller: "auto-submit", action: "change->auto-submit#submit" }, class: "flex flex-wrap items-end gap-3 rounded-xl bg-white p-4 ring-1 ring-gray-200" do
  div
    = label_tag :family, "Famille", class: "block text-xs font-medium text-gray-500"
    = select_tag :family,
                 options_for_select(@families.map { |f| [f[:label], f[:key]] }, @family),
                 include_blank: "Toutes",
                 class: "mt-1 rounded-md border-gray-300 text-sm"
  div
    = label_tag :responsible_human_id, "S'en charge", class: "block text-xs font-medium text-gray-500"
    = select_tag :responsible_human_id,
                 options_from_collection_for_select(@responsible_options, :id, :name, @responsible),
                 include_blank: "Tous",
                 class: "mt-1 rounded-md border-gray-300 text-sm"
  label.flex.items-center.gap-2.pb-2.text-sm.text-gray-700
    = check_box_tag :old_archives, "1", @old_archives, class: "h-4 w-4 rounded border-gray-300 text-4s-main focus:ring-4s-main"
    span Archives de plus de 12 mois
  noscript
    = submit_tag "Filtrer", class: "rounded-md bg-gray-900 px-3 py-1.5 text-sm text-white"
