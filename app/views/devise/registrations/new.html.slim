= render layout: "devise/shared/shell",
         locals: { title: "Créer un compte",
                   intro: "Un nouveau compte n'ouvre rien tant qu'un Sourcier ne lui a pas donné de rôle." } do
  = form_for(resource, as: resource_name, url: registration_path(resource_name), builder: ActionView::Helpers::FormBuilder, html: { class: "space-y-6" }) do |f|
    = render "devise/shared/error_messages", resource: resource
    div
      = f.label :email, "Adresse email", class: "block text-sm font-medium leading-6 text-gray-900"
      .mt-2
        = f.email_field :email,
                        required: true,
                        autofocus: true,
                        autocomplete: "email",
                        class: "block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
    div
      = f.label :password, "Mot de passe", class: "block text-sm font-medium leading-6 text-gray-900"
      .mt-2
        = f.password_field :password,
                           required: true,
                           autocomplete: "new-password",
                           class: "block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
      - if @minimum_password_length
        p.mt-2.text-xs.text-gray-500 #{@minimum_password_length} caractères minimum.
    div
      = f.label :password_confirmation, "Confirme le mot de passe", class: "block text-sm font-medium leading-6 text-gray-900"
      .mt-2
        = f.password_field :password_confirmation,
                           required: true,
                           autocomplete: "new-password",
                           class: "block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
    div
      button(type="submit" class="flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600")
        | Créer mon compte
  .mt-6.text-sm.leading-6.text-center
    = link_to "J'ai déjà un compte", new_session_path(resource_name), class: "font-semibold text-indigo-600 hover:text-indigo-500"
