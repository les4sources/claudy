= render layout: "devise/shared/shell", locals: { title: "Bienvenue chez Claudy" } do
  = simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f|
    div
      label.block.text-sm.font-medium.leading-6.text-gray-900[for="email"]
        | Adresse email
      .mt-2
        = f.input :email,
                  required: true,
                  autofocus: true,
                  label: false,
                  input_html: { \
                    autocomplete: "email",
                    class: "block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" \
                  }
    div
      label.block.text-sm.font-medium.leading-6.text-gray-900[for="password"]
        | Mot de passe
      .mt-2
        = f.input :password,
                  required: true,
                  label: false,
                  input_html: { \
                    autocomplete: "current-password",
                    class: "block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" \
                  }
    / Deux portes, côte à côte : le mot de passe, ou le lien reçu par
      e-mail (issue #306). Aucune n'est la « bonne » — c'est à
      l'utilisateur de choisir.
    .flex.items-center.justify-between.gap-4
      .text-sm.leading-6
        = link_to "Se connecter par e-mail", new_user_magic_link_path, class: "font-semibold text-indigo-600 hover:text-indigo-500"
      .text-sm.leading-6
        = link_to "Mot de passe oublié ?", new_password_path(resource_name), class: "font-semibold text-indigo-600 hover:text-indigo-500"
    div
      button(type="submit" class="flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600")
        | Me connecter
