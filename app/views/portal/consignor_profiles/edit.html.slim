/ Ce qui figure en tête de la feuille de l'artisan (epic #359, phase 3).
- content_for :meta_title do
  | Ma feuille

.portal-header
  div
    h1.portal-title Ma photo et ma présentation
  .portal-header__actions
    = link_to "← Mon dépôt-vente", portal_consignments_path, class: "portal-link-muted"

p.portal-empty Elles apparaissent en haut de votre feuille, dans le carnet Artisanat de l'épicerie.

- if @consignor.errors.any?
  p.portal-empty.text-red-700 = @consignor.errors.full_messages.to_sentence

= form_with model: @consignor, scope: :consignor, url: portal_consignor_profile_path, method: :patch,
            builder: ActionView::Helpers::FormBuilder, class: "portal-panel" do |f|
  - if @consignor.portrait.attached? && @consignor.portrait.persisted?
    = image_tag url_for(@consignor.portrait), alt: "Votre photo", class: "h-24 w-24 rounded-lg object-cover"
  .portal-field
    = f.label :portrait, "Votre photo", class: "portal-label"
    = f.file_field :portrait, accept: Consignor::PORTRAIT_CONTENT_TYPES.join(","), class: "portal-input"
  .portal-field
    = f.label :tagline, "Une phrase pour vous présenter", class: "portal-label"
    = f.text_field :tagline, maxlength: 140, class: "portal-input", placeholder: "Savons au lait d'ânesse, faits à Purnode"
  = f.submit "Enregistrer", class: "portal-btn portal-btn--block"
