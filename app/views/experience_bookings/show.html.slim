/ Fiche admin d'une réservation d'activité (epic #242, phase 4).
/
/ Une réservation ne vivait jusqu'ici que dans la liste et dans la modale du
/ séjour : rien à quoi accrocher un fil de commentaires, et aucune adresse vers
/ laquelle pointer une notification. Cette page est cette adresse. Elle reste
/ délibérément sobre — les GESTES (valider, refuser, déclarer la tenue) vivent
/ là où on les fait déjà, dans la liste et la file « À confirmer ».
- content_for :page_header do
  = render "layouts/components/page_header",
           title: @booking.experience.name,
           links: [link_to("← Activités réservées", experience_bookings_path, class: "btn-page-header-no-background")].compact

.max-w-3xl.space-y-4
  article.overflow-hidden.rounded-xl.border.border-gray-200.bg-white.shadow-sm
    dl.divide-y.divide-gray-100
      .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
        dt.text-xs.uppercase.tracking-wider.text-gray-400 Créneau
        dd.col-span-2.text-sm.text-gray-800
          = l(@booking.experience_availability.available_on, format: :long)
          - if @booking.experience_availability.starts_at.present?
            span.ml-1.text-gray-500 = "à #{@booking.experience_availability.starts_at}"

      .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
        dt.text-xs.uppercase.tracking-wider.text-gray-400 Participants
        dd.col-span-2.text-sm.text-gray-800 = @booking.participants

      - if @booking.effective_duration_minutes
        .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
          dt.text-xs.uppercase.tracking-wider.text-gray-400 Durée
          dd.col-span-2.text-sm.text-gray-800
            = @booking.effective_duration
            - if @booking.duration_adjusted? && @booking.standard_duration_minutes
              span.ml-2.text-xs.text-amber-800 = "durée standard #{ExperienceBooking.format_duration(@booking.standard_duration_minutes)}"

      .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
        dt.text-xs.uppercase.tracking-wider.text-gray-400 Séjour
        dd.col-span-2.text-sm
          = link_to @booking.stay.customer&.name.presence || "Séjour ##{@booking.stay_id}",
                    stay_path(@booking.stay), class: "claudy-link"

      - if @booking.experience.human.present?
        .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
          dt.text-xs.uppercase.tracking-wider.text-gray-400 Porteur
          dd.col-span-2.text-sm.text-gray-800 = @booking.experience.human.name

      - if @booking.performed_by.present?
        .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
          dt.text-xs.uppercase.tracking-wider.text-gray-400 Tenue par
          dd.col-span-2.text-sm.text-gray-800 = @booking.performed_by.name

      - if @booking.carrier_fee_cents.present?
        .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
          dt.text-xs.uppercase.tracking-wider.text-gray-400 Rémunération
          dd.col-span-2.text-sm.text-gray-800
            = humanized_money_with_symbol(Money.new(@booking.carrier_fee_cents, "EUR"))
            - if @booking.carrier_statement.present?
              span.ml-2.text-xs.text-gray-500 = "sur le relevé #{@booking.carrier_statement.reference}"

      .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
        dt.text-xs.uppercase.tracking-wider.text-gray-400 Statut
        dd.col-span-2.text-sm.text-gray-800
          = @booking.status_label
          - if @booking.outcome.present?
            span.ml-2.rounded-full.bg-gray-100.px-2.py-0.5.text-xs.text-gray-700 = @booking.outcome_label

      - if @booking.refusal_reason.present?
        .grid.grid-cols-3.items-baseline.gap-4.px-5.py-3
          dt.text-xs.uppercase.tracking-wider.text-gray-400 Motif du refus
          dd.col-span-2.text-sm.text-red-700 = @booking.refusal_reason

  / Qui a tenu la prestation, et combien on lui doit (Michael, 2026-10-13).
    Réservé à l'équipe, et figé dès que la prestation est sur un relevé.
  - unless current_user&.restricted_to_own_activities? || @booking.carrier_statement.present?
    = form_with model: @booking, url: payout_experience_booking_path(@booking), method: :patch,
                class: "rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm space-y-3" do |f|
      h2.text-sm.font-medium.text-gray-900 Rémunération de la prestation
      .grid.grid-cols-1.gap-3(class="sm:grid-cols-3")
        div(class="relative" data-controller="searchable-select" data-searchable-select-placeholder-value="Chercher une personne…" data-searchable-select-clearable-value="true")
          = f.label :performed_by_id, "Tenue par", class: "block text-sm font-medium text-gray-700"
          = f.select :performed_by_id,
                     options_from_collection_for_select(Human.order(:name), :id, :name, @booking.performed_by_id),
                     { include_blank: "— #{@booking.experience.human&.name || 'Le porteur de l’activité'} —" },
                     class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm",
                     data: { searchable_select_target: "select" }
          = render "shared/searchable_select_search", label: "Chercher une personne"
        div
          = label_tag "experience_booking[effective_duration]", "Durée prestée", class: "block text-sm font-medium text-gray-700"
          = text_field_tag "experience_booking[effective_duration]", @booking.effective_duration,
                           placeholder: "1h30, 1,5, 90 min", autocomplete: "off",
                           class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm"
        div
          = label_tag "experience_booking[carrier_fee]", "Rémunération (€)", class: "block text-sm font-medium text-gray-700"
          = text_field_tag "experience_booking[carrier_fee]", @booking.carrier_fee&.then { |v| format("%.2f", v).tr(".", ",") },
                           inputmode: "decimal", placeholder: "calculée à la validation",
                           class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm"
      .flex.items-center.justify-between.gap-3
        p.text-xs.text-gray-500 Vide : le porteur de l'activité, au tarif horaire × la durée prestée (par défaut, la durée standard).
        = f.submit "Enregistrer", class: "btn-primary"

  / Fil de commentaires — même composant que partout ailleurs.
  = render Comments::ThreadComponent.new(commentable: @booking, current_user: current_user)
