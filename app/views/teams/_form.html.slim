.max-w-3xl.space-y-6
  .rounded-2xl.bg-white.ring-1.ring-gray-200.p-6.space-y-5
    h2.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 Le pôle

    = f.text_field :name,
                   label: "Nom *",
                   required: true,
                   class: "md:w-2/3"

    .grid.grid-cols-1.gap-4.md:grid-cols-2
      = f.select :kind,
                 Team::KIND_LABELS.map { |value, label| [label, value] },
                 { include_blank: "— non classé —", label: "Type" }
      = f.text_field :analytic_code,
                     label: "Code analytique",
                     hint: "Facultatif. Sert à rapprocher le pôle du plan analytique."

    / La hiérarchie s'arrête à deux niveaux : seuls des pôles RACINES peuvent
      être parents, et jamais le pôle lui-même.
    - parents = Team.roots.ordered.reject { |candidate| candidate.id == f.object.id }
    = f.select :parent_id,
               options_from_collection_for_select(parents, :id, :name, f.object.parent_id),
               { include_blank: "— aucun, c'est un pôle racine —", label: "Rattaché à" }
    p.text-xs.text-gray-500
      | Un pôle rattaché ne peut pas avoir d'enfant à son tour : la hiérarchie s'arrête à deux niveaux.

    div
      = f.label :description, "Descriptif du pôle", class: "block text-sm font-medium text-gray-700 mb-1"
      = f.rich_text_area :description
