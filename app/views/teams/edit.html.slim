- content_for :page_header do
  = render "layouts/components/page_header", title: "Modifier « #{@team.name} »"

.max-w-3xl.space-y-6
  = form_with model: @team, url: team_path(@team) do |f|
    = render "form", f: f
    = f.actions do
      = f.submit "Enregistrer"
      = link_to "Annuler", teams_path, class: "ml-3 text-sm text-gray-500 hover:underline"

  = render "teams/members",
           team: @team,
           memberships: @memberships,
           addable_humans: @addable_humans,
           membership: @membership
