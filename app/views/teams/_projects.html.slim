/ Les projets du pôle (Michael, 2026-10-19) : ceux qui avancent ou attendent,
  avec l'avancement de leurs actions, puis les prochaines actions à faire.
  Les projets terminés restent à portée, repliés. Un pôle parent voit aussi
  les projets des pôles qu'il regroupe.
- ongoing = board.ongoing
- finished = board.finished
- counts = board.counts
- upcoming = board.upcoming_tasks
section#projets.rounded-2xl.bg-white.ring-1.ring-gray-200.overflow-hidden
  .flex.flex-wrap.items-center.justify-between.gap-3.px-6.py-4.border-b.border-gray-100(class="bg-gray-50/60")
    div
      h2.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 Projets
      p.mt-1.text-xs.text-gray-500
        - parts = Project::STATUSES.filter_map { |status| "#{counts[status]} #{Project::STATUS_LABELS[status].downcase}" if counts[status].to_i.positive? }
        = parts.any? ? parts.join(" · ") : "Aucun projet pour l'instant."
        - if board.sub_teams?
          = " Ce pôle et ceux qu'il regroupe."
    = link_to "Nouveau projet", new_project_path(team_id: team.id), class: "rounded-md bg-gray-900 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-700"

  .grid.grid-cols-1.lg:grid-cols-3
    .lg:col-span-2.lg:border-r.lg:border-gray-100
      - if ongoing.empty?
        .px-6.py-8.text-center.text-sm.text-gray-500
          | Aucun projet en cours.
          =< link_to "En lancer un", new_project_path(team_id: team.id), class: "font-medium text-gray-700 hover:underline"
      - else
        ul.divide-y.divide-gray-100
          - ongoing.each do |row|
            - project = ProjectDecorator.new(row.project)
            li.px-6.py-4
              .flex.flex-wrap.items-start.justify-between.gap-3
                .min-w-0
                  .flex.flex-wrap.items-center.gap-2
                    = link_to project.name, project_path(project), class: "text-sm font-semibold text-gray-900 hover:underline"
                    = project.status_badge
                    - if board.sub_teams? && project.team_id != team.id
                      span.text-xs.text-gray-500 = project.team.name
                  .mt-1.flex.flex-wrap.items-center.gap-x-3.text-xs.text-gray-500
                    - if project.human
                      span = "Porté par #{project.human.name}"
                    - if project.object.due_date
                      span(class="#{row.late? ? 'font-semibold text-rose-700' : ''}")
                        = row.late? ? "En retard, échéance le #{project.due_date}" : "Échéance le #{project.due_date}"
                .w-40.shrink-0.text-right
                  - if row.total_count.zero?
                    = link_to "Ajouter des actions", project_path(project), class: "text-xs font-medium text-gray-500 hover:underline"
                  - else
                    .text-xs.text-gray-600
                      / « 1 action faite sur 4 » : en français, 0 et 1 restent au singulier.
                      - plural = row.done_count > 1
                      span.font-semibold.text-gray-900 = row.done_count
                      =< "#{plural ? 'actions faites' : 'action faite'} sur #{row.total_count}"
                    .mt-1.h-1.5.w-full.overflow-hidden.rounded-full.bg-gray-100(role="progressbar" aria-valuenow=row.percent aria-valuemin="0" aria-valuemax="100")
                      .h-full.rounded-full(class="#{row.percent == 100 ? 'bg-teal-600' : 'bg-teal-500'}" style="width: #{row.percent}%")
                    - if row.overdue_count.positive?
                      .mt-1.text-xs.font-medium.text-rose-700 = "#{row.overdue_count} en retard"

      - if finished.any?
        details.border-t.border-gray-100
          summary.cursor-pointer.px-6.py-3.text-xs.font-medium.text-gray-500.hover:text-gray-700
            = "#{finished.size} #{'projet'.pluralize(finished.size)} #{'terminé'.pluralize(finished.size)}"
          ul.divide-y.divide-gray-100.border-t.border-gray-100
            - finished.each do |row|
              li.flex.items-center.justify-between.gap-3.px-6.py-2
                = link_to row.project.name, project_path(row.project), class: "text-sm text-gray-600 hover:underline"
                span.text-xs.text-gray-400 = "#{row.done_count}/#{row.total_count} #{'action'.pluralize(row.total_count)}"

    aside.border-t.border-gray-100.lg:border-t-0
      .px-6.pt-4.text-xs.uppercase.tracking-wide.text-gray-400 Prochaines actions
      - if upcoming.empty?
        p.px-6.py-4.text-sm.text-gray-500 Rien à faire dans les projets en cours.
      - else
        ul.divide-y.divide-gray-100
          - upcoming.each do |task|
            - late = task.due_date && task.due_date < board.today
            li.px-6.py-3
              = link_to task.name, task_path(task), class: "text-sm font-medium text-gray-900 hover:underline"
              .mt-0.5.flex.flex-wrap.gap-x-2.text-xs.text-gray-500
                = link_to task.project.name, project_path(task.project), class: "hover:underline"
                - if task.due_date
                  span(class="#{late ? 'font-semibold text-rose-700' : ''}") = (late ? "en retard, " : "") + l(task.due_date, format: :short)
                - if task.humans.any?
                  span = task.humans.map(&:name).join(", ")
