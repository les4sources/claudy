/ Les comptes du pôle (Michael, 2026-10-18) : ce que les membres du collectif
  viennent d'abord chercher. Trois questions, trois cartes : comment va le
  pôle, où en est-il de son budget, qu'attend-on de lui.
  Les chiffres viennent des écritures portant le `team_id` du pôle (et des
  pôles qu'il regroupe), jamais d'une répartition au prorata.
- year = accounts.year
- budget = accounts.budget
- health = accounts.health
section#comptes.space-y-4
  .flex.flex-wrap.items-center.justify-between.gap-3
    div
      h2.text-lg.font-semibold.text-gray-900 = "Comptes #{year}"
      p.text-xs.text-gray-500
        - if accounts.sub_teams.any?
          = "Ce pôle et ceux qu'il regroupe (#{accounts.sub_teams.map(&:name).join(', ')}), toutes entités confondues."
        - else
          | Toutes entités confondues, d'après les écritures rattachées au pôle.
    nav.flex.items-center.gap-1.text-sm(aria-label="Changer d'année")
      = link_to "← #{year - 1}", team_path(team, year: year - 1, anchor: "comptes"), class: "rounded-md px-2 py-1 text-gray-600 hover:bg-gray-100"
      span.rounded-md.bg-gray-900.px-2.py-1.font-semibold.text-white = year
      = link_to "#{year + 1} →", team_path(team, year: year + 1, anchor: "comptes"), class: "rounded-md px-2 py-1 text-gray-600 hover:bg-gray-100"

  / Sans ce rappel, les chiffres ont l'air complets alors qu'une part de
    l'argent n'a été rattachée à aucun pôle.
  - if accounts.incomplete?
    .rounded-xl.border.border-amber-200.bg-amber-50.px-4.py-3.text-sm.text-amber-900
      p.font-semibold Chiffres incomplets
      ul.mt-1.list-disc.space-y-0.5.pl-5
        - if accounts.pending_entries_count.positive?
          - count = accounts.pending_entries_count
          li
            = "#{count} #{'ligne'.pluralize(count)} de trésorerie #{count > 1 ? 'attendent' : 'attend'} encore d'être #{'affectée'.pluralize(count)} : elles ne sont dans aucun pôle."
            =< link_to "Les affecter", finance_unallocated_cash_entries_path, class: "font-medium underline"
        - unassigned = accounts.unassigned_totals
        - if unassigned.any?
          li = "En #{year}, #{team_euros(unassigned.expense_cents)} de charges et #{team_euros(unassigned.revenue_cents)} de produits sont au grand livre sans pôle."
      p.mt-1.text-xs.text-amber-800 Une partie peut revenir à ce pôle : son résultat réel peut être meilleur ou pire.

  .grid.grid-cols-1.gap-4.lg:grid-cols-3
    / 1. La santé : le résultat, ce qui va encore peser dessus, et l'an dernier.
    section.rounded-2xl.bg-white.p-5.ring-1.ring-gray-200
      .flex.items-center.justify-between.gap-2
        h3.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 Santé financière
        span.inline-flex.items-center.rounded-full.px-2.5.py-0.5.text-xs.font-semibold.ring-1(class=team_health_classes(health.level))
          = health.label
      .mt-4
        .text-xs.text-gray-500 = "Résultat #{year}#{accounts.current_year? ? ' à ce jour' : ''}"
        .mt-0.5.text-3xl.font-extrabold(class="#{accounts.net_cents.negative? ? 'text-rose-700' : 'text-gray-900'}")
          = team_euros(accounts.net_cents, sign: true)
      dl.mt-4.space-y-1.5.text-sm
        .flex.justify-between.gap-2
          dt.text-gray-500 Produits
          dd.font-medium.text-teal-700 = team_euros(accounts.totals.revenue_cents)
        .flex.justify-between.gap-2
          dt.text-gray-500 Charges
          dd.font-medium.text-rose-700 = team_euros(accounts.totals.expense_cents)
        - if accounts.upcoming_cents.nonzero?
          .flex.justify-between.gap-2
            dt.text-gray-500
              | Encore à venir
              span.block.text-xs.text-gray-400 Factures et notes de frais pas encore au grand livre
            dd.whitespace-nowrap.font-medium.text-rose-700 = "−#{team_euros(accounts.upcoming_cents)}"
          .flex.justify-between.gap-2.border-t.border-gray-100.pt-1.5
            dt.font-medium.text-gray-700 Résultat attendu
            dd.font-semibold(class="#{accounts.projected_net_cents.negative? ? 'text-rose-700' : 'text-gray-900'}")
              = team_euros(accounts.projected_net_cents, sign: true)
      - previous = accounts.previous_totals
      p.mt-4.text-xs.text-gray-500
        - if previous.any?
          = "#{accounts.current_year? ? "À la même date en #{year - 1}" : "En #{year - 1}"} : "
          span.font-medium.text-gray-700 = team_euros(previous.net_cents, sign: true)
          = " (produits #{team_euros(previous.revenue_cents)}, charges #{team_euros(previous.expense_cents)})."
        - else
          = "Aucune écriture pour ce pôle en #{year - 1} à comparer."

    / 2. Le budget de l'année, au rythme de l'année écoulée.
    section.rounded-2xl.bg-white.p-5.ring-1.ring-gray-200
      .flex.items-center.justify-between.gap-2
        h3.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 = "Budget #{year}"
        / Un budget détaillé (Comptabilité › Budget) se modifie ligne par
          ligne, là où il a été fait : le formulaire à deux montants l'ignorerait.
        - if budget&.detailed
          - if section_readable?(:accounting)
            = link_to "Voir le détail", finance_budget_path(year: year), class: "text-xs font-medium text-4s-main hover:underline"
        - elsif budget
          = link_to "Modifier", edit_team_budget_path(team, year), class: "text-xs font-medium text-4s-main hover:underline"
      - if budget
        - elapsed = (accounts.elapsed_ratio * 100).round
        .mt-4.space-y-4
          - [["Produits", accounts.totals.revenue_cents, budget.revenue_cents, "bg-teal-500"], ["Charges", accounts.totals.expense_cents, budget.expense_cents, "bg-rose-500"]].each do |label, actual, planned, color|
            - percent = team_budget_percent(actual, planned)
            div
              .flex.items-baseline.justify-between.gap-2.text-sm
                span.font-medium.text-gray-700 = label
                span.text-gray-500
                  span.font-semibold.text-gray-900 = team_euros(actual)
                  = " sur #{team_euros(planned)}"
                  - if percent
                    span.ml-1.text-xs = "(#{percent} %)"
              .relative.mt-1.h-2.5.rounded-full.bg-gray-100
                .h-2.5.rounded-full(class=color style="width: #{[percent.to_i, 100].min}%")
                - if accounts.current_year?
                  div(class="absolute h-4 w-0.5 rounded bg-gray-700" style="top: -0.1875rem; left: #{elapsed}%" title="#{elapsed} % de l'année écoulée")
        dl.mt-4.space-y-1.5.border-t.border-gray-100.pt-3.text-sm
          .flex.justify-between.gap-2
            dt.text-gray-500 Résultat prévu sur l'année
            dd.font-medium.text-gray-900 = team_euros(budget.net_cents, sign: true)
          - if accounts.current_year?
            .flex.justify-between.gap-2
              dt.text-gray-500 = "Prévu à ce stade (#{elapsed} % de l'année)"
              dd.font-medium.text-gray-900 = team_euros(accounts.expected_net_cents, sign: true)
        - if accounts.current_year?
          p.mt-3.text-xs.text-gray-400 Le trait gris marque la part de l'année écoulée. Un pôle saisonnier peut s'en écarter sans que ce soit grave.
        - if budget.notes.present?
          p.mt-3.whitespace-pre-line.rounded-lg.bg-gray-50.px-3.py-2.text-xs.text-gray-600 = budget.notes
      - else
        .mt-4.rounded-xl.border.border-dashed.border-gray-300.px-4.py-6.text-center
          p.text-sm.text-gray-600 = "Pas encore de budget pour #{year}."
          p.mt-1.text-xs.text-gray-400 Sans budget, la santé du pôle ne se juge que sur son résultat.
          = link_to "Fixer le budget #{year}", edit_team_budget_path(team, year), class: "mt-3 inline-flex items-center rounded-md bg-4s-main px-3 py-1.5 text-sm font-medium text-white hover:opacity-90"

    / 3. Ce qui attend le oui du pôle. Tant que personne n'a répondu, ces
      factures ne sont pas payables.
    section.rounded-2xl.bg-white.p-5.ring-1.ring-gray-200
      - invoices = accounts.invoices_to_validate
      .flex.items-center.justify-between.gap-2
        h3.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 Dépenses à valider
        - if invoices.any?
          span.inline-flex.items-center.rounded-full.bg-amber-100.px-2.5.py-0.5.text-xs.font-semibold.text-amber-900 = invoices.size
      - if invoices.any?
        p.mt-3.text-sm.text-amber-900
          = "#{pluralize(invoices.size, 'facture', plural: 'factures')} en attente de validation par ce pôle, #{team_euros(accounts.invoices_to_validate_cents)} au total."
        p.text-xs.text-gray-500 Tant que personne n'a répondu, elles ne sont pas payables.
        ul.mt-3.divide-y.divide-gray-100
          - invoices.first(6).each do |invoice|
            li.py-2
              = link_to finance_purchase_invoice_path(invoice), class: "group flex items-start justify-between gap-3" do
                div
                  .text-sm.font-medium.text-gray-900.group-hover:underline = invoice.third_party&.name.presence || "Fournisseur"
                  .text-xs.text-gray-500
                    = l(invoice.issued_on, format: "%-d/%m/%Y")
                    - if invoice.validation_team_id != team.id && invoice.validation_team
                      = " · #{invoice.validation_team.name}"
                .whitespace-nowrap.text-sm.font-semibold.text-gray-900 = team_euros(invoice.total_cents)
        = link_to "Voir et valider les factures", finance_purchase_invoices_path(status: "to_validate", team_id: team.id), class: "mt-3 inline-flex items-center rounded-md border border-amber-300 bg-amber-50 px-3 py-1.5 text-sm font-medium text-amber-900 hover:bg-amber-100"
      - else
        .mt-4.flex.items-center.gap-2.rounded-xl.bg-teal-50.px-4.py-3.text-sm.text-teal-800
          span(aria-hidden="true") ✓
          | Rien n'attend le oui du pôle.
      - in_preparation = accounts.upcoming_invoices_cents - accounts.invoices_to_validate_lines_cents
      - if in_preparation.nonzero? || accounts.upcoming_expense_reports_cents.nonzero?
        p.mt-4.border-t.border-gray-100.pt-3.text-xs.text-gray-500
          | Encore en préparation à la comptabilité, ventilé sur ce pôle :
          - parts = []
          - parts << "#{team_euros(in_preparation)} de factures" if in_preparation.nonzero?
          - parts << "#{team_euros(accounts.upcoming_expense_reports_cents)} de notes de frais" if accounts.upcoming_expense_reports_cents.nonzero?
          =< "#{parts.to_sentence}."

  / Mois par mois : la saison du pôle se lit d'un coup d'œil.
  - months = accounts.months
  - peak = months.flat_map { |m| [m.revenue_cents, m.expense_cents] }.map(&:abs).max.to_i
  - if peak.positive?
    section.rounded-2xl.bg-white.p-5.ring-1.ring-gray-200
      .flex.flex-wrap.items-center.justify-between.gap-2
        h3.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 Mois par mois
        .flex.items-center.gap-4.text-xs.text-gray-500
          span.flex.items-center.gap-1
            span.inline-block.h-2.5.w-2.5.rounded-sm.bg-teal-500
            | Produits
          span.flex.items-center.gap-1
            span.inline-block.h-2.5.w-2.5.rounded-sm.bg-rose-400
            | Charges
      .mt-4.grid.grid-cols-12.items-end.gap-1.sm:gap-2(class="h-36")
        - months.each do |month|
          - title = "#{l(month.month, format: '%B %Y').capitalize} : produits #{team_euros(month.revenue_cents)}, charges #{team_euros(month.expense_cents)}"
          .flex.h-full.items-end.justify-center.gap-0.5(title=title)
            .w-full.max-w-4.rounded-t.bg-teal-500(style="height: #{[(month.revenue_cents.clamp(0, peak) * 100.0 / peak), 0].max.round(1)}%")
            .w-full.max-w-4.rounded-t.bg-rose-400(style="height: #{[(month.expense_cents.clamp(0, peak) * 100.0 / peak), 0].max.round(1)}%")
      .mt-1.grid.grid-cols-12.gap-1.text-center.text-xs.text-gray-400.sm:gap-2
        - months.each do |month|
          span = l(month.month, format: "%b").delete(".")

  / Un pôle qui en regroupe d'autres : la part de chacun.
  - rows = accounts.sub_team_rows
  - if rows.any?
    section.overflow-hidden.rounded-2xl.bg-white.ring-1.ring-gray-200
      .border-b.border-gray-100.px-5.py-3(class="bg-gray-50/60")
        h3.text-sm.font-semibold.uppercase.tracking-wide.text-gray-500 Par pôle
      .overflow-x-auto
        table.w-full.text-sm
          thead.text-xs.uppercase.tracking-wide.text-gray-500
            tr
              th.px-5.py-2.text-left Pôle
              th.px-5.py-2.text-right Produits
              th.px-5.py-2.text-right Charges
              th.px-5.py-2.text-right Résultat
          tbody
            - rows.each do |row|
              tr.border-t.border-gray-100
                td.px-5.py-2
                  - if row.team == team
                    span.text-gray-700 = "#{row.team.name} (en propre)"
                  - else
                    = link_to row.team.name, team_path(row.team, year: year), class: "font-medium text-gray-900 hover:underline"
                td.px-5.py-2.text-right.text-teal-700 = team_euros(row.totals.revenue_cents)
                td.px-5.py-2.text-right.text-rose-700 = team_euros(row.totals.expense_cents)
                td.px-5.py-2.text-right.font-semibold(class="#{row.totals.net_cents.negative? ? 'text-rose-700' : 'text-gray-900'}")
                  = team_euros(row.totals.net_cents, sign: true)
