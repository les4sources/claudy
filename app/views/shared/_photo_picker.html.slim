/ Plusieurs photos avant un seul enregistrement (contrôleur `photo-picker`).
  Le bouton ouvre l'appareil photo ou la photothèque ; chaque photo s'ajoute à
  la liste au lieu de remplacer la précédente, et toutes partent ensemble.
  Le vrai champ du formulaire vient en bloc (`render layout:`), avec la cible
  `field` et la classe `sr-only` : name, direct upload et required restent les
  siens. Locaux : `accept`, et au choix `label`, `hint`, `save_label` (le
  bouton qui enverra les photos) ou `submit_form` (l'id d'un formulaire : un
  bouton « Enregistrer les n photos » apparaît alors sous les aperçus).
- picker_id = "photo_picker_#{SecureRandom.hex(4)}"
- save_label = local_assigns[:save_label] || "Enregistrer"
div.relative[data-controller="photo-picker" data-photo-picker-save-label-value=save_label]
  - if local_assigns[:label]
    label.block.text-xs.font-semibold.text-stone-600 for=picker_id = label
  = yield
  ul.mt-2.grid.grid-cols-3.gap-2.empty:hidden data-photo-picker-target="previews"
  label[class="mt-2 flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg border border-dashed border-forest text-sm font-medium text-forest hover:bg-forest-tint"
        data-photo-picker-target="button"]
    svg.h-5.w-5 xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"
      circle cx="12" cy="13" r="3"
    span data-photo-picker-target="buttonLabel" Ajouter une photo
    input[type="file" id=picker_id multiple=true accept=accept class="sr-only"
          data-photo-picker-target="picker" data-action="change->photo-picker#add"]
  - if local_assigns[:submit_form]
    button[type="submit" form=submit_form
           class="mt-2 hidden h-11 w-full rounded-lg bg-forest px-4 text-sm font-semibold text-white hover:bg-forest-soft"
           data-photo-picker-target="submit"]
  - else
    p.mt-1.hidden.text-xs.text-stone-500 aria-live="polite" data-photo-picker-target="summary"
  - if local_assigns[:hint]
    p.mt-1.text-xs.text-stone-500 = hint
  template data-photo-picker-target="template"
    li.relative
      img.aspect-square.w-full.rounded-lg.object-cover.ring-1.ring-stone-200 alt=""
      button[type="button" aria-label="Retirer la photo" data-action="photo-picker#remove"
             class="absolute right-1 top-1 flex h-7 w-7 items-center justify-center rounded-full bg-white/90 text-stone-500 shadow hover:text-red-600"]
        | ×
