- content_for :page_header do
  = render 'layouts/components/page_header',
           title: @experience.name,
           links: [ \
             delete_link(@experience.object),
             link_to( \
               "Mettre à jour",
               edit_experience_path(@experience),
               class: "btn-page-header" \
             ) \
           ].compact

.grid.grid-cols-3.gap-4
  .col-span-2.space-y-4
    .overflow-hidden.bg-white.shadow.sm:rounded-lg
      .px-4.py-5.sm:px-6
        h3.text-lg.font-medium.leading-6.text-gray-900
          | Informations
      .border-t.border-gray-200
        dl
          .px-4.py-5.sm:grid.sm:grid-cols-3.sm:gap-4.sm:px-6
            dt.text-sm.font-medium.text-gray-500
              | Photo
            dd.mt-1.text-sm.text-gray-900.sm:col-span-2.sm:mt-0
              - if @experience.photo?
                = image_tag @experience.photo_url(:public),
                            class: "inline-block rounded-md"

            dt.text-sm.font-medium.text-gray-500
              | Prix
            dd.mt-1.text-sm.text-gray-900.sm:col-span-2.sm:mt-0
              | #{@experience.fixed_price} + #{@experience.price}/participant

            dt.text-sm.font-medium.text-gray-500
              | Participants
            dd.mt-1.text-sm.text-gray-900.sm:col-span-2.sm:mt-0
              = @experience.participants

            - if @experience.duration.present? || @experience.duration_hours
              dt.text-sm.font-medium.text-gray-500
                | Durée
              dd.mt-1.text-sm.text-gray-900.sm:col-span-2.sm:mt-0
                = @experience.duration
                - if @experience.duration_hours
                  span.text-gray-400 = " (#{@experience.duration_hours})"

            dt.text-sm.font-medium.text-gray-500
              | Pôle
            dd.mt-1.text-sm.text-gray-900.sm:col-span-2.sm:mt-0
              - if @experience.team
                = @experience.team.name
              - else
                span.text-gray-400 Aucun pôle — la charge du porteur ne sera pas ventilée.

            / Rémunération du porteur (epic #244, phase 1). Le tarif effectif est
              celui qui sera figé sur chaque réservation à sa confirmation.
            dt.text-sm.font-medium.text-gray-500
              | Rémunération du porteur
            dd.mt-1.text-sm.text-gray-900.sm:col-span-2.sm:mt-0
              - tarif = @experience.effective_carrier_hourly_cents
              = "#{number_with_precision(tarif / 100.0, precision: 2, separator: ',')} €/h"
              - if @experience.carrier_rate_overridden?
                span.ml-2.inline-flex.items-center.rounded-full.bg-teal-100.px-2.py-0.5.text-xs.font-medium.text-teal-800 tarif propre à cette activité
              - else
                span.ml-2.text-xs.text-gray-400 tarif général
              - fee = @experience.carrier_fee_cents_on
              - if fee
                .mt-1.text-sm.text-gray-500
                  = "Soit #{number_with_precision(fee / 100.0, precision: 2, separator: ',')} € par prestation (#{@experience.duration_hours}), quel que soit le nombre de participants."
              - else
                .mt-1.text-sm.text-orange-700
                  | Sans durée en heures, aucune rémunération n'est calculable — une réservation confirmée restera sans montant.
                  = link_to "Compléter la durée", edit_experience_path(@experience), class: "ml-1 underline"

            dt.text-sm.font-medium.text-gray-500
              | Résumé
            dd.mt-1.text-sm.text-gray-900.sm:col-span-2.sm:mt-0
              = @experience.summary

    .overflow-hidden.bg-white.shadow.sm:rounded-lg
      .px-4.py-5.sm:px-6
        h3.text-lg.font-medium.leading-6.text-gray-900
          | Description
      .border-t.border-gray-200
        .p-6
          == @experience.description

  .space-y-4
    / Publication sur le site les4sources.be (catalogue). Un porteur restreint
    / voit l'état mais ne publie pas — c'est l'équipe qui décide du catalogue.
    .overflow-hidden.bg-white.shadow.sm:rounded-lg
      .px-4.py-5.sm:px-6.flex.items-center.justify-between
        h3.text-lg.font-medium.leading-6.text-gray-900
          | Site web
        - if @experience.published?
          span.inline-flex.items-center.rounded-md.bg-green-50.px-2.py-1.text-xs.font-medium.text-green-700.ring-1.ring-inset.ring-green-600/20
            | Publiée
        - else
          span.inline-flex.items-center.rounded-md.bg-gray-50.px-2.py-1.text-xs.font-medium.text-gray-600.ring-1.ring-inset.ring-gray-500/10
            | Brouillon
      .border-t.border-gray-200.px-4.py-5.sm:px-6.space-y-4.text-sm
        - if @experience.published?
          p.text-gray-700
            | En ligne depuis le #{l(@experience.published_at.to_date)} :
          p
            = link_to "www.les4sources.be#{@experience.public_path}",
                      "https://www.les4sources.be#{@experience.public_path}",
                      target: "_blank",
                      class: "claudy-link break-all"
          - unless current_user&.restricted_to_experiences?
            = button_to "Dépublier",
                        unpublish_experience_path(@experience),
                        method: :delete,
                        class: "btn-destroy",
                        form: { data: { turbo_confirm: "Retirer cette activité du site ?" } }
        - else
          p.text-gray-700
            | Cette activité n'est pas visible sur le site.
          p.text-xs.text-gray-500
            | Adresse prévue :
            = " "
            code.rounded.bg-gray-100.px-1.5.py-0.5 = "/catalogue/#{@experience.suggested_slug}"
          - unless current_user&.restricted_to_experiences?
            = button_to "Publier sur le site",
                        publish_experience_path(@experience),
                        method: :post,
                        class: "btn-page-header"

    = render "experiences/upcoming_bookings", bookings: @upcoming_bookings

    - if @experience.human.presence
      ul.grid.grid-cols-1.gap-6[role="list"]
        li.col-span-1.flex.flex-col.divide-y.divide-gray-200.rounded-lg.bg-white.text-center.shadow
          .flex.flex-1.flex-col.p-8
            - if @experience.human.photo?
              = image_tag @experience.human.photo_url(:thumb),
                          class: "mx-auto flex-shrink-0 rounded-md",
                          alt: ""

            h3.mt-6.text-sm.font-medium.text-gray-900
              = @experience.human.name
            dl.mt-1.flex.flex-grow.flex-col.justify-between
              dt.sr-only
                | Tagline
              dd.text-sm.text-gray-500
                = @experience.human.summary
              dt.sr-only
                | Rôle
              dd.mt-3
                span.inline-flex.items-center.rounded-full.bg-green-50.px-2.py-1.text-xs.font-medium.text-green-700.ring-1.ring-inset.ring-green-600/20
                  | Porteur·euse d'activité
                  

/ Calendrier MENSUEL des disponibilités — pleine largeur sous la fiche, la
/ grille de 28-31 jours a besoin de place. Enrobé d'un Turbo Frame : poser,
/ retirer et naviguer d'un mois à l'autre se fait sans rechargement de page.
.mt-6
  = render "experiences/month_calendar", calendar: @calendar
