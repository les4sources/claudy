= form_with model: [:finance, rule], class: "space-y-6" do |f|
  = render "finance/shared/form_errors", record: rule

  .p-4.bg-white.rounded-lg.border.border-gray-100
    h3.mb-3.text-sm.font-semibold.text-gray-900 La règle
    .grid.gap-4(class="md:grid-cols-3")
      div
        = f.label :label, "Libellé *", class: "block text-sm font-medium text-gray-700"
        = f.text_field :label, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm"
      div
        = f.label :position, "Ordre", class: "block text-sm font-medium text-gray-700"
        = f.number_field :position, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm"
      div
        = f.label :confidence, "Confiance (%)", class: "block text-sm font-medium text-gray-700"
        = f.number_field :confidence, min: 0, max: 100, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm"
    label.mt-3.flex.items-center.gap-2.text-sm.text-gray-700
      = f.check_box :active, class: "rounded border-gray-300"
      |  Active

  .p-4.bg-white.rounded-lg.border.border-gray-100
    h3.mb-1.text-sm.font-semibold.text-gray-900 Quand la ligne ressemble à…
    p.mb-3.text-xs.text-gray-500 Tous les critères renseignés doivent correspondre. Au moins un est obligatoire — une règle sans critère s'appliquerait à tout.
    .grid.gap-4(class="md:grid-cols-2")
      div
        = f.label :counterparty_iban, "IBAN de la contrepartie", class: "block text-sm font-medium text-gray-700"
        = f.text_field :counterparty_iban, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm"
      div
        = f.label :counterparty_name_contains, "Le nom du tiers contient", class: "block text-sm font-medium text-gray-700"
        = f.text_field :counterparty_name_contains, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm"
      div
        = f.label :communication_contains, "La communication contient", class: "block text-sm font-medium text-gray-700"
        = f.text_field :communication_contains, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm"
      div(data-controller="searchable-select" data-searchable-select-placeholder-value="Les deux sens" data-searchable-select-clearable-value="true" class="relative")
        = f.label :direction, "Sens", class: "block text-sm font-medium text-gray-700"
        = f.select :direction, AllocationRule::DIRECTION_LABELS.map { |v, l| [l, v] }, { include_blank: "Les deux" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", data: { searchable_select_target: "select" }
        = render "shared/searchable_select_search", label: "Chercher un sens"
      div
        = f.label :min_amount, "Montant minimum (€)", class: "block text-sm font-medium text-gray-700"
        = f.text_field :min_amount, value: rule.min_amount_cents ? number_with_precision(rule.min_amount_cents / 100.0, precision: 2, separator: ",") : nil, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm"
      div
        = f.label :max_amount, "Montant maximum (€)", class: "block text-sm font-medium text-gray-700"
        = f.text_field :max_amount, value: rule.max_amount_cents ? number_with_precision(rule.max_amount_cents / 100.0, precision: 2, separator: ",") : nil, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm"
      div(data-controller="searchable-select" data-searchable-select-placeholder-value="Tous les comptes" data-searchable-select-clearable-value="true" class="relative")
        = f.label :cash_account_id, "Compte de trésorerie", class: "block text-sm font-medium text-gray-700"
        = f.collection_select :cash_account_id, CashAccount.ordered, :id, :name, { include_blank: "Tous" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", data: { searchable_select_target: "select" }
        = render "shared/searchable_select_search", label: "Chercher un compte de trésorerie"
        p.mt-1.text-xs.text-gray-500 Limite la règle aux lignes de ce compte. Ne suffit pas seul : ajoute au moins un autre critère.

  .p-4.bg-white.rounded-lg.border.border-gray-100
    h3.mb-3.text-sm.font-semibold.text-gray-900 …propose cette affectation
    .grid.gap-4(class="md:grid-cols-2")
      div(data-controller="searchable-select" data-searchable-select-placeholder-value="Chercher un compte…" class="relative")
        = f.label :general_account_id, "Compte général *", class: "block text-sm font-medium text-gray-700"
        = f.collection_select :general_account_id, GeneralAccount.actives.ordered, :id, :to_s, { include_blank: "Choisir…" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", data: { searchable_select_target: "select" }
        = render "shared/searchable_select_search", label: "Chercher un compte général"
      div(data-controller="searchable-select" data-searchable-select-placeholder-value="Chercher une entité…" class="relative")
        = f.label :legal_entity_id, "Entité *", class: "block text-sm font-medium text-gray-700"
        = f.collection_select :legal_entity_id, LegalEntity.actives.ordered, :id, :name, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", data: { searchable_select_target: "select" }
        = render "shared/searchable_select_search", label: "Chercher une entité"
      div(data-controller="searchable-select" data-searchable-select-placeholder-value="Non affecté" data-searchable-select-clearable-value="true" class="relative")
        = f.label :team_id, "Pôle", class: "block text-sm font-medium text-gray-700"
        = f.collection_select :team_id, Team.ordered, :id, :name, { include_blank: "Non affecté" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", data: { searchable_select_target: "select" }
        = render "shared/searchable_select_search", label: "Chercher un pôle"
      div(data-controller="searchable-select" data-searchable-select-placeholder-value="Aucun événement" data-searchable-select-clearable-value="true" class="relative")
        = f.label :event_id, "Événement", class: "block text-sm font-medium text-gray-700"
        = f.collection_select :event_id, Event.where("starts_at >= ?", 18.months.ago).order(starts_at: :desc), :id, ->(e) { "#{e.name} — #{l(e.starts_at.to_date, format: :short)}" }, { include_blank: "Aucun" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", data: { searchable_select_target: "select" }
        = render "shared/searchable_select_search", label: "Chercher un événement"
        p.mt-1.text-xs.text-gray-500
          | « La communication contient STAGE LOWTECH » proposera aussi l'événement. La règle propose ; elle n'affecte jamais.

  .flex.items-center.gap-3
    = f.submit "Enregistrer", class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-4 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90"
    = link_to "Annuler", finance_allocation_rules_path, class: "text-sm text-gray-500 hover:text-gray-700"
