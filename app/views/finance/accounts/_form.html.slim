.border-l-8.border-indigo-700.-ml-4.pl-4.md:p-0.md:m-0.md:border-0.grid.grid-cols-1.md:grid-cols-3.md:gap-4
  .md:border-r-8.md:border-indigo-700.md:pr-4.md:text-right
    = section_heading_tw heading: "Le compte"

  .col-span-2.mb-4.space-y-6.sm:space-y-5
    = f.text_field :name,
                   label: "Nom affiché *",
                   required: true,
                   hint: "Ce nom reste lisible même si la personne quitte l'équipe — il ne dépend pas de la fiche Humain.",
                   class: "md:w-2/3"

    = f.select :kind,
               MemberAccount::KINDS.map { |kind| [MemberAccount::KIND_LABELS.fetch(kind, kind), kind] },
               { label: "Type de compte *" },
               { class: "md:w-1/3" }

    / Un compte est ancré sur UNE seule chose. Le champ qui ne correspond pas au
      type choisi est ignoré à l'enregistrement (cf. AccountsController).
    = f.select :household_id,
               Household.ordered.map { |household| [household.name, household.id] },
               { label: "Ménage (si type « Ménage »)", include_blank: "—" },
               { class: "md:w-1/2" }

    = f.select :human_id,
               Human.all.map { |human| [human.name, human.id] },
               { label: "Personne (si type « Personne »)", include_blank: "—" },
               { class: "md:w-1/2" }

    = f.text_field :contact_email,
                   label: "Email de contact",
                   hint: "Servira à l'envoi des décomptes (phase 6).",
                   class: "md:w-1/2"

    div
      = label_tag "member_account[opening_balance_euros]", "Solde d'ouverture (€)", class: "block text-sm font-medium text-gray-700"
      = number_field_tag "member_account[opening_balance_euros]",
                         (f.object.opening_balance_cents.to_i / 100.0),
                         step: 0.01,
                         class: "mt-1 w-40 rounded-md border-gray-300 text-sm"
      p.mt-1.text-sm.text-gray-500
        | Ce que le compte devait déjà avant d'exister dans Claudy. Positif = dû par le compte.

    = f.date_field :opening_balance_on,
                   label: "Date du solde d'ouverture",
                   class: "md:w-1/3"

    = f.check_box :active
    = f.label :active, "Compte actif"

hr
