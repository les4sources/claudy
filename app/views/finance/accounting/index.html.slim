- content_for :page_header do
  = render "layouts/components/page_header", title: "Comptabilité"

= render "finance/accounting/spending_verdicts", verdicts: @verdicts

= render "finance/accounting/todo", todo: @todo

- if @treasury
  = render "finance/treasury/summary", treasury: @treasury, link: true

/ Le rappel de comptage de caisse (epic #243, phase 3). Il ne crie qu'au-delà
  de sept jours : un rappel permanent devient du décor, et on cesse de le lire.
- if @days_since_cash_count.nil? || @days_since_cash_count > 7
  .mb-6.p-4.rounded-lg.border.border-amber-200(class="bg-amber-50/70")
    .flex.flex-wrap.items-center.justify-between.gap-3
      div
        p.text-sm.font-semibold.text-amber-900
          - if @days_since_cash_count.nil?
            | La caisse n'a jamais été comptée.
          - else
            | Dernier comptage de caisse il y a #{@days_since_cash_count} jours.
        p.mt-1.text-sm.text-amber-900
          | Retrouver l'origine d'un écart sur trente jours est impossible ; sur sept, c'est une question qu'on pose au bar.
      = link_to "🧮 Compter maintenant", new_finance_cash_count_path, class: "inline-flex items-center rounded-md border border-transparent px-4 py-2 text-sm font-medium text-white shadow-sm bg-4s-main hover:opacity-90"
- else
  .mb-6.p-4.rounded-lg.border.border-emerald-100(class="bg-emerald-50/60")
    p.text-sm.text-emerald-900
      | Caisse comptée il y a #{@days_since_cash_count} jour(s) —
      = link_to "voir les comptages", finance_cash_counts_path, class: "underline hover:no-underline"
      | .

/ L'échéancier comptable : l'encart ne crie que s'il y a du retard.
.mb-6.p-4.rounded-lg.border(class="#{@deadlines_overdue.any? ? 'border-red-200 bg-red-50/70' : 'border-gray-100 bg-white'}")
  .flex.flex-wrap.items-center.justify-between.gap-3
    div
      p.text-sm.font-semibold(class="#{@deadlines_overdue.any? ? 'text-red-800' : 'text-gray-900'}")
        - if @deadlines_overdue.any?
          = "#{@deadlines_overdue.size} échéance(s) en retard"
          - if @deadlines_soon.any?
            = " · #{@deadlines_soon.size} dans les 30 jours"
        - elsif @deadlines_soon.any?
          = "#{@deadlines_soon.size} échéance(s) dans les 30 jours"
        - else
          | Aucune échéance dans les 30 jours
      - next_one = (@deadlines_overdue + @deadlines_soon).first
      - if next_one
        p.mt-1.text-sm.text-gray-600
          = "La plus urgente : #{next_one.display_title}, le #{l(next_one.due_on, format: :long)}"
    = link_to "📅 Ouvrir l'échéancier", finance_compliance_deadlines_path, class: "text-blue-500 text-sm border-b-2 border-blue-200 hover:text-blue-700"

/ Les dettes et litiges sans facture (2026-10-13) : l'encart crie dès qu'il y
  en a, entité par entité — une dette qu'on ne voit pas est une dette qu'on
  oublie de compter.
- if @open_liabilities.any?
  .mb-6.p-4.rounded-lg.border.border-red-200(class="bg-red-50/70" data-accounting-liabilities="")
    .flex.flex-wrap.items-center.justify-between.gap-3
      div
        p.text-sm.font-semibold.text-red-800
          = "#{@open_liabilities.size} dette(s) ou litige(s) sans facture : #{number_to_currency(@open_liabilities.sum(&:remaining_cents) / 100.0, unit: '€', precision: 0)} retenus"
        ul.mt-1.text-sm.text-red-900
          - @open_liabilities.group_by(&:legal_entity).sort_by { |entity, _| entity.name }.each do |entity, rows|
            li= "#{entity.name} : #{number_to_currency(rows.sum(&:remaining_cents) / 100.0, unit: '€', precision: 0)} (#{rows.map(&:label).first(3).join(', ')}#{' …' if rows.size > 3})"
      = link_to "⚖️ Dettes et litiges", finance_liabilities_path, class: "text-blue-500 text-sm border-b-2 border-blue-200 hover:text-blue-700"
- else
  .mb-6.p-4.rounded-lg.border.border-gray-100.bg-white
    .flex.flex-wrap.items-center.justify-between.gap-3
      p.text-sm.text-gray-700 Aucune dette ni aucun litige sans facture n'est enregistré.
      = link_to "⚖️ Enregistrer une dette ou un litige", new_finance_liability_path, class: "text-blue-500 text-sm border-b-2 border-blue-200 hover:text-blue-700"

/ Les prêts reçus (2026-10-13), lus au grand livre (comptes 17) : ce qui reste
  dû à chaque prêteur. Un prêt gonfle la banque sans être de la marge.
.mb-6.p-4.rounded-lg.border.border-gray-100.bg-white(data-accounting-loans="")
  - if @loans.any?
    p.text-sm.font-semibold.text-gray-900
      = "Prêts reçus : #{number_to_currency(@loans.owed_cents / 100.0, unit: '€', precision: 0)} restent dus"
    p.mt-1.text-sm.text-gray-600
      | Lu au grand livre, comptes 17. Un prêt dont la ligne de banque attend encore dans « À affecter » n'y est pas.
    - @loans.groups.each do |group|
      .mt-4
        p.text-xs.uppercase.text-gray-400= "#{group.entity.name} · #{number_to_currency(group.owed_cents / 100.0, unit: '€', precision: 0)}"
        .overflow-x-auto.relative.mt-2
          table.w-full.text-sm.text-left.text-gray-500(data-controller="stacked-table")
            thead.text-xs.text-gray-700.uppercase.bg-gray-50
              tr
                th.py-2.px-4[scope="col"] Prêteur
                th.py-2.px-4[scope="col"] Compte
                th.py-2.px-4.text-right[scope="col"] Emprunté
                th.py-2.px-4.text-right[scope="col"] Remboursé
                th.py-2.px-4.text-right[scope="col"] Reste dû
                th.py-2.px-4[scope="col"] Dernier mouvement
            tbody
              - group.lenders.each do |lender|
                tr.border-b.bg-white
                  td.py-2.px-4.font-medium.text-gray-900
                    = lender.name
                    - unless lender.named?
                      .text-xs.text-gray-400 Prêteur non nommé sur la ligne
                    - if lender.long_term?
                      .text-xs.text-gray-400 Long terme : hors de « Peut-on dépenser ? »
                  td.py-2.px-4
                    = link_to "#{lender.account.code} #{lender.account.name}",
                              finance_ledger_path(general_account_id: lender.account.id, legal_entity_id: group.entity.id),
                              class: "text-blue-500 hover:text-blue-700"
                  td.py-2.px-4.text-right= number_to_currency(lender.borrowed_cents / 100.0, unit: "€")
                  td.py-2.px-4.text-right= number_to_currency(lender.repaid_cents / 100.0, unit: "€")
                  td.py-2.px-4.text-right.font-semibold(class="#{lender.owed_cents.negative? ? 'text-red-700' : 'text-gray-900'}")
                    = number_to_currency(lender.owed_cents / 100.0, unit: "€")
                  td.py-2.px-4= l(lender.last_movement_on)
  - else
    p.text-sm.text-gray-700 Aucun prêt en cours au grand livre (comptes 17).

.grid.gap-4.mb-8(class="md:grid-cols-3")
  .p-5.bg-white.rounded-lg.border.border-gray-100
    p.text-xs.uppercase.text-gray-400 Plan comptable
    p.mt-1.text-2xl.font-semibold.text-gray-900= @accounts_count
    p.mt-2
      = link_to "Consulter et corriger", finance_general_accounts_path, class: "text-blue-500 text-sm border-b-2 border-blue-200 hover:text-blue-700"
  .p-5.bg-white.rounded-lg.border.border-gray-100
    p.text-xs.uppercase.text-gray-400 Écritures passées
    p.mt-1.text-2xl.font-semibold.text-gray-900= @entries_count
    p.mt-2
      = link_to "Ouvrir le grand livre", finance_ledger_path, class: "text-blue-500 text-sm border-b-2 border-blue-200 hover:text-blue-700"
  .p-5.bg-white.rounded-lg.border.border-gray-100
    p.text-xs.uppercase.text-gray-400 Exercices ouverts
    p.mt-1.text-2xl.font-semibold.text-gray-900= @open_years.size
    p.mt-2
      = link_to "Gérer les exercices", finance_fiscal_years_path, class: "text-blue-500 text-sm border-b-2 border-blue-200 hover:text-blue-700"

h3.mb-3.text-lg.font-semibold.text-gray-900 Entités juridiques
- if @entities.blank?
  .p-6.text-sm.text-gray-500.bg-white.rounded-lg.border.border-gray-100
    p Aucune entité — lance <code>rake accounting:seed_reference</code>.
- else
  .overflow-x-auto.relative.mb-4
    table.w-full.text-sm.text-left.text-gray-500(data-controller="stacked-table")
      thead.text-xs.text-gray-700.uppercase.bg-gray-50
        tr
          th.py-3.px-6[scope="col"] Entité
          th.py-3.px-6[scope="col"] Forme
          th.py-3.px-6[scope="col"] TVA
          th.py-3.px-6[scope="col"] Exercices
      tbody
        - @entities.each do |entity|
          tr.border-b.bg-white
            td.py-4.px-6.font-medium.text-gray-900= entity.name
            td.py-4.px-6= entity.form_label
            td.py-4.px-6
              = entity.vat_regime_label
              - if entity.vat_number.present?
                .text-xs.text-gray-400= entity.vat_number
            td.py-4.px-6= entity.fiscal_years.size
= link_to "Gérer les entités", finance_legal_entities_path, class: "text-blue-500 text-sm border-b-2 border-blue-200 hover:text-blue-700"
