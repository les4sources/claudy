/ Les prêts à rendre, compte par compte : le sous-total d'un compte est ce
  que le verdict retire. Un compte débiteur reste affiché, à zéro, pour qu'on
  le vérifie.
- euros = ->(cents) { number_to_currency(cents / 100.0, unit: "€") }
- accounts = verdict.short_term_loan_accounts
- if accounts.empty?
  p.text-sm.text-gray-500 Aucun prêt à rendre au grand livre.
- else
  div(class="max-h-[60vh] overflow-y-auto rounded border border-gray-200")
    table.w-full.text-sm
      thead.bg-gray-50.text-xs.uppercase.text-gray-500
        tr
          th.py-2.px-3.text-left[scope="col"] Prêteur
          th.py-2.px-3.text-left[scope="col"] Dernier mouvement
          th.py-2.px-3.text-right[scope="col"] Emprunté
          th.py-2.px-3.text-right[scope="col"] Remboursé
          th.py-2.px-3.text-right[scope="col"] Reste dû
      - accounts.each do |account, lenders|
        - owed = lenders.sum(&:owed_cents)
        tbody
          tr.border-t.border-gray-200.bg-gray-50
            th.py-2.px-3.text-left.font-medium.text-gray-700(scope="rowgroup" colspan="4")
              = link_to "#{account.code} #{account.name}",
                        finance_ledger_path(general_account_id: account.id, legal_entity_id: verdict.entity.id),
                        data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800"
              - if owed.negative?
                span.ml-2.text-xs.font-normal.text-red-700= "solde débiteur de #{euros.(-owed)} : ne compte pas, à vérifier"
            td.py-2.px-3.text-right.font-medium.tabular-nums.whitespace-nowrap.text-gray-700= euros.([owed, 0].max)
          - lenders.sort_by { |lender| [-lender.owed_cents, lender.name] }.each do |lender|
            tr.border-t.border-gray-100
              td.py-2.px-3.text-gray-900
                = lender.name
                - unless lender.named?
                  span.ml-2.text-xs.text-gray-400 prêteur non nommé sur la ligne
              td.py-2.px-3.whitespace-nowrap.text-gray-500= l(lender.last_movement_on, format: :ddmmyyyy)
              td.py-2.px-3.text-right.tabular-nums.whitespace-nowrap.text-gray-500= euros.(lender.borrowed_cents)
              td.py-2.px-3.text-right.tabular-nums.whitespace-nowrap.text-gray-500= euros.(lender.repaid_cents)
              td.py-2.px-3.text-right.tabular-nums.whitespace-nowrap(class="#{lender.owed_cents.negative? ? 'text-red-700' : 'text-gray-900'}")
                = euros.(lender.owed_cents)
      tfoot.bg-gray-50
        tr.border-t.border-gray-200
          td.py-2.px-3.font-medium.text-gray-700(colspan="4") Total
          td.py-2.px-3.text-right.font-semibold.tabular-nums.text-gray-900= euros.(verdict.loans_cents)
