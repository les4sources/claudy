/ Les dettes et litiges dont des mensualités tombent après l'horizon : une
  ligne par dette, ses échéances restantes résumées.
- euros = ->(cents) { number_to_currency(cents / 100.0, unit: "€") }
- outflows = treasury.liability_outflows_beyond_horizon
- if outflows.empty?
  p.text-sm.text-gray-500 Aucune dette ni aucun litige au-delà de l'horizon.
- else
  div(class="max-h-[60vh] overflow-y-auto rounded border border-gray-200")
    table.w-full.text-sm
      thead.bg-gray-50.text-xs.uppercase.text-gray-500
        tr
          th.py-2.px-3.text-left[scope="col"] Dette ou litige
          th.py-2.px-3.text-left[scope="col"] Tiers
          th.py-2.px-3.text-left[scope="col"] Échéances
          th.py-2.px-3.text-right[scope="col"] Montant retenu
      tbody
        - outflows.group_by(&:liability).each do |liability, rows|
          - dates = rows.map(&:due_on).sort
          tr.border-t.border-gray-100(data-liability-id=liability.id)
            td.py-2.px-3.text-gray-900
              = link_to liability.label, edit_finance_liability_path(liability),
                        data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800"
              span.ml-2.inline-flex.rounded-full.bg-amber-100.px-2.py-0.5.text-xs.text-amber-800= liability.kind_label.downcase
            td.py-2.px-3.text-gray-500= liability.third_party&.name || "—"
            td.py-2.px-3.whitespace-nowrap.text-gray-500
              - if dates.size == 1
                = "le #{l(dates.first, format: :ddmmyyyy)}"
              - else
                = "#{dates.size} mensualités, du #{l(dates.first, format: :ddmmyyyy)} au #{l(dates.last, format: :ddmmyyyy)}"
            td.py-2.px-3.text-right.tabular-nums.whitespace-nowrap.text-gray-900= euros.(rows.sum(&:amount_cents))
      tfoot.bg-gray-50
        tr.border-t.border-gray-200
          td.py-2.px-3.font-medium.text-gray-700(colspan="3") Total
          td.py-2.px-3.text-right.font-semibold.tabular-nums.text-gray-900= euros.(outflows.sum(&:amount_cents))
  p.mt-4.text-xs.text-gray-500
    = link_to "Ouvrir les dettes et litiges", finance_liabilities_path, data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800"
