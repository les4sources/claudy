/ Ce qui sort dans l'horizon, rangé par nature : une estimation (charge
  fixe, mensualité d'un litige) ne doit pas passer pour une facture.
- euros = ->(cents) { number_to_currency(cents / 100.0, unit: "€") }
- outflows = treasury.outflows_in_horizon
- groups = [["Factures et dettes (file « À payer »)", outflows.reject { |o| o.recurring? || o.liability? }],
            ["Charges fixes", outflows.select(&:recurring?)],
            ["Dettes et litiges sans facture", outflows.select(&:liability?)]].reject { |_, rows| rows.empty? }
- if groups.empty?
  p.text-sm.text-gray-500 Rien à payer.
- else
  div(class="max-h-[60vh] overflow-y-auto rounded border border-gray-200")
    table.w-full.text-sm
      thead.bg-gray-50.text-xs.uppercase.text-gray-500
        tr
          th.py-2.px-3.text-left[scope="col"] Échéance
          th.py-2.px-3.text-left[scope="col"] Dette
          th.py-2.px-3.text-left[scope="col"] Bénéficiaire
          th.py-2.px-3.text-right[scope="col"] Reste à payer
      - groups.each do |label, rows|
        tbody
          tr.border-t.border-gray-200.bg-gray-50
            th.py-2.px-3.text-left.font-medium.text-gray-700(scope="rowgroup" colspan="3")
              = "#{label} · #{rows.size}"
            td.py-2.px-3.text-right.font-medium.tabular-nums.whitespace-nowrap.text-gray-700= euros.(rows.sum(&:amount_cents))
          - rows.each do |outflow|
            tr.border-t.border-gray-100
              td.py-2.px-3.whitespace-nowrap.text-gray-500= l(outflow.due_on, format: :ddmmyyyy)
              td.py-2.px-3.text-gray-900
                - if outflow.liability?
                  = link_to outflow.liability.label, edit_finance_liability_path(outflow.liability),
                            data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800"
                  span.ml-2.inline-flex.rounded-full.bg-amber-100.px-2.py-0.5.text-xs.text-amber-800= outflow.liability.kind_label.downcase
                - elsif outflow.recurring?
                  = link_to outflow.recurring_expense.label, edit_finance_recurring_expense_path(outflow.recurring_expense),
                            data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800"
                - elsif outflow.payable.payable_path
                  = link_to outflow.payable.payable_label, outflow.payable.payable_path,
                            data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800"
                - else
                  = outflow.payable.payable_label
              td.py-2.px-3.text-gray-500
                - if outflow.liability?
                  = outflow.liability.third_party&.name || "—"
                - elsif outflow.recurring?
                  = outflow.recurring_expense.third_party&.name || "—"
                - else
                  = outflow.payable.payable_beneficiary.presence || "—"
              td.py-2.px-3.text-right.tabular-nums.whitespace-nowrap.text-gray-900= euros.(outflow.amount_cents)
      tfoot.bg-gray-50
        tr.border-t.border-gray-200
          td.py-2.px-3.font-medium.text-gray-700(colspan="3") Total
          td.py-2.px-3.text-right.font-semibold.tabular-nums.text-gray-900= euros.(outflows.sum(&:amount_cents))
  p.mt-4.text-xs.text-gray-500
    = link_to "Ouvrir la file « À payer »", finance_payables_path, data: { turbo_frame: "_top" }, class: "text-blue-600 hover:text-blue-800"
