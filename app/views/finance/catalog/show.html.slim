- content_for :page_header do
  = render "layouts/components/page_header",
           title: @item.name,
           links: [ \
             link_to("Modifier", edit_finance_catalog_path(@item), class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"), \
             link_to("Supprimer", finance_catalog_path(@item), data: { turbo_method: :delete, turbo_confirm: "Supprimer « #{@item.name} » du catalogue ? Les écritures passées gardent leur libellé et leur prix." }, class: "inline-flex items-center rounded-md border border-red-200 bg-white px-4 py-2 text-sm font-medium text-red-600 shadow-sm hover:bg-red-50"), \
             link_to("← Tout le catalogue", finance_catalog_index_path(channel: @item.channel), class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50") \
           ]

- item = CatalogItemDecorator.decorate(@item)

.mb-6.flex.flex-wrap.items-baseline.gap-x-8.gap-y-2
  div
    .text-xs.uppercase.text-gray-400 Prix sourcier
    .text-3xl.font-semibold.text-gray-900= item.member_price
  div
    .text-xs.uppercase.text-gray-400 Prix public
    .text-xl.text-gray-700= item.public_price
  div
    .text-xs.uppercase.text-gray-400 Canal
    .text-sm.text-gray-700
      span class="px-2 py-0.5 rounded-full text-xs #{item.channel_badge_css}"
        = item.channel_label
      span.ml-2.text-gray-500= item.unit_suffix
  div
    .text-xs.uppercase.text-gray-400 Palier en vigueur
    .text-sm.text-gray-700= item.price_period

/  Même vocabulaire que les formulaires en ligne de la fiche d'un compte
   (`finance/accounts/show`) : la section Finances doit se lire comme un seul
   outil, pas comme six écrans construits l'un après l'autre.
- panel = "mb-8 p-5 bg-white rounded-2xl ring-1 ring-gray-200"
- panel_title = "text-base font-semibold text-gray-900 mb-2"
- field_label = "block text-sm font-medium text-gray-700 mb-1"
- field_input = "block w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500"
- money_input = field_input + " text-right tabular-nums"
- primary_button = "w-full md:w-auto inline-flex items-center justify-center rounded-md bg-green-700 px-5 py-2 text-sm font-medium text-white shadow-sm hover:bg-green-800 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2"
- action_row = "mt-4 flex flex-col gap-3 border-t border-gray-100 pt-4 md:flex-row md:items-center md:justify-between"
- action_hint = "text-xs text-gray-500 md:max-w-xl"

div(class=panel data-controller="catalog-price" data-catalog-price-url-value=finance_catalog_suggest_price_path data-catalog-price-channel-value=@item.channel)
  h3(class=panel_title) Nouveau palier de prix

  - marge = Pricing::Rates.cents(Catalog::BuildPrice.margin_key(@item.channel)) || Catalog::BuildPrice::DEFAULT_MARGINS[@item.channel]
  p.mb-4.text-sm.text-gray-500
    | Saisis le prix d'achat : le prix sourcier se calcule tout seul, avec la marge
    strong = " #{@item.channel_label} de #{marge} %"
    |  (modifiable dans
    = link_to "Paramètres > Tarifs", rates_path, class: "underline"
    | ). Tu peux l'écraser à la main — c'est la valeur du champ qui est enregistrée.
    - if @item.channel == "grocery"
      |  Le prix public se propose depuis le prix de référence, quand il y en a un.

  / Champs nus (`*_tag`) et non `f.text_field` : le builder maison
    (`FormBuilders::TailwindFormBuilder`) génère son propre libellé à partir du
    nom du champ, ce qui doublerait chaque intitulé — « À partir du » suivi de
    « Catalog price[active from] ». Les montants sont de toute façon saisis en
    euros et convertis dans le contrôleur, ils ne collent à aucun attribut.
  = form_with url: finance_catalog_prices_path(@item), method: :post do
    /  La date ouvre la ligne, puis les quatre montants forment une échelle qu'on
       lit de gauche à droite — achat, référence, sourcier, public. Ils portent la
       même largeur parce qu'ils sont la même chose.
       La rangée n'occupe volontairement que 10 des 12 colonnes : cinq champs
       courts étirés sur toute la largeur mentent sur ce qu'on y saisit.
    .grid.grid-cols-1.gap-4(class="md:grid-cols-12 md:gap-3")
      div(class="md:col-span-2")
        = label_tag "catalog_price[active_from]", "À partir du", class: field_label
        = date_field_tag "catalog_price[active_from]", Date.current, class: field_input
      div(class="md:col-span-2")
        = label_tag "catalog_price[purchase_price]", "Achat (€)", class: field_label
        = text_field_tag "catalog_price[purchase_price]", nil, inputmode: "decimal", placeholder: "0,00", data: { catalog_price_target: "purchase", action: "input->catalog-price#suggest" }, class: money_input
      div(class="md:col-span-2")
        = label_tag "catalog_price[reference_price]", "Référence (€)", class: field_label
        = text_field_tag "catalog_price[reference_price]", nil, inputmode: "decimal", placeholder: "0,00", data: { catalog_price_target: "reference", action: "input->catalog-price#suggest" }, class: money_input
      div(class="md:col-span-2")
        = label_tag "catalog_price[member_price]", "Sourcier (€)", class: field_label
        = text_field_tag "catalog_price[member_price]", nil, inputmode: "decimal", placeholder: "auto", data: { catalog_price_target: "member" }, class: money_input
      div(class="md:col-span-2")
        = label_tag "catalog_price[public_price]", "Public (€)", class: field_label
        = text_field_tag "catalog_price[public_price]", nil, inputmode: "decimal", placeholder: "0,00", data: { catalog_price_target: "public" }, class: money_input

    div(class=action_row)
      p(class=action_hint)
        | Laisse « Sourcier » vide pour le calcul automatique. Un palier déjà posé ne bouge jamais, même si la marge change ensuite.
      button(class=primary_button type="submit") Ajouter

= section_heading_tw heading: "Historique des paliers"

- if @prices.blank?
  p.text-sm.text-gray-500 Aucun palier — cet article n'a pas encore de prix.
- else
  .overflow-x-auto.relative
    table.w-full.text-sm.text-left.text-gray-500
      thead.text-xs.text-gray-700.uppercase.bg-gray-50
        tr
          th.py-3.px-6[scope="col"] Période
          th.py-3.px-6.text-right[scope="col"] Achat
          th.py-3.px-6.text-right[scope="col"] Référence
          th.py-3.px-6.text-right[scope="col"] Sourcier
          th.py-3.px-6.text-right[scope="col"] Public
          th.py-3.px-6[scope="col"]
      tbody
        - @prices.each do |price|
          tr.border-b.bg-white class=(price.current? ? "bg-teal-50/40" : "")
            td.py-3.px-6
              - if price.open_ended?
                | depuis le #{l(price.active_from, format: :long).squish}
              - else
                | du #{l(price.active_from, format: :long).squish} au #{l(price.active_until, format: :long).squish}
              - if price.current?
                span.ml-2.px-2.py-0.5.rounded-full.text-xs.bg-teal-100.text-teal-800 en vigueur
              - if price.note.present?
                .mt-0.5.text-xs.text-gray-400= price.note
            td.py-3.px-6.text-right.text-gray-400= price.purchase_price_cents ? number_to_currency(price.purchase_price_cents / 100.0) : "—"
            td.py-3.px-6.text-right.text-gray-400= price.reference_price_cents ? number_to_currency(price.reference_price_cents / 100.0) : "—"
            td.py-3.px-6.text-right.font-semibold.text-gray-900= number_to_currency(price.member_price_cents / 100.0)
            td.py-3.px-6.text-right= price.public_price_cents ? number_to_currency(price.public_price_cents / 100.0) : "—"
            td.py-3.px-6.text-right
              = button_to "Supprimer",
                          finance_catalog_price_path(@item, price),
                          method: :delete,
                          form: { data: { turbo_confirm: "Supprimer ce palier ?" } },
                          class: "text-xs text-red-600 hover:text-red-800"
