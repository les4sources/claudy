- content_for :page_header do
  = render "layouts/components/page_header",
           title: "Catalogue",
           links: [ \
             link_to("🖨️ Liste sourcier", finance_catalog_print_path(audience: "member", channel: @channel), class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50", target: "_blank"), \
             link_to("🖨️ Liste publique", finance_catalog_print_path(audience: "public", channel: @channel), class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50", target: "_blank"), \
             link_to("➕ Nouvel article", new_finance_catalog_path(channel: @channel), class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2") \
           ]

/ Filtre de canal dans l'URL, comme le filtre actif/inactif des comptes : il se
  partage et survit au rechargement. La recherche ne recharge que la frame des
  résultats : le champ reste en place et, sur iPad ou iPhone, le clavier ne se
  ferme plus à chaque lettre. Les canaux sont des boutons du même formulaire
  (en page entière, `_top`) pour emporter la recherche en cours ; placés après
  le champ caché, leur `channel` l'emporte sur le sien.
= form_with url: finance_catalog_index_path, method: :get, data: { controller: "auto-submit", auto_submit_delay_value: 300, turbo_frame: "catalog-results" }, class: "mb-4 flex flex-wrap items-center gap-4" do |f|
  = f.hidden_field :channel, value: @channel, id: nil
  / Bouton par défaut de la touche Entrée : sans lui, ce serait « Tous ».
  button.sr-only type="submit" tabindex="-1" aria-hidden="true" Chercher
  .flex.items-center.gap-2.text-sm
    - ({ nil => "Tous" }.merge(CatalogItem::CHANNEL_LABELS)).each do |value, label|
      button[type="submit" name="channel" value=value.to_s data-turbo-frame="_top"
             class="px-3 py-1.5 rounded-md transition-colors #{@channel == value ? 'text-4s-main bg-teal-50 font-medium' : 'text-gray-500 hover:text-4s-main hover:bg-teal-50/60'}"]
        = label

  / Champ nu (`text_field_tag`) et non `f.text_field` : le builder maison
    (`FormBuilders::TailwindFormBuilder`) ajoute un libellé tiré du nom du
    champ, qui affichait un « Q » au-dessus de la recherche.
  = text_field_tag :q, @term,
                   placeholder: "Chercher un article…",
                   aria: { label: "Chercher un article" },
                   autocomplete: "off", autocorrect: "off", autocapitalize: "off", spellcheck: "false",
                   data: { action: "input->auto-submit#submit" },
                   class: "rounded-md border-gray-300 text-sm shadow-sm focus:border-indigo-500 focus:ring-indigo-500"

= turbo_frame_tag "catalog-results", target: "_top", data: { turbo_action: "advance" } do
  - if @active_items.blank? && @inactive_items.blank?
    .p-6.text-sm.text-gray-500.bg-white.rounded-lg.border.border-gray-100
      p.font-medium.text-gray-700 Aucun article pour ce filtre.
      p.mt-1
        | Crée un article, puis pose-lui un premier palier de prix.
  - else
    - if @active_items.any?
      = render "items_table", items: @active_items
    - else
      p.p-6.text-sm.text-gray-500.bg-white.rounded-lg.border.border-gray-100 Aucun article actif pour ce filtre.

    /  Les inactifs sous la liste, jamais mêlés aux actifs : ils ne se vendent
       plus, mais les fiches passées les portent et on doit pouvoir les rouvrir.
    - if @inactive_items.any?
      section.mt-10(aria-labelledby="catalog-inactive-heading")
        h3#catalog-inactive-heading.mb-3.text-base.font-semibold.text-gray-500
          = "Articles inactifs (#{@inactive_items.size})"
        .opacity-75
          = render "items_table", items: @inactive_items
