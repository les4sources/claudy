/ Une ligne de note de frais. Rendue en boucle pour les lignes existantes, et
  une fois de plus dans un <template> avec l'index NEW_RECORD pour servir de
  gabarit au bouton « Ajouter une ligne » (contrôleur `expense_lines`).

  Les `data-expense-field` nomment les trois champs dont la ligne suivante
  hérite : sur une feuille papier, six dépenses tombent presque toujours dans le
  même pôle et le même compte.
.rounded-lg.border.border-gray-200.bg-white.p-4(data-expense-lines-target="row")
  .grid.grid-cols-1.gap-3(class="md:grid-cols-12")
    .md:col-span-2
      = line_form.date_field :spent_on, label: "Date *", class: "w-full", data: { expense_field: "spent_on" }
    .md:col-span-4
      = line_form.text_field :label, label: "Dépense *", placeholder: "Visserie, sacs de terreau…", class: "w-full", data: { expense_field: "label" }
    .md:col-span-3
      = line_form.text_field :supplier_name, label: "Fournisseur", placeholder: "Brico Yvoir", class: "w-full"
    .md:col-span-2
      = line_form.text_field :amount_in_euros,
                             label: "Montant € *",
                             value: line_form.object&.amount_in_euros,
                             inputmode: "decimal",
                             placeholder: "24,90",
                             class: "w-full text-right tabular-nums",
                             data: { expense_lines_target: "amount", action: "input->expense-lines#refresh" }
    .md:col-span-1.flex.items-end.justify-end.pb-1
      button.text-xs.font-medium.text-red-600(type="button" class="hover:underline" data-action="expense-lines#remove" aria-label="Retirer cette ligne")
        | Retirer

  .mt-3.grid.grid-cols-1.gap-3(class="md:grid-cols-12")
    .md:col-span-4
      = line_form.label :general_account_id, "Compte de charge *", class: "mb-1 block text-sm font-medium text-gray-700"
      = line_form.collection_select :general_account_id, accounts, :id, :to_s,
                                    { include_blank: "Choisir un compte…" },
                                    class: "block w-full rounded-md border-gray-300 shadow-sm text-sm",
                                    data: { expense_field: "general_account_id" }
    .md:col-span-3
      = line_form.label :team_id, "Pôle", class: "mb-1 block text-sm font-medium text-gray-700"
      = line_form.collection_select :team_id, teams, :id, :name,
                                    { include_blank: "Aucun" },
                                    class: "block w-full rounded-md border-gray-300 shadow-sm text-sm",
                                    data: { expense_field: "team_id" }
    .md:col-span-2
      = line_form.label :doc_kind, "Pièce", class: "mb-1 block text-sm font-medium text-gray-700"
      = line_form.select :doc_kind,
                         ExpenseLine::DOC_KIND_LABELS.map { |value, label| [label, value] },
                         { include_blank: "—" },
                         class: "block w-full rounded-md border-gray-300 shadow-sm text-sm"
    .md:col-span-3
      = line_form.label :receipt, "Ticket ou facture", class: "mb-1 block text-sm font-medium text-gray-700"
      = line_form.file_field :receipt, label: false, accept: "image/*,application/pdf", class: "block w-full text-xs text-gray-600"
      - if line_form.object&.receipt&.attached?
        p.mt-1.text-xs.text-gray-500
          = link_to line_form.object.receipt.filename.to_s, rails_blob_path(line_form.object.receipt, disposition: "inline"), target: "_blank", rel: "noopener", class: "text-4s-main hover:underline"
          |  — déposer un fichier le remplace.

  - if line_form.object&.persisted?
    = line_form.hidden_field :_destroy, value: "0"
