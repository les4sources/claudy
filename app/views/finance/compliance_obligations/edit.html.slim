- content_for :page_header do
  = render "layouts/components/page_header", title: @obligation.title

= form_with model: @obligation, url: finance_compliance_obligation_path(@obligation), scope: :compliance_obligation, method: :patch do |f|
  .space-y-8.divide-y.divide-gray-200.sm:space-y-5
    .space-y-6.sm:space-y-5
      = render "form", f: f

  = f.actions do
    = f.submit "Enregistrer"
