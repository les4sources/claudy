- content_for :page_header do
  = render "layouts/components/page_header", title: "Relevé — #{@human.name}"

.space-y-6
  .overflow-hidden.bg-white.shadow.sm:rounded-lg
    .px-4.py-5.sm:px-6.border-b.border-gray-200.flex.flex-wrap.items-baseline.justify-between.gap-3
      div
        h3.text-lg.font-medium.leading-6.text-gray-900 = @statement.period_label
        p.text-sm.text-gray-500 = "référence #{@statement.reference}"
      span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium #{@statement.paid? ? 'bg-teal-100 text-teal-800' : (@statement.issued? ? 'bg-amber-100 text-amber-800' : 'bg-gray-100 text-gray-600')}"
        = @statement.status_label

    .overflow-x-auto
      table.w-full.text-sm.text-left.text-gray-500
        thead.text-xs.text-gray-700.uppercase.bg-gray-50
          tr
            th.py-2.px-4[scope="col"] Date
            th.py-2.px-4[scope="col"] Activité
            th.py-2.px-4.text-right[scope="col"] Rémunération
            - if @statement.draft?
              th.py-2.px-4[scope="col"]
                span.sr-only Corriger
        tbody
          - @lines.each do |line|
            tr.border-b.bg-white
              td.py-2.px-4.whitespace-nowrap
                - if line.occurred_on
                  = l(line.occurred_on, format: :short)
              td.py-2.px-4.text-gray-900
                = line.display_label
                - if @statement.draft?
                  = link_to " · réservation ##{line.experience_booking_id}", experience_booking_path(line.experience_booking_id), class: "text-xs text-gray-400 hover:text-4s-main"
              - if @statement.draft?
                / Brouillon : le montant se corrige ici (la réservation suit),
                  la ligne se reporte au prochain relevé ou ne se paie pas.
                td.py-2.px-4.text-right
                  = form_with url: finance_carrier_statement_line_path(@statement, line), method: :patch, class: "inline-flex items-center justify-end gap-1" do
                    = text_field_tag :fee, format("%.2f", line.fee_cents.to_i / 100.0).tr(".", ","),
                                     inputmode: "decimal", "aria-label": "Rémunération de #{line.display_label}",
                                     class: "w-24 rounded-md border-gray-300 py-1 text-right text-sm shadow-sm"
                    span.text-gray-500 €
                    = submit_tag "Corriger", class: "rounded-md bg-white px-2 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
                td.py-2.px-4.whitespace-nowrap.text-right
                  .inline-flex.items-center.gap-3
                    = button_to "Reporter",
                                finance_carrier_statement_line_path(@statement, line, pay: 1),
                                method: :delete,
                                form: { data: { turbo_confirm: "Retirer cette ligne ? La prestation reviendra au prochain relevé." } },
                                class: "text-xs text-gray-600 hover:text-gray-900"
                    = button_to "Ne pas payer",
                                finance_carrier_statement_line_path(@statement, line, pay: 0),
                                method: :delete,
                                form: { data: { turbo_confirm: "Retirer cette ligne et ne pas la payer ? Sa rémunération passe à 0 €, elle ne reviendra sur aucun relevé." } },
                                class: "text-xs text-red-600 hover:text-red-800"
              - else
                td.py-2.px-4.text-right = humanized_money_with_symbol(line.fee)
        tfoot
          tr.bg-gray-50
            td.py-2.px-4.font-semibold.text-gray-900(colspan="2") Total
            td.py-2.px-4.text-right.font-semibold.text-gray-900 = humanized_money_with_symbol(@statement.total_fee)
            - if @statement.draft?
              td

    .px-4.py-4.border-t.border-gray-200.flex.flex-wrap.items-center.gap-3
      - if @statement.draft?
        = button_to "Émettre le relevé",
                    issue_finance_carrier_statement_path(@statement),
                    method: :post,
                    form: { data: { turbo_confirm: "Émettre ce relevé ? Le total sera figé, l'écriture passée, et le mail parti. Une correction demandera une contre-passation." } },
                    class: "inline-flex items-center rounded-md bg-4s-main px-4 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90"
        = button_to "Supprimer le brouillon",
                    finance_carrier_statement_path(@statement),
                    method: :delete,
                    form: { data: { turbo_confirm: "Supprimer ce brouillon ? Les prestations redeviendront disponibles pour un prochain relevé." } },
                    class: "text-sm text-red-600 hover:text-red-800"
      - else
        = link_to "Voir la page du porteur", public_carrier_statement_path(@statement.token), target: "_blank", rel: "noopener", class: "text-sm text-4s-main hover:underline"
        - if @statement.sent_at
          span.text-xs.text-gray-500 = "envoyé le #{l(@statement.sent_at.to_date, format: :long)}"
        - elsif @statement.recipient_email.blank?
          span.text-xs.text-amber-700 Aucune adresse email — partage le lien à la main.

    - unless @statement.draft?
      .px-4.py-3.border-t.border-gray-100.text-xs.text-gray-500
        - if @statement.payable_settled?
          | Ce relevé est soldé par rapprochement bancaire.
        - else
          | Il apparaît dans
          = link_to " Comptabilité > À payer", finance_payables_path, class: "text-4s-main hover:underline"
          | , avec la communication #{@statement.reference}. Il se solde par rapprochement, pas à la main.
        - if @statement.paid_through?
          p.mt-1 = "Adressé à #{@statement.payee_name}, qui paie #{@human.name}."

    / Le porteur est payé par un autre tiers depuis l'émission : la dette est
      encore au nom de l'ancien. Contre-passer et repasser, sans email.
    - if @repost.needed?
      .px-4.py-4.border-t.border-amber-200.bg-amber-50
        p.text-sm.text-amber-800
          | La fiche de #{@human.name} dit de payer #{@repost.target_name}, mais ce relevé est encore adressé à #{@statement.payee_name}. « Repasser au nom de #{@repost.target_name} » contre-passe l'écriture et la repasse, même charge, avec la dette au nom de #{@repost.target_name}. Les deux écritures restent au grand livre, aucun email ne part.
        = button_to "Repasser au nom de #{@repost.target_name}",
                    repost_finance_carrier_statement_path(@statement),
                    method: :post,
                    form: { class: "mt-3", data: { turbo_confirm: "Repasser ce relevé au nom de #{@repost.target_name} ? L'écriture actuelle sera contre-passée." } },
                    class: "inline-flex items-center rounded-md bg-4s-main px-4 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90"

  / Un relevé émis, pas encore payé, se rouvre pour être corrigé (Michael,
    2026-11-12) : contre-passation, brouillon, puis réémission.
  - if @reopen && !@statement.paid?
    .bg-white.shadow.sm:rounded-lg.px-4.py-4
      h4.text-sm.font-medium.text-gray-900 Une erreur sur ce relevé ?
      - if @reopen.possible?
        p.mt-1.text-xs.text-gray-500
          | « Rouvrir en brouillon » contre-passe l'écriture (les deux restent au grand livre) et retire la dette de « À payer ». Tu corriges alors les rémunérations ou retires des lignes, puis tu réémets : nouvelle écriture, et le relevé corrigé part à #{@statement.recipient_email || 'personne (pas d’email)'}.
        = form_with url: reopen_finance_carrier_statement_path(@statement), method: :post, class: "mt-3 flex flex-wrap items-end gap-3",
                    data: { turbo_confirm: "Rouvrir ce relevé en brouillon ? Son écriture sera contre-passée." } do
          div(class="min-w-[18rem] flex-1")
            = label_tag :reason, "Pourquoi (facultatif, inscrit dans la contre-passation)", class: "block text-xs font-medium text-gray-700"
            = text_field_tag :reason, nil, placeholder: "ex. rémunérations fausses, lignes en double", class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm"
          = submit_tag "Rouvrir en brouillon", class: "inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
      - else
        p.mt-1.text-xs.text-gray-500 = "Il ne se rouvre pas. #{@reopen.refusal}"

  - if @payments.any?
    .bg-white.shadow.sm:rounded-lg.px-4.py-4
      h4.text-sm.font-medium.text-gray-900 Paiements
      ul.mt-2.space-y-1.text-sm.text-gray-700
        - @payments.each do |allocation|
          - entry = allocation.cash_entry
          li.flex.flex-wrap.items-baseline.justify-between.gap-2
            = link_to "#{l(entry.entry_date, format: :short)} · #{entry.counterparty_name.presence || entry.label}", finance_cash_entry_path(entry), class: "text-4s-main hover:underline"
            span = humanized_money_with_symbol(Money.new(allocation.amount_cents.abs, "EUR"))
      - if @statement.partially_paid?
        p.mt-2.text-xs.text-amber-700 = "Reste #{humanized_money_with_symbol(Money.new(@statement.remaining_cents, 'EUR'))} à payer."

  / Le porteur payé sur facture (Manon, octobre 2026) : le virement est déjà
    parti, souvent en plusieurs fois, sans la référence du relevé. On le
    retrouve ici et on le rapproche, au lieu de payer une seconde fois. Hors
    de la carte du relevé : son `overflow-hidden` couperait la recherche.
  - if @candidate_entries
    .bg-white.shadow.sm:rounded-lg.px-4.py-4
      h4.text-sm.font-medium.text-gray-900 Déjà payé ?
      p.mt-1.text-xs.text-gray-500
        | Si ce porteur a été payé sur facture, choisis la ligne bancaire qui l'a réglé. Elle sera affectée à ce relevé, qui passera « Payé » une fois couvert. Recommence pour chaque virement s'il y en a plusieurs.
      = form_with url: pay_finance_carrier_statement_path(@statement), method: :post, class: "mt-3 flex flex-wrap items-end gap-3" do
        .relative.flex-1(class="min-w-[18rem]" data-controller="searchable-select" data-searchable-select-placeholder-value="Chercher par nom, communication ou montant…")
          = label_tag :cash_entry_id, "Ligne bancaire sortante, à affecter", class: "block text-xs font-medium text-gray-700"
          = select_tag :cash_entry_id,
                       options_for_select(@candidate_entries.map { |e| ["#{l(e.entry_date, format: :short)} · #{humanized_money_with_symbol(e.amount)} · #{e.counterparty_name.presence || e.label} · #{e.communication}".truncate(140), e.id] }),
                       include_blank: "— Choisir une ligne —",
                       class: "mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm",
                       data: { searchable_select_target: "select" }
          = render "shared/searchable_select_search", label: "Chercher une ligne bancaire"
        div
          = label_tag :amount, "Montant (facultatif)", class: "block text-xs font-medium text-gray-700"
          = text_field_tag :amount, nil, placeholder: humanized_money(Money.new(@statement.remaining_cents, "EUR")), inputmode: "decimal", class: "mt-1 block w-32 rounded-md border-gray-300 text-sm shadow-sm"
        = submit_tag "Rapprocher", class: "inline-flex items-center rounded-md bg-4s-main px-4 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90"
