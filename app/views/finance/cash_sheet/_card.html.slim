/ Une ligne, un écran vertical (mobile-first, AC de la phase 2).
.rounded-lg.bg-white.ring-1.ring-gray-200.px-4.py-3
  .flex.items-start.justify-between.gap-3
    div.min-w-0
      p.text-xs.text-gray-400= l(row.entry.entry_date, format: :short)
      p.font-medium.text-gray-900.break-words= row.entry.label
      p.text-xs.text-gray-500
        = row.entry.cash_motif&.label || "—"
        - if row.entry.notes.present?
          span.mx-1 ·
          = row.entry.notes
    .text-right.shrink-0
      p.font-semibold class=(row.entry.amount_cents.positive? ? "text-emerald-700" : "text-orange-700")
        = "#{row.entry.amount_cents.positive? ? '+' : '−'} #{number_to_currency(row.entry.amount_cents.abs / 100.0)}"
      p.text-xs.text-gray-400
        | solde #{number_to_currency(row.balance_cents / 100.0)}
  - unless sheet.closed?
    .mt-2
      = render "finance/cash_sheet/actions", entry: row.entry, sheet: sheet, motifs: motifs
