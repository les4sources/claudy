- content_for :page_header do
  = render "layouts/components/page_header",
           title: "À affecter",
           links: [link_to("Règles d'affectation", finance_allocation_rules_path, class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"),
                   link_to("Tout le journal", finance_cash_entries_path, class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50")]

/ Le filtre se VOIT. Arriver ici depuis l'arrêté du mois sur une file réduite à
  Stripe, sans rien qui le dise, c'est croire que la file est vide (epic #250).
- if @filter_kind.present? || @filter_account.present?
  - libelle = @filter_account&.name || CashAccount::KIND_LABELS.fetch(@filter_kind, @filter_kind)
  .mb-4.flex.flex-wrap.items-center.gap-3.rounded-lg.border.border-teal-100.p-3(class="bg-teal-50/50")
    span.text-sm.text-gray-700
      | Filtré sur
      = " "
      strong = libelle
      |  — #{@filtered_total} ligne(s) sur #{@pending_total} en attente.
    = link_to "Voir toute la file", finance_unallocated_cash_entries_path, class: "text-sm font-medium text-4s-main hover:underline"

- if @entries.blank?
  .p-8.text-center.bg-green-50.rounded-lg.border.border-green-100
    p.text-2xl.font-semibold.text-green-700
      = (@filter_kind.present? || @filter_account.present?) ? "✓ Rien à affecter ici" : "✓ Rien à affecter"
    p.mt-2.text-sm.text-gray-600 Tout ce qui est passé en trésorerie est ventilé et comptabilisé. C'est l'état dans lequel on veut finir chaque mois.
- else
  p.mb-4.text-sm.text-gray-500
    | #{(@filter_kind.present? || @filter_account.present?) ? @filtered_total : @pending_total} ligne(s) en attente
    - if @entries.total_pages > 1
      |  — page #{@entries.current_page} sur #{@entries.total_pages}
    |  . Une ligne entièrement affectée se comptabilise toute seule.
  / L'invitation ne se montre QUE quand la pile est haute : à cinq lignes, écrire
    une règle coûte plus cher que les classer à la main.
  - if @pending_total >= 20
    p.mb-4.text-sm.text-gray-600
      | Beaucoup de lignes se ressemblent d'un mois à l'autre.
      = " "
      = link_to "Écrire une règle d'affectation", finance_allocation_rules_path, class: "font-medium text-blue-500 border-b-2 border-blue-200 hover:text-blue-700"
      |  évite de reclasser la même dépense chaque mois — et propose d'un coup toutes les lignes qui lui correspondent.

  - @entries.each do |entry|
    .mb-4.p-4.bg-white.rounded-lg.border.border-gray-100
      .flex.flex-wrap.items-baseline.justify-between.gap-2.mb-3
        div
          = link_to entry.label, finance_cash_entry_path(entry), class: "font-medium text-blue-500 border-b-2 border-blue-200 hover:text-blue-700"
          .text-xs.text-gray-400
            = l(entry.entry_date, format: :short)
            |  ·
            = entry.cash_account.name
            - if entry.counterparty_name.present?
              |  ·
              = entry.counterparty_name
            - if entry.communication.present?
              |  ·
              = entry.communication
        .text-right
          .text-lg.font-semibold class="#{entry.incoming? ? 'text-green-700' : 'text-gray-900'}"
            = humanized_money_with_symbol(entry.amount)
          - if entry.allocated_cents != 0
            .text-xs.text-amber-700
              | reste #{humanized_money_with_symbol(Money.new(entry.remaining_cents, "EUR"))}
      - proposition = @stay_matches[entry.id]
      - if proposition
        / Le DÉTAIL de la ventilation, pas seulement le total : c'est ce qui
          permet de repérer d'un coup d'œil qu'on s'apprête à ranger une salle
          dans l'hébergement.
        .mb-3.p-3.rounded-lg.border.border-green-100(class="bg-green-50/60")
          .flex.flex-wrap.items-start.justify-between.gap-3
            div
              p.text-sm.text-gray-800
                strong Ce virement paie le séjour ##{proposition[:match].stay.id}
                - if proposition[:match].stay.customer
                  = " — #{proposition[:match].stay.customer.try(:organization_name).presence || [proposition[:match].stay.customer.first_name, proposition[:match].stay.customer.last_name].compact.join(' ')}"
              p.mt-0.5.text-xs.text-gray-500
                = proposition[:match].rationale
                = " (#{proposition[:match].confidence} % de confiance)"
              ul.mt-2.text-xs.text-gray-600
                - proposition[:lines].each do |ligne|
                  li
                    = "#{ligne.general_account.code} #{RevenueMapping::CATEGORY_LABELS.fetch(ligne.category, ligne.category)} : "
                    strong= humanized_money_with_symbol(Money.new(ligne.amount_cents, "EUR"))
                    - if ligne.team
                      = " · #{ligne.team.name}"
            = button_to "Ventiler ce séjour", ventilate_finance_cash_entry_path(entry, stay_id: proposition[:match].stay.id), method: :post, class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:opacity-90", form: { class: "inline" }

      / Un virement à un membre (epic #246, phase 2). Une ligne SORTANTE dont le
        montant ou l'IBAN correspond au compte créditeur d'un cuisinier : accepter
        écrit le virement sur son compte ET affecte la ligne, en un geste.
      - payouts = @payout_matches[entry.id]
      - if payouts.present?
        - payouts.first(2).each do |match|
          .mb-3.p-3.rounded-lg.border.border-purple-100(class="bg-purple-50/60")
            .flex.flex-wrap.items-center.justify-between.gap-2
              div
                p.text-sm.text-gray-800
                  strong Virement à #{match.member_account.name}
                  = " — #{humanized_money_with_symbol(Money.new(match.due_cents, 'EUR'))} en sa faveur"
                p.mt-0.5.text-xs.text-gray-500
                  = match.reason
                  = " (#{match.confidence} % de confiance)"
              = button_to "Solder son compte", payout_finance_cash_entry_path(entry, member_account_id: match.member_account.id), method: :post, class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:opacity-90", form: { class: "inline" }

      / Une facture d'achat qui attend son virement (epic #240, phase 4). Même
        forme que le virement à un membre, juste au-dessus : c'est le même geste
        sur une autre dette. LA PROPOSITION N'A RIEN ÉCRIT — c'est ce bouton qui
        crée l'allocation sur le 440000 avec la facture en document.
      - factures = @invoice_matches[entry.id]
      - if factures.present?
        - factures.first(2).each do |match|
          .mb-3.p-3.rounded-lg.border.border-orange-100(class="bg-orange-50/60")
            .flex.flex-wrap.items-center.justify-between.gap-2
              div
                p.text-sm.text-gray-800
                  strong = "Paiement de #{match.invoice.payable_label}"
                  = " — #{humanized_money_with_symbol(Money.new(match.due_cents, 'EUR'))} dus à #{match.third_party&.name}"
                p.mt-0.5.text-xs.text-gray-500
                  = match.reason
                  = " (#{match.confidence} % de confiance)"
                p.mt-0.5.text-xs
                  = link_to "Voir la facture", finance_purchase_invoice_path(match.invoice), class: "text-blue-500 hover:text-blue-700"
              = button_to "Payer cette facture", pay_invoice_finance_cash_entry_path(entry, purchase_invoice_id: match.invoice.id), method: :post, class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:opacity-90", form: { class: "inline" }

      / Une note de frais ou de mission qui attend son virement (epic #241,
        phase 3). Même forme que la facture juste au-dessus : c'est le même geste
        sur une autre dette. LA PROPOSITION N'A RIEN ÉCRIT — c'est ce bouton qui
        crée l'allocation sur le 440000 avec la note en document.
      - notes = @expense_report_matches[entry.id]
      - if notes.present?
        - notes.first(2).each do |match|
          .mb-3.p-3.rounded-lg.border.border-teal-100(class="bg-teal-50/60")
            .flex.flex-wrap.items-center.justify-between.gap-2
              div
                p.text-sm.text-gray-800
                  strong = "Paiement de #{match.report.payable_label}"
                  = " — #{humanized_money_with_symbol(Money.new(match.due_cents, 'EUR'))} dus à #{match.beneficiary}"
                p.mt-0.5.text-xs.text-gray-500
                  = match.reason
                  = " (#{match.confidence} % de confiance)"
                p.mt-0.5.text-xs
                  = link_to "Voir la note", finance_expense_report_path(match.report), class: "text-blue-500 hover:text-blue-700"
              = button_to "Payer cette note", pay_expense_report_finance_cash_entry_path(entry, expense_report_id: match.report.id), method: :post, class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:opacity-90", form: { class: "inline" }

      / Un versement Stripe (epic #250, phase 2). Une ligne bancaire ENTRANTE du
        montant exact d'un versement, à trois jours près : c'est le rapprochement
        qui se faisait de tête, à l'euro près, dans l'interface Stripe.
        LA PROPOSITION N'A RIEN ÉCRIT — c'est ce bouton qui affecte : sur le
        580000 en mode grand livre (les recettes sont déjà au journal), ou en
        ventilation complète en mode par versement.
      - versements = @stripe_matches[entry.id]
      - if versements.present?
        - versements.first(2).each do |match|
          .mb-3.p-3.rounded-lg.border.border-sky-100(class="bg-sky-50/60")
            .flex.flex-wrap.items-center.justify-between.gap-2
              div
                p.text-sm.text-gray-800
                  strong = "Versement Stripe #{match.payout.account_label}"
                  = " — #{humanized_money_with_symbol(Money.new(match.payout.amount_cents, 'EUR'))} arrivés le #{l(match.payout.arrival_date, format: :short)}"
                p.text-xs.text-gray-500(class="mt-0.5")
                  = match.reason
                  = " (#{match.confidence} % de confiance)"
                  = match.payout.ledger? ? " · mode grand livre : virement interne seul" : nil
              /  En mode « par versement », le rapprochement demanderait une
                 ventilation algébrique que `CashAllocation` refuse aujourd'hui
                 (cf. `RecordStripePayoutReconciliation`). On le DIT plutôt que
                 d'offrir un bouton qui échouerait.
              - if match.payout.ledger?
                = button_to "Rapprocher ce versement", reconcile_payout_finance_cash_entry_path(entry, stripe_payout_id: match.payout.id), method: :post, class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:opacity-90", form: { class: "inline" }
              - else
                span.text-xs.text-gray-500 Compte en mode « par versement » : à affecter à la main.

      / Une facture de VENTE qui attend son encaissement (epic #240, phase 6).
        Une ligne ENTRANTE du montant exact d'une facture émise, ou venant de
        l'IBAN déjà appris pour ce client. LA PROPOSITION N'A RIEN ÉCRIT —
        c'est ce bouton qui ventile la recette et fait passer la facture en
        « payée ». Aucune écriture de vente n'est générée (décision 8).
      - ventes = @sales_invoice_matches[entry.id]
      - if ventes.present?
        - ventes.first(2).each do |match|
          .mb-3.p-3.rounded-lg.border.border-indigo-100(class="bg-indigo-50/60")
            .flex.flex-wrap.items-center.justify-between.gap-2
              div
                p.text-sm.text-gray-800
                  strong = "Facture de vente #{match.invoice.number}"
                  = " — #{humanized_money_with_symbol(Money.new(match.invoice.total_cents, 'EUR'))} du #{l(match.invoice.issued_on, format: :short)}"
                p.mt-0.5.text-xs.text-gray-500
                  = match.reason
                  = " (#{match.confidence} % de confiance)"
                p.mt-0.5.text-xs
                  = link_to "Voir la facture", finance_sales_invoice_path(match.invoice), class: "text-blue-500 hover:text-blue-700"
              = button_to "Encaisser cette facture", collect_sales_invoice_finance_cash_entry_path(entry, sales_invoice_id: match.invoice.id), method: :post, class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:opacity-90", form: { class: "inline" }

      - suggestion = entry.allocation_suggestions.pending.ordered.first
      - if suggestion
        / La suggestion porte TOUJOURS son motif : un humain doit pouvoir juger
          sans rouvrir la configuration des règles.
        .mb-3.p-3.rounded-lg.border.border-blue-100(class="bg-blue-50/60")
          .flex.flex-wrap.items-center.justify-between.gap-2
            div
              p.text-sm.text-gray-800
                strong Proposition :
                = " #{suggestion.general_account}"
                - if suggestion.team
                  = " · #{suggestion.team.name}"
                = " · #{humanized_money_with_symbol(suggestion.amount)}"
              p.mt-0.5.text-xs.text-gray-500
                = suggestion.rationale
                = " (#{suggestion.source_label}, #{suggestion.confidence} % de confiance)"
            .flex.items-center.gap-2
              = button_to "Accepter", finance_allocation_suggestion_path(suggestion, decision: "accept"), method: :patch, class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:opacity-90", form: { class: "inline" }
              = button_to "Refuser", finance_allocation_suggestion_path(suggestion, decision: "reject"), method: :patch, class: "text-xs text-gray-500 hover:text-gray-700", form: { class: "inline" }

      = render "allocation_form", entry: entry, general_accounts: @general_accounts, teams: @teams, entities: @entities, events: @events, from_unallocated: true

  - if @entries.total_pages > 1
    .mt-6.flex.justify-center
      = will_paginate @entries
