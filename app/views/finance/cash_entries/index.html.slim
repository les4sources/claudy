- content_for :page_header do
  = render "layouts/components/page_header",
           title: "Trésorerie",
           links: [ \
             link_to("À affecter (#{@pending_count})", finance_unallocated_cash_entries_path, class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"), \
             link_to("➕ Nouvelle ligne", new_finance_cash_entry_path, class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50") \
           ]

= form_with url: finance_cash_entries_path, method: :get, class: "mb-6 p-4 bg-white rounded-lg border border-gray-100 flex flex-wrap items-end gap-4" do |f|
  div
    = f.label :cash_account_id, "Compte", class: "block text-sm font-medium text-gray-700"
    = f.collection_select :cash_account_id, @accounts, :id, :name, { include_blank: "Tous", selected: @account&.id }, class: "mt-1 rounded-md border-gray-300 text-sm shadow-sm"
  div
    = f.label :status, "Statut", class: "block text-sm font-medium text-gray-700"
    = f.select :status, CashEntry::STATUS_LABELS.map { |v, l| [l, v] }, { include_blank: "Tous", selected: @status }, class: "mt-1 rounded-md border-gray-300 text-sm shadow-sm"
  div
    = f.label :from, "Du", class: "block text-sm font-medium text-gray-700"
    = f.date_field :from, value: @from, class: "mt-1 rounded-md border-gray-300 text-sm shadow-sm"
  div
    = f.label :to, "Au", class: "block text-sm font-medium text-gray-700"
    = f.date_field :to, value: @to, class: "mt-1 rounded-md border-gray-300 text-sm shadow-sm"
  = f.submit "Afficher", class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50"

/ Le compteur qui doit tomber à zéro. C'est le seul indicateur qui dit, en un
  coup d'œil, si la comptabilité du mois est à jour.
.mb-6.p-5.rounded-lg.border class="#{@pending_count.zero? ? 'bg-green-50 border-green-100' : 'bg-amber-50 border-amber-100'}"
  p.text-xs.uppercase.text-gray-500 À affecter
  p class="mt-1 text-2xl font-semibold #{@pending_count.zero? ? 'text-green-700' : 'text-amber-700'}"
    - if @pending_count.zero?
      | ✓ tout est affecté
    - else
      = "#{@pending_count} ligne(s) — #{humanized_money_with_symbol(Money.new(@pending_cents, 'EUR'))}"

- if @entries.blank?
  .p-6.text-sm.text-gray-500.bg-white.rounded-lg.border.border-gray-100
    p.font-medium.text-gray-700 Aucune ligne de trésorerie sur cette période.
- else
  /  Le même langage que « À affecter » (Michael, 2026-09-20) : une pastille de
     date par journée, tous ses mouvements à sa droite, et sur chaque ligne le
     logo du compte de trésorerie d'où elle vient. La table à cinq colonnes
     répétait la date et le compte à chaque ligne et reléguait la communication
     dans un libellé tronqué ; ici on lit d'abord ce qu'on cherche.

     Ce journal garde ce que la file n'a pas : le STATUT. C'est justement ce
     qu'on vient y voir — une ligne affectée disparaît de la file, elle reste
     ici.
  - @entries.group_by(&:entry_date).each do |jour, mouvements|
    .mb-6.flex.items-start.gap-5
      = render "day_chip", date: jour

      .flex-grow.overflow-hidden.rounded-2xl.border.border-gray-200.bg-white.shadow-sm
        - mouvements.each_with_index do |entry, rang|
          .flex.flex-wrap.items-center.gap-4.border-gray-100(class="px-4 py-3 hover:bg-gray-50/70 #{'border-t' if rang.positive?}")
            = render "source_badge", cash_account: entry.cash_account

            .min-w-0.flex-grow.flex.flex-col(style="flex-basis: 16rem; gap: 3px")
              - principal = libelle_principal(entry)
              = link_to(principal.presence || "Sans communication", finance_cash_entry_path(entry), class: "font-semibold leading-snug #{principal.present? ? 'text-gray-900' : 'text-gray-400'} hover:text-4s-main", style: "font-size: 15px")
              .font-normal.leading-snug.text-gray-500(style="font-size: 15px")
                = entry.counterparty_name.presence || entry.cash_account.name

            .flex-shrink-0.text-right(style="width: 132px")
              .font-semibold.tabular-nums(class="#{entry.incoming? ? 'text-forest' : 'text-[#7A2E1F]'}" style="font-size: 16px")
                = number_to_currency(entry.amount_cents / 100.0)
              - if entry.status == "pending" && entry.allocated_cents != 0
                .text-amber-700(style="font-size: 11.5px")
                  | reste #{number_to_currency(entry.remaining_cents / 100.0)}

            .flex-shrink-0.flex.justify-end(style="width: 116px")
              span.inline-flex.items-center.rounded-full.px-2.5.font-medium(class="#{entry.status == 'allocated' ? 'bg-forest-tint text-forest' : entry.status == 'excluded' ? 'bg-gray-100 text-gray-500' : 'bg-amber-100 text-amber-800'}" style="height: 26px; font-size: 11.5px")
                = entry.status_label
