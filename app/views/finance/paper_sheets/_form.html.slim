/  Récapitulatif d'erreurs : rattrape les erreurs sur `:base` et sur les
   enregistrements imbriqués, que l'affichage par champ ne couvre pas.
= render "finance/shared/form_errors", record: f.object

.border-l-8.border-indigo-700.-ml-4.pl-4.md:p-0.md:m-0.md:border-0.grid.grid-cols-1.md:grid-cols-3.md:gap-4
  .md:border-r-8.md:border-indigo-700.md:pr-4.md:text-right
    = section_heading_tw heading: "La fiche"

  .col-span-2.mb-4.space-y-6.sm:space-y-5
    = f.date_field :period_month, label: "Mois *", hint: "N'importe quel jour du mois — la fiche se cale sur le 1er.", class: "md:w-1/3"

    = f.select :channel,
               PaperSheet::CHANNELS.map { |channel| [PaperSheet::CHANNEL_LABELS.fetch(channel, channel), channel] },
               { label: "Canal *" },
               { class: "md:w-1/3" }

    = f.select :entry_mode,
               PaperSheet::ENTRY_MODES.map { |mode| [PaperSheet::ENTRY_MODE_LABELS.fetch(mode), mode] },
               { label: "Mode de saisie" },
               { class: "md:w-1/2" }

    = f.file_field :photo, label: "Photo de la fiche", hint: "La fiche papier reste la pièce justificative : la photographier permet de retrouver l'origine d'une ligne contestée."

    /  L'aperçu de la photo déjà attachée : sans lui, rien à l'écran ne dit
       qu'un fichier est bien arrivé. Choisir un nouveau fichier la remplace ;
       enregistrer sans rien choisir la conserve.
    = render "finance/paper_sheets/photo", sheet: f.object

    = f.label :notes, "Notes"
    = f.text_area :notes, rows: 3

hr
