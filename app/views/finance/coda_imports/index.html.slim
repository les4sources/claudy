- content_for :page_header do
  = render "layouts/components/page_header", title: "Import CODA"

.mb-6.p-4.bg-white.rounded-lg.border.border-gray-100
  h3.mb-2.text-sm.font-semibold.text-gray-900 Déposer un relevé
  p.mb-3.text-xs.text-gray-500
    | Un fichier qui ne se referme pas sur lui-même est refusé en entier, avec l'écart chiffré. Redéposer un fichier déjà importé ne crée rien.
  = form_with url: finance_coda_imports_path, method: :post, multipart: true, class: "flex flex-wrap items-center gap-3" do |f|
    = file_field_tag :file, accept: ".cod,.coda,.txt,text/plain", class: "text-sm"
    button.inline-flex.items-center.rounded-md.border.border-transparent.px-4.py-2.text-sm.font-medium.text-white.shadow-sm(class="bg-4s-main hover:opacity-90" type="submit")
      | Importer

- if @accounts.any? { |a| a.iban.blank? }
  .mb-4.p-4.rounded-lg.border.border-amber-100(class="bg-amber-50/60")
    p.text-sm.text-gray-700
      | Certains comptes de trésorerie n'ont pas d'IBAN : l'import ne pourra pas les reconnaître.
      = link_to "Compléter", finance_legal_entities_path, class: "ml-1 text-blue-500 border-b-2 border-blue-200 hover:text-blue-700"

- if @imports.blank?
  .p-6.text-sm.text-gray-500.bg-white.rounded-lg.border.border-gray-100
    p.font-medium.text-gray-700 Aucun fichier importé pour l'instant.
- else
  .overflow-x-auto.relative
    table.w-full.text-sm.text-left.text-gray-500
      thead.text-xs.text-gray-700.uppercase.bg-gray-50
        tr
          th.py-3.px-6[scope="col"] Fichier
          th.py-3.px-6[scope="col"] Créé le
          th.py-3.px-6.text-right[scope="col"] Relevés
          th.py-3.px-6.text-right[scope="col"] Lignes
          th.py-3.px-6[scope="col"] Statut
      tbody
        - @imports.each do |coda|
          tr.border-b.bg-white
            td.py-4.px-6.font-medium.text-gray-900
              = link_to coda.filename, finance_coda_import_path(coda), class: "text-blue-500 border-b-2 border-blue-200 hover:text-blue-700"
            td.py-4.px-6= coda.creation_date ? l(coda.creation_date, format: :short) : "—"
            td.py-4.px-6.text-right= coda.statements_count
            td.py-4.px-6.text-right= coda.entries_count
            td.py-4.px-6
              span class="px-2 py-0.5 rounded-full text-xs #{coda.imported? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}"
                = coda.status_label
