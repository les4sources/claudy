= form_with model: [:finance, entity], class: "space-y-4" do |f|
  = render "finance/shared/form_errors", record: entity
  .grid.gap-4(class="md:grid-cols-2")
    div
      = f.label :name, "Nom *", class: "block text-sm font-medium text-gray-700"
      = f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
    div
      = f.label :form, "Forme *", class: "block text-sm font-medium text-gray-700"
      = f.select :form, LegalEntity::FORM_LABELS.map { |value, label| [label, value] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
    div
      = f.label :vat_regime, "Régime TVA *", class: "block text-sm font-medium text-gray-700"
      = f.select :vat_regime, LegalEntity::VAT_REGIME_LABELS.map { |value, label| [label, value] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
    div
      = f.label :vat_number, "Numéro de TVA", class: "block text-sm font-medium text-gray-700"
      = f.text_field :vat_number, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
  label.flex.items-center.gap-2.text-sm.text-gray-700
    = f.check_box :active, class: "rounded border-gray-300"
    |  Active
  .flex.items-center.gap-3
    = f.submit "Enregistrer", class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-4 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90"
    = link_to "Annuler", finance_legal_entities_path, class: "text-sm text-gray-500 hover:text-gray-700"
