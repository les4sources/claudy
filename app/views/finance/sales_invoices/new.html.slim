/ Enregistrer une facture de vente (epic #240, phase 6). Claudy n'ÉMET pas la
  facture — elle sort d'OkiOki : on en garde ici la trace.
- content_for :page_header do
  = render "layouts/components/page_header", title: "Enregistrer une facture de vente"

.max-w-2xl
  - if @already_invoiced
    .mb-6.rounded-xl.border.border-amber-200.p-4 class="bg-amber-50/60"
      p.text-sm.text-amber-900
        strong Déjà facturé.
        = " Cette réservation est rattachée à la facture #{@already_invoiced.sales_invoice.number}."
      p.mt-2.text-xs
        = link_to "Voir la facture", finance_sales_invoice_path(@already_invoiced.sales_invoice), class: "text-blue-600 hover:text-blue-800"

  .mb-6.rounded-xl.border.border-stone-200.bg-white.p-4
    p class="text-[0.65rem] font-semibold uppercase tracking-wide text-stone-400" Ce qu'on facture
    p.mt-1.text-sm.font-medium.text-stone-800 = @source.try(:decorate)&.try(:display_name).presence || "#{@source.class.name} ##{@source.id}"
    - if @source.try(:arrival_date) && @source.try(:departure_date)
      p.text-xs.text-stone-500 = "#{l(@source.arrival_date, format: :long)} → #{l(@source.departure_date, format: :long)}"

  = form_with model: @invoice, url: finance_sales_invoices_path(kind: params[:kind], source_id: @source.id), method: :post, class: "space-y-4" do |f|
    .rounded-xl.border.border-stone-200.bg-white.p-4.space-y-4
      = f.select :legal_entity_id, options_from_collection_for_select(@entities, :id, :name, @invoice.legal_entity_id), {}, { class: "block w-full rounded-lg border-stone-200 text-sm" }
      = f.text_field :number, label: "Numéro OkiOki", placeholder: "2026-001", class: "block w-full rounded-lg border-stone-200 text-sm"
      = f.date_field :issued_on, label: "Date d'émission", class: "block w-full rounded-lg border-stone-200 text-sm"
      / Le montant est PRÉ-REMPLI depuis ce qu'on facture, et reste modifiable :
        c'est OkiOki qui fait foi, pas le devis reconstruit de Claudy.
      = f.text_field :total, label: "Montant TTC (€)", value: number_with_precision(@invoice.total_cents.to_f / 100, precision: 2, separator: ","), class: "block w-full rounded-lg border-stone-200 text-sm"
      = f.file_field :document, label: "PDF de la facture", accept: "application/pdf", class: "block w-full text-sm"
      = f.text_area :notes, label: "Notes (facultatif)", rows: 2, class: "block w-full rounded-lg border-stone-200 text-sm"

    .flex.items-center.gap-3
      = f.submit "Enregistrer la facture", class: "inline-flex items-center rounded-lg bg-4s-main px-4 py-2 text-sm font-medium text-white hover:bg-teal-700 cursor-pointer"
      = link_to "Annuler", invoicing_path, class: "text-sm text-stone-500 hover:text-stone-700"
