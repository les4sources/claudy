- content_for :page_header do
  = render "layouts/components/page_header", title: (@invoice.credit_note? ? "Modifier la note de crédit" : "Modifier la facture")

= render "finance/purchase_invoices/form", invoice: @invoice, third_parties: @third_parties,
         entities: @entities, teams: @teams, general_accounts: @general_accounts, creditable_invoices: @creditable_invoices,
         url: finance_purchase_invoice_path(@invoice), method: :patch, submit_label: "Enregistrer"
