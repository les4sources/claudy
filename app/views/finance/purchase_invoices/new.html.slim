- content_for :page_header do
  = render "layouts/components/page_header", title: (@invoice.credit_note? ? "Nouvelle note de crédit fournisseur" : "Nouvelle facture d'achat")

- if @mail_attachment
  - courriel = @mail_attachment.mail_message
  .mb-4.rounded-lg.border.border-blue-200.bg-blue-50.px-4.py-3.text-sm.text-blue-900
    | Pré-remplie depuis le mail de
    strong= " #{courriel.sender_label} "
    | (#{l(courriel.received_at, format: :short)}), pièce
    strong= " #{@mail_attachment.filename}"
    | . Relis chaque champ : c'est une proposition, pas une vérification.
    = link_to " Revoir le mail", finance_mail_message_path(courriel, inbox_filters), class: "underline"

- if @deadline
  .mb-4.rounded-lg.border.border-blue-200.bg-blue-50.px-4.py-3.text-sm.text-blue-900
    | Cette facture sera liée à l'échéance
    strong= " #{@deadline.display_title} "
    | (#{@deadline.legal_entity.name}) : elle la soldera quand elle sera payée.

= render "finance/purchase_invoices/form", invoice: @invoice, third_parties: @third_parties,
         entities: @entities, teams: @teams, general_accounts: @general_accounts, creditable_invoices: @creditable_invoices,
         url: finance_purchase_invoices_path(compliance_deadline_id: @deadline&.id, mail_attachment_id: @mail_attachment&.id,
                                           from_inbox: (1 if from_inbox?), inbox_status: inbox_filters[:status], inbox_q: inbox_filters[:q]), method: :post, submit_label: "Enregistrer",
         supplier_draft: @mail_attachment&.supplier_draft
