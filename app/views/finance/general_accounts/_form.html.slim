= form_with model: [:finance, account], class: "space-y-4" do |f|
  = render "finance/shared/form_errors", record: account
  .grid.gap-4(class="md:grid-cols-2")
    div
      = f.label :code, "Code *", class: "block text-sm font-medium text-gray-700"
      = f.text_field :code, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
    div
      = f.label :name, "Libellé *", class: "block text-sm font-medium text-gray-700"
      = f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
    div
      = f.label :klass, "Classe *", class: "block text-sm font-medium text-gray-700"
      = f.select :klass, (1..7).to_a, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
    div
      = f.label :nature, "Nature *", class: "block text-sm font-medium text-gray-700"
      = f.select :nature, GeneralAccount::NATURE_LABELS.map { |value, label| [label, value] }, {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500"
  .flex.items-center.gap-6
    label.flex.items-center.gap-2.text-sm.text-gray-700
      = f.check_box :reconcilable, class: "rounded border-gray-300"
      |  Lettrable (suivi ligne à ligne)
    label.flex.items-center.gap-2.text-sm.text-gray-700
      = f.check_box :active, class: "rounded border-gray-300"
      |  Actif
  .flex.items-center.gap-3
    = f.submit "Enregistrer", class: "inline-flex items-center rounded-md border border-transparent bg-4s-main px-4 py-2 text-sm font-medium text-white shadow-sm hover:opacity-90"
    = link_to "Annuler", finance_general_accounts_path, class: "text-sm text-gray-500 hover:text-gray-700"
