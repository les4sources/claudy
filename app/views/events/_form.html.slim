.border-l-8.border-indigo-700.-ml-4.pl-4.md:p-0.md:m-0.md:border-0.grid.grid-cols-1.md:grid-cols-3.md:gap-4
  .md:border-r-8.md:border-indigo-700.md:pr-4.md:text-right
    = section_heading_tw heading: "Informations"

  .col-span-2.mb-4.space-y-6.sm:space-y-5
    = f.text_field :name,
                   label: "Nom de l'événement *",
                   required: true,
                   class: "md:w-1/2 lg:w-2/3"

    = f.label :event_category_id, "Type d'événement *"
    = f.collection_radio_buttons :event_category_id, EventCategory.all.order(:name), :id, :name, required: true do |radio_button|
      .flex.items-center
        = radio_button.radio_button
        = radio_button.label(class: "ml-3 block text-sm font-medium text-gray-700")

    = f.text_field :url,
                   label: "Adresse internet pour l'inscription *",
                   class: "md:w-1/2 lg:w-2/3",
                   hint: "Page publique sur Punchpass"

    p.text-sm
      | Toute la journée? Ne spécifie que la date et ne précise aucune heure.

    .space-y-6.md:space-y-0.md:flex.md:space-x-6
      = f.date_field :starts_at_date,
                     html5: true,
                     label: "Du *",
                     required: true,
                     error: "Veuillez renseigner une date"

      = f.time_field :starts_at_time,
                     html5: true,
                     label: "À quelle heure?",
                     required: false,
                     include_seconds: false

      = f.date_field :ends_at_date,
                     html5: true,
                     label: "Au *",
                     required: true,
                     error: "Veuillez renseigner une date"

      = f.time_field :ends_at_time,
                     html5: true,
                     label: "À quelle heure?",
                     required: false,
                     include_seconds: false

    = f.number_field :attendees,
                     label: "Nombre de participants",
                     min: 0,
                     remove_default_class: "sm:text-sm",
                     class: "w-24 text-lg"

    = f.number_field :sales_amount,
                     label: "Montant des ventes",
                     value: ((f.object.sales_amount / 100.0) rescue nil),
                     hint: "Total des ventes pour l'événement",
                     class: "w-1/2 md:w-1/2 lg:w-1/4",
                     step: "0.01"

    = f.label :notes,
              "Notes"
    = f.rich_text_area :notes

hr

.border-l-8.border-indigo-700.-ml-4.pl-4.md:p-0.md:m-0.md:border-0.grid.grid-cols-1.md:grid-cols-3.md:gap-4.mt-8
  .md:border-r-8.md:border-indigo-700.md:pr-4.md:text-right
    = section_heading_tw heading: "Partage"

  .col-span-2.mb-4.space-y-6.sm:space-y-5
    = f.collection_select_field :team_id, Team.ordered, :id, :name, { include_blank: "Aucun pôle" }, class: "md:w-1/2 lg:w-2/3"
    p.mt-1.text-xs.text-gray-500
      | Le pôle qui porte l'événement.

    - taux_general = Pricing::Catalog.event_organizer_share_percent
    = f.number_field :organizer_share_percent,
                     label: "Part des organisateurs (%)",
                     hint: "Laisser vide pour appliquer le taux général de #{taux_general} %, modifiable dans Paramètres > Tarifs. Ce taux s'applique APRÈS déduction des frais fixes.",
                     min: "0",
                     max: "100",
                     step: "1",
                     class: "w-24"

    / Organisateurs (epic #245, décision 1). Cocher qui organise ; le poids ne
      sert qu'à répartir autrement qu'à parts égales.
    = f.label :organizers, "Organisateurs"
    p.mt-1.mb-2.text-xs.text-gray-500
      | La part se répartit au prorata des poids. Laisser tous les poids à 1 donne des parts égales.
    - poids_par_humain = f.object.event_organizers.index_by(&:human_id)
    .space-y-2
      - Human.all.each do |human|
        - organizer = poids_par_humain[human.id]
        .flex.items-center.gap-3
          = check_box_tag "event[organizers][#{human.id}][selected]", "1", organizer.present?,
                          id: "event_organizers_#{human.id}_selected",
                          class: "h-4 w-4 rounded border-gray-300"
          = label_tag "event_organizers_#{human.id}_selected", human.name, class: "flex-1 text-sm text-gray-700"
          = number_field_tag "event[organizers][#{human.id}][weight]", organizer&.weight || 1,
                             min: 1, step: 1,
                             "aria-label" => "Poids de #{human.name}",
                             class: "w-20 rounded-md border-gray-300 text-sm"

hr
