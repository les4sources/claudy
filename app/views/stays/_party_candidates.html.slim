/ Les candidates au rattachement (issue #339) : les parties privées PAYÉES de
  Tranches de Vie autour des dates du séjour. locals: stay, candidates, error
= turbo_frame_tag "stay_#{stay.id}_party_candidates", class: "block"
  .mt-2.rounded-md.border.border-gray-200.bg-gray-50.p-3
    .flex.items-baseline.justify-between.gap-2
      .text-xs.font-semibold.uppercase.tracking-wide.text-gray-500 Parties payées autour du séjour
      = link_to "Fermer", stay_path(stay), data: { turbo_frame: "_top" }, class: "text-xs text-gray-500 hover:text-gray-800"

    - if error.present?
      p.mt-2.text-sm.text-red-700 = error
    - elsif candidates.empty?
      p.mt-2.text-sm.text-gray-500 Aucune Pizza Party payée sur cette période.
    - else
      ul.mt-2.space-y-2
        - candidates.each do |candidate|
          - attrs = candidate.attributes
          - deja = PartyReservation.find_by(source: "tranchesdevie", external_id: candidate.external_id)
          li.rounded-md.border.border-gray-200.bg-white.p-2
            .flex.items-start.justify-between.gap-2
              .min-w-0
                .flex.flex-wrap.items-center.gap-2
                  span.text-sm.font-medium.text-gray-900
                    - if attrs[:held_on].present?
                      = l(attrs[:held_on].to_date, format: :short)
                    - if attrs[:slot].present?
                      = " · #{attrs[:slot]}"
                  - if attrs[:group_name].present?
                    span.text-sm.text-gray-700 = attrs[:group_name]
                  - if attrs[:persons].to_i.positive?
                    span.text-xs.text-gray-500 = "#{attrs[:persons]} pers."
                - if candidate.customer_name.present? || candidate.customer_email.present?
                  div class="mt-0.5 text-xs text-gray-500"
                    = [candidate.customer_name, candidate.customer_email].compact_blank.join(" · ")
              .shrink-0.text-right
                .text-sm.font-semibold.text-gray-900 = humanized_money_with_symbol(candidate.total_euros)
            .mt-1.flex.flex-wrap.items-center.gap-2
              - if deja
                span.rounded.bg-gray-100.px-2.py-0.5.text-xs.text-gray-600
                  = deja.stay_id == stay.id ? "Déjà rattachée à ce séjour" : "Déjà rattachée au séjour ##{deja.stay_id}"
                button.cursor-not-allowed.rounded.bg-gray-200.px-2.py-0.5.text-xs.text-gray-500 disabled="disabled"
                  | Rattacher
              - else
                = button_to "Rattacher", stay_party_reservations_path(stay), method: :post, params: { external_id: candidate.external_id }, class: "rounded bg-indigo-600 px-2 py-0.5 text-xs font-medium text-white hover:bg-indigo-700"
